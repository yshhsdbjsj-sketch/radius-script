-- toolstab.lua
-- loadstring(game:HttpGet(TOOLS_TAB_URL))()(lib)
-- Returns: builder(opts) → nil
--
-- Tools page:
--   left   grid of every tool you own (backpack + equipped) with icons
--   right  3D preview of the selected tool + Equip / Unequip button
--   side   "Gun mods" panel when the selected tool is one of the supported guns


		panelGun.Font = Enum.Font.GothamMedium
		panelGun.Text = ""
		panelGun.TextColor3 = TEXT_SOFT
		panelGun.TextSize = 12
		panelGun.TextXAlignment = Enum.TextXAlignment.Right
		panelGun.TextTruncate = Enum.TextTruncate.AtEnd

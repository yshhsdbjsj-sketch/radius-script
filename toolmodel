		local conns = {}

		-- ============================================================
		-- mouse position in AbsolutePosition space (self-corrects a top-bar offset)
		-- ============================================================
		local GuiService  = game:GetService("GuiService")
		local mouseOffset = Vector2.zero

		local function mousePos()
			return UserInputService:GetMouseLocation() + mouseOffset
		end

		local function inside(pos, obj)
			local p, sz = obj.AbsolutePosition, obj.AbsoluteSize
			return pos.X >= p.X and pos.X <= p.X + sz.X and pos.Y >= p.Y and pos.Y <= p.Y + sz.Y
		end

		local function calibrate(obj)
			if inside(mousePos(), obj) then
				return
			end
			local raw = UserInputService:GetMouseLocation()
			local inset = GuiService:GetGuiInset().Y
			for _, dy in ipairs({inset, -inset, 36, -36, 58, -58}) do
				if dy ~= 0 and inside(raw + Vector2.new(0, dy), obj) then
					mouseOffset = Vector2.new(0, dy)
					return
				end
			end
		end

		-- ============================================================
		-- tool model helpers (used by the big preview and the tile icons)
		-- ============================================================
		-- bounding box of the *visible* parts only (ignores invisible hitboxes
		-- and giant effect parts that would stretch the box and push the camera away)
		local function getBounds(model)
			local function scan(onlyVisible)
				local minP = Vector3.new(math.huge, math.huge, math.huge)
				local maxP = Vector3.new(-math.huge, -math.huge, -math.huge)
				local found = false
				for _, part in ipairs(model:GetDescendants()) do
					if part:IsA("BasePart") then
						local big = math.max(part.Size.X, part.Size.Y, part.Size.Z)
						if not onlyVisible or (part.Transparency < 0.95 and big < 30) then
							local s = part.Size / 2
							for _, sx in ipairs({-1, 1}) do
								for _, sy in ipairs({-1, 1}) do
									for _, sz in ipairs({-1, 1}) do
										local w = part.CFrame:PointToWorldSpace(Vector3.new(s.X * sx, s.Y * sy, s.Z * sz))
										minP = Vector3.new(math.min(minP.X, w.X), math.min(minP.Y, w.Y), math.min(minP.Z, w.Z))
										maxP = Vector3.new(math.max(maxP.X, w.X), math.max(maxP.Y, w.Y), math.max(maxP.Z, w.Z))
									end
								end
							end
							found = true
						end
					end
				end
				return found, minP, maxP
			end

			local found, minP, maxP = scan(true)
			if not found then
				found, minP, maxP = scan(false) -- nothing visible, fall back to every part
			end
			if not found then
				return Vector3.new(-1, -1, -1), Vector3.new(1, 1, 1)
			end
			return minP, maxP
		end

		-- copy of a tool (no scripts), anchored and centred on its visible parts.
		-- returns the model and the size of its bounds, or nil if there's nothing to show
		local function cloneToolModel(tool)
			local clone = Instance.new("Model")
			for _, child in ipairs(tool:GetChildren()) do
				if not child:IsA("Script") and not child:IsA("LocalScript") and not child:IsA("ModuleScript") then
					child:Clone().Parent = clone
				end
			end
			if not next(clone:GetChildren()) then
				clone:Destroy()
				return nil
			end

			for _, part in ipairs(clone:GetDescendants()) do
				if part:IsA("BasePart") then
					part.Anchored    = true
					part.CastShadow  = false
					part.Velocity    = Vector3.zero
					part.RotVelocity = Vector3.zero
				end
			end

			local minP, maxP = getBounds(clone)
			local offset = CFrame.new(-((minP + maxP) / 2))
			for _, part in ipairs(clone:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CFrame = offset * part.CFrame
				end
			end
			return clone, math.clamp((maxP - minP).Magnitude, 0.5, 20)
		end


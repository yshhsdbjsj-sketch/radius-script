		local panelDivider = Instance.new("Frame")
		panelDivider.BackgroundColor3 = Color3.fromRGB(38, 38, 42)
		panelDivider.BorderSizePixel = 0
		panelDivider.Position = UDim2.fromOffset(12, 40)
		panelDivider.Size = UDim2.new(1, -24, 0, 1)
		panelDivider.Parent = panel

		-- ---------- vertical fire-rate slider (left column) ----------
		local sliderArea = Instance.new("Frame")
		sliderArea.BackgroundTransparency = 1
		sliderArea.Position = UDim2.fromOffset(14, 52)
		sliderArea.Size = UDim2.new(0, 96, 1, -66)
		sliderArea.Parent = panel

		local rateValue = Instance.new("TextLabel")
		rateValue.BackgroundTransparency = 1
		rateValue.Size = UDim2.new(1, 0, 0, 20)
		rateValue.Font = Enum.Font.GothamBold
		rateValue.TextColor3 = TEXT_MAIN
		rateValue.TextSize = 15
		rateValue.Parent = sliderArea

		local track = Instance.new("Frame")
		track.AnchorPoint = Vector2.new(0.5, 0)
		track.Position = UDim2.new(0.5, 0, 0, 30)
		track.Size = UDim2.new(0, 6, 1, -(30 + 26))
		track.BackgroundColor3 = TRACK
		track.BorderSizePixel = 0
		track.Parent = sliderArea
		addCorner(track, 3)

		local fill = Instance.new("Frame")
		fill.AnchorPoint = Vector2.new(0, 1)
		fill.Position = UDim2.fromScale(0, 1)
		fill.Size = UDim2.fromScale(1, 0)
		fill.BackgroundColor3 = WHITE
		fill.BorderSizePixel = 0
		fill.Parent = track
		addCorner(fill, 3)

		local knob = Instance.new("Frame")
		knob.AnchorPoint = Vector2.new(0.5, 0.5)
		knob.Size = UDim2.fromOffset(16, 16)
		knob.BackgroundColor3 = Color3.fromRGB(245, 245, 248)
		knob.BorderSizePixel = 0
		knob.ZIndex = 2
		knob.Parent = track
		addCorner(knob, 8)

		local rateCaption = Instance.new("TextLabel")
		rateCaption.BackgroundTransparency = 1
		rateCaption.AnchorPoint = Vector2.new(0, 1)
		rateCaption.Position = UDim2.fromScale(0, 1)
		rateCaption.Size = UDim2.new(1, 0, 0, 18)
		rateCaption.Font = Enum.Font.GothamMedium
		rateCaption.Text = "Fire rate"
		rateCaption.TextColor3 = TEXT_DIM
		rateCaption.TextSize = 12
		rateCaption.Parent = sliderArea

		local function setRate(v)
			rate = math.clamp(math.floor(v + 0.5), RATE_MIN, RATE_MAX)
			local a = (rate - RATE_MIN) / (RATE_MAX - RATE_MIN)
			fill.Size = UDim2.fromScale(1, a)
			knob.Position = UDim2.fromScale(0.5, 1 - a)
			rateValue.Text = rate .. "/s"
		end
		setRate(rate)

		local sliderHit = Instance.new("TextButton")
		sliderHit.BackgroundTransparency = 1
		sliderHit.Text = ""
		sliderHit.AutoButtonColor = false
		sliderHit.AnchorPoint = Vector2.new(0.5, 0)
		sliderHit.Position = UDim2.new(0.5, 0, 0, 24)
		sliderHit.Size = UDim2.new(0, 44, 1, -(24 + 20))
		sliderHit.ZIndex = 3
		sliderHit.Parent = sliderArea

		local draggingRate = false
		local function rateFromMouse()
			local h = track.AbsoluteSize.Y
			if h <= 0 then
				return
			end
			local fromTop = math.clamp((mousePos().Y - track.AbsolutePosition.Y) / h, 0, 1)
			setRate(RATE_MIN + (1 - fromTop) * (RATE_MAX - RATE_MIN))
		end

		sliderHit.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				draggingRate = true
				rateFromMouse()
			end
		end)
		table.insert(conns, UserInputService.InputChanged:Connect(function(input)
			if draggingRate and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				rateFromMouse()
			end
		end))
		table.insert(conns, UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				draggingRate = false
			end
		end))

		-- ---------- toggles (right column) ----------
		local function makeToggle(labelText, y, onChange)
			local row = Instance.new("Frame")
			row.Position = UDim2.fromOffset(122, y)
			row.Size = UDim2.new(1, -136, 0, 58)
			row.BackgroundColor3 = TILE_BG
			row.BorderSizePixel = 0
			row.Parent = panel
			addCorner(row)
			addStroke(row, STROKE)

			local label = Instance.new("TextLabel")
			label.BackgroundTransparency = 1
			label.Position = UDim2.fromOffset(10, 6)
			label.Size = UDim2.new(1, -20, 0, 16)
			label.Font = Enum.Font.GothamMedium
			label.Text = labelText
			label.TextColor3 = TEXT_SOFT
			label.TextSize = 12
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.Parent = row

			local switch = Instance.new("TextButton")
			switch.Position = UDim2.fromOffset(10, 28)
			switch.Size = UDim2.fromOffset(46, 24)
			switch.AutoButtonColor = false
			switch.Text = ""
			switch.BorderSizePixel = 0
			switch.Parent = row
			addCorner(switch, 7)
			local stroke = addStroke(switch, Color3.fromRGB(60, 60, 66))

			local knobS = Instance.new("Frame")
			knobS.AnchorPoint = Vector2.new(0, 0.5)
			knobS.Size = UDim2.fromOffset(18, 18)
			knobS.BorderSizePixel = 0
			knobS.Parent = switch
			addCorner(knobS, 5)

			local isOn = false
			local function apply(animate)
				local info = animate and fadeInfo or TweenInfo.new(0)
				TweenService:Create(switch, info, {BackgroundColor3 = isOn and WHITE or TRACK}):Play()
				TweenService:Create(knobS, info, {
					BackgroundColor3 = isOn and Color3.fromRGB(22, 22, 25) or Color3.fromRGB(140, 140, 146),
					Position = UDim2.new(0, isOn and 25 or 3, 0.5, 0),
				}):Play()
			end
			apply(false)

			switch.MouseEnter:Connect(function()
				TweenService:Create(stroke, fadeInfo, {Color = Color3.fromRGB(110, 110, 120)}):Play()
			end)
			switch.MouseLeave:Connect(function()
				TweenService:Create(stroke, fadeInfo, {Color = Color3.fromRGB(60, 60, 66)}):Play()
			end)
			switch.MouseButton1Click:Connect(function()
				calibrate(switch)
				isOn = not isOn
				apply(true)
				onChange(isOn)
			end)
		end

		makeToggle("Rapid fire", 52, function(on)
			rapidOn = on
			if not on then
				firing = false
			end
		end)
		makeToggle("No slowdown", 120, function(on)
			noSlowOn = on
			baseSpeed = nil
		end)

		local hint = Instance.new("TextLabel")
		hint.BackgroundTransparency = 1
		hint.Position = UDim2.fromOffset(122, 190)
		hint.Size = UDim2.new(1, -136, 0, 48)
		hint.Font = Enum.Font.Gotham
		hint.Text = ""
		hint.TextColor3 = Color3.fromRGB(90, 90, 96)
		hint.TextSize = 11
		hint.TextWrapped = true
		hint.TextXAlignment = Enum.TextXAlignment.Left
		hint.TextYAlignment = Enum.TextYAlignment.Top
		hint.Parent = panel

		local statusLabel = Instance.new("TextLabel")
		statusLabel.BackgroundTransparency = 1
		statusLabel.AnchorPoint = Vector2.new(0, 1)
		statusLabel.Position = UDim2.new(0, 122, 1, -14)
		statusLabel.Size = UDim2.new(1, -136, 0, 16)
		statusLabel.Font = Enum.Font.Gotham
		statusLabel.Text = ""
		statusLabel.TextColor3 = Color3.fromRGB(235, 90, 90)
		statusLabel.TextSize = 11
		statusLabel.TextXAlignment = Enum.TextXAlignment.Left
		statusLabel.Parent = panel

		-- the game's own gun module (used for the rapid-fire shots)
		local gunHandler
		task.spawn(function()
			local ok, result = pcall(function()
				local rs = game:GetService("ReplicatedStorage")
				return require(rs.Modules.GunHandler)
			end)
			if ok and result then
				gunHandler = result
			else
				statusLabel.Text = "GunHandler not found"
			end
		end)

		-- ---------- show / hide the panel ----------
		local panelShown = false
		local function updatePanel()
			local isGun = selectedTool ~= nil and GUNS[selectedTool.Name] == true
			local want = isGun and page.Visible
			if isGun then
				panelGun.Text = selectedTool.Name
				local equipped = selectedTool.Parent == lp.Character
				hint.Text = equipped and "Hold left mouse to fire at the set rate." or "Equip this tool to use these mods."
			end
			if want == panelShown then
				return
			end
			panelShown = want
			if want then
				panel.Visible = true
				TweenService:Create(panelScale, slideInfo, {Scale = 1}):Play()
			else
				local out = TweenService:Create(panelScale, fadeInfo, {Scale = 0.92})
				out.Completed:Connect(function()
					if not panelShown then
						panel.Visible = false
					end
				end)
				out:Play()
			end
		end

		page:GetPropertyChangedSignal("Visible"):Connect(updatePanel)

		-- sit on the right of the window, flip left if there's no room
		table.insert(conns, RunService.RenderStepped:Connect(function()
			if not panel.Visible then
				return
			end
			local p, sz = win.frame.AbsolutePosition, win.frame.AbsoluteSize
			local roomRight = p.X + sz.X + SIDE_GAP + SIDE_W <= win.gui.AbsoluteSize.X
			panel.Position = roomRight
				and UDim2.new(1, SIDE_GAP + SIDE_W / 2, 0.5, 0)
				or UDim2.new(0, -(SIDE_GAP + SIDE_W / 2), 0.5, 0)
		end))

		-- ---------- the equipped gun (this is the one that fires) ----------
		local function clearGunConns()
			for _, c in ipairs(gunConns) do
				c:Disconnect()
			end
			table.clear(gunConns)
		end

		local function setEquippedGun(tool)
			if tool == equippedGun then
				return
			end
			clearGunConns()
			equippedGun = tool
			baseSpeed = nil
			if tool then
				table.insert(gunConns, tool.Activated:Connect(function()
					lastAction = os.clock()
				end))
				local ammo = tool:FindFirstChild("Ammo")
				if ammo and ammo:IsA("ValueBase") then
					table.insert(gunConns, ammo.Changed:Connect(function()
						lastAction = os.clock() -- ammo changing = shooting or reloading
					end))
				end
			else
				firing = false
				mouseHeld = false
			end
		end

		-- ---------- rapid fire + no slowdown ----------
		table.insert(conns, UserInputService.InputBegan:Connect(function(input, gp)
			if gp or not equippedGun then
				return
			end
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				mouseHeld = true
				if rapidOn then
					firing = true
					fireAcc = 0
				end
			elseif input.KeyCode == Enum.KeyCode.R then
				lastAction = os.clock() -- reload
			end
		end))
		table.insert(conns, UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				mouseHeld = false
				firing = false
			end
		end))

		local function shoot()
			if gunHandler then
				pcall(gunHandler.Shoot, gunHandler)
			end
			pcall(function()
				equippedGun:Activate()
			end)
		end

		table.insert(conns, RunService.Heartbeat:Connect(function(dt)
			local gun = equippedGun
			if not gun or gun.Parent ~= lp.Character then
				return
			end
			local now = os.clock()
			if mouseHeld then
				lastAction = now
			end

			-- no slowdown: while shooting/reloading, keep the speed you had before
			if noSlowOn then
				local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
				if hum then
					if now - lastAction > 3 then
						baseSpeed = hum.WalkSpeed
					elseif baseSpeed and hum.WalkSpeed < baseSpeed then
						hum.WalkSpeed = baseSpeed
					end
				end
			end

			-- rapid fire: `rate` shots per second while the mouse is held
			if firing and rapidOn then
				local interval = 1 / rate
				fireAcc += dt
				local n = 0
				while fireAcc >= interval and n < 10 do
					shoot()
					fireAcc -= interval
					n += 1
				end
				if n == 10 then
					fireAcc = 0
				end
			end
		end))

		-- ============================================================
		-- big 3D preview of the selected tool
		-- ============================================================
		local angle   = 0
		local ORBIT_R = 4
		local ORBIT_Y = 1.2
		local toolClone
		local orbitConn
		local previewToken = 0 -- bumped on every load/clear so stale loads cancel themselves

		local function removeClone()
			if orbitConn then orbitConn:Disconnect(); orbitConn = nil end
			if toolClone then toolClone:Destroy(); toolClone = nil end
		end

		local function clearPreview()
			previewToken += 1
			removeClone()
			vp.Visible = false
			grad.Visible = false
			emptyLabel.Visible = true
			nameLabel.Text = ""
			subLabel.Text = ""
		end

		local function loadPreview(tool)
			previewToken += 1
			local token = previewToken

			-- parts can still be mid-weld right after equipping
			task.wait(0.1)
			local bp = lp:FindFirstChild("Backpack")
			if token ~= previewToken or (tool.Parent ~= lp.Character and tool.Parent ~= bp) then
				return
			end

			removeClone()
			local clone, size = cloneToolModel(tool)
			if not clone then
				clearPreview()
				return
			end
			clone.Parent = worldModel
			toolClone = clone

			ORBIT_R = math.max(2.5, size * 1.4)
			ORBIT_Y = size * 0.12

			vp.Visible = true
			grad.Visible = true
			emptyLabel.Visible = false
			nameLabel.Text = tool.Name
			subLabel.Text = tool.ToolTip ~= "" and tool.ToolTip or "Tool"

			angle = 0
			orbitConn = RunService.RenderStepped:Connect(function(dt)
				angle += dt * 0.6
				local eye    = Vector3.new(math.cos(angle) * ORBIT_R, ORBIT_Y, math.sin(angle) * ORBIT_R)
				local target = Vector3.new(0, ORBIT_Y * 0.5, 0)
				vpCam.CFrame = CFrame.lookAt(eye, target)
			end)
		end

		-- ============================================================
		-- tool grid (tiles)
		-- ============================================================
		local tiles = {} -- [tool] = {frame, stroke, dot}
		local selectTool, toggleEquip, refreshTiles

		local function makeIcon(tool, parent)
			if tool.TextureId ~= "" then
				local img = Instance.new("ImageLabel")
				img.BackgroundTransparency = 1
				img.Position = UDim2.fromOffset(6, 5)
				img.Size = UDim2.new(1, -12, 0, 48)
				img.Image = tool.TextureId
				img.ScaleType = Enum.ScaleType.Fit
				img.Parent = parent
				return
			end

			-- no icon: render the tool itself, small and still
			local iconVp = Instance.new("ViewportFrame")
			iconVp.BackgroundTransparency = 1
			iconVp.Position = UDim2.fromOffset(4, 3)
			iconVp.Size = UDim2.new(1, -8, 0, 52)
			iconVp.LightColor = Color3.fromRGB(220, 220, 228)
			iconVp.LightDirection = Vector3.new(-1, -2, -1)
			iconVp.Ambient = Color3.fromRGB(90, 90, 98)
			iconVp.Parent = parent

			local ok = pcall(function()
				local clone, size = cloneToolModel(tool)
				if not clone then
					return
				end
				clone.Parent = iconVp
				local cam = Instance.new("Camera")
				cam.FieldOfView = 40
				local dist = math.max(2, size * 1.5)
				cam.CFrame = CFrame.lookAt(Vector3.new(dist * 0.7, dist * 0.45, dist * 0.7), Vector3.zero)
				cam.Parent = iconVp
				iconVp.CurrentCamera = cam
			end)
			if not ok then
				iconVp:Destroy()
			end
		end

		local function addTile(tool)
			local frame = Instance.new("Frame")
			frame.Name = tool.Name
			frame.BackgroundColor3 = TILE_BG
			frame.BorderSizePixel = 0
			frame.Parent = listScroll
			addCorner(frame)
			local stroke = addStroke(frame, STROKE)

			makeIcon(tool, frame)

			local label = Instance.new("TextLabel")
			label.BackgroundTransparency = 1
			label.Position = UDim2.fromOffset(3, 58)
			label.Size = UDim2.new(1, -6, 0, 14)
			label.Font = Enum.Font.GothamMedium
			label.Text = tool.Name
			label.TextColor3 = TEXT_SOFT
			label.TextSize = 10
			label.TextTruncate = Enum.TextTruncate.AtEnd
			label.Parent = frame

			-- small dot = currently equipped
			local dot = Instance.new("Frame")
			dot.AnchorPoint = Vector2.new(1, 0)
			dot.Position = UDim2.new(1, -5, 0, 5)
			dot.Size = UDim2.fromOffset(7, 7)
			dot.BackgroundColor3 = Color3.fromRGB(90, 200, 120)
			dot.BorderSizePixel = 0
			dot.Visible = false
			dot.ZIndex = 3
			dot.Parent = frame
			addCorner(dot, 4)

			local hit = Instance.new("TextButton")
			hit.BackgroundTransparency = 1
			hit.AutoButtonColor = false
			hit.Text = ""
			hit.Size = UDim2.fromScale(1, 1)
			hit.ZIndex = 4
			hit.Parent = frame

			hit.MouseEnter:Connect(function()
				if selectedTool ~= tool then
					TweenService:Create(stroke, fadeInfo, {Color = STROKE_HOVER}):Play()
				end
			end)
			hit.MouseLeave:Connect(function()
				TweenService:Create(stroke, fadeInfo, {Color = selectedTool == tool and STROKE_SEL or STROKE}):Play()
			end)

			-- click = select, double click = equip / unequip
			local lastClick = 0
			hit.MouseButton1Click:Connect(function()
				local now = os.clock()
				if selectedTool == tool and now - lastClick < 0.4 then
					toggleEquip(tool)
				else
					selectTool(tool)
				end
				lastClick = now
			end)

			tiles[tool] = {frame = frame, stroke = stroke, dot = dot}
		end

		local function removeTile(tool)
			local t = tiles[tool]
			if t then
				t.frame:Destroy()
				tiles[tool] = nil
			end
		end

		function refreshTiles()
			local char = lp.Character
			for tool, t in pairs(tiles) do
				local selected = tool == selectedTool
				TweenService:Create(t.frame, fadeInfo, {BackgroundColor3 = selected and TILE_BG_SEL or TILE_BG}):Play()
				TweenService:Create(t.stroke, fadeInfo, {Color = selected and STROKE_SEL or STROKE}):Play()
				t.dot.Visible = tool.Parent == char
			end
			if selectedTool then
				equipBtn.Visible = true
				equipBtn.Text = selectedTool.Parent == char and "Unequip" or "Equip"
			else
				equipBtn.Visible = false
			end
			listEmpty.Visible = next(tiles) == nil
			updatePanel()
		end

		function selectTool(tool)
			selectedTool = tool
			refreshTiles()
			if tool then
				task.spawn(loadPreview, tool)
			else
				clearPreview()
			end
		end

		function toggleEquip(tool)
			local char = lp.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not hum then
				return
			end
			if tool.Parent == char then
				hum:UnequipTools()
			elseif tool.Parent == lp:FindFirstChild("Backpack") then
				hum:EquipTool(tool)
			end
		end

		equipBtn.MouseButton1Click:Connect(function()
			if selectedTool then
				toggleEquip(selectedTool)
			end
		end)

		-- ============================================================
		-- keep the grid in sync with backpack + character
		-- ============================================================
		local function getEquipped(char)
			return char and char:FindFirstChildOfClass("Tool")
		end

		local lastEquipped
		local rebuildQueued = false

		local function rebuild()
			local seen = {}
			local function consider(container)
				if container then
					for _, child in ipairs(container:GetChildren()) do
						if child:IsA("Tool") then
							seen[child] = true
							if not tiles[child] then
								addTile(child)
							end
						end
					end
				end
			end
			consider(lp:FindFirstChild("Backpack"))
			consider(lp.Character)
			for tool in pairs(tiles) do
				if not seen[tool] then
					removeTile(tool)
				end
			end

			-- the selected tool disappeared (dropped, died, ...)
			if selectedTool and not seen[selectedTool] then
				selectTool(nil)
			end

			-- equipping something selects it, and updates which gun fires
			local equipped = getEquipped(lp.Character)
			setEquippedGun(equipped and GUNS[equipped.Name] and equipped or nil)
			if equipped ~= lastEquipped then
				lastEquipped = equipped
				if equipped and selectedTool ~= equipped then
					selectTool(equipped)
				end
			end

			refreshTiles()
		end

		-- several events fire for one equip (backpack removal + character add), so batch them
		local function queueRebuild()
			if rebuildQueued then
				return
			end
			rebuildQueued = true
			task.delay(0.05, function()
				rebuildQueued = false
				rebuild()
			end)
		end

		local invConns = {}
		local function bindInventory(char)
			for _, c in ipairs(invConns) do
				c:Disconnect()
			end
			table.clear(invConns)

			local backpack = lp:FindFirstChild("Backpack") or lp:WaitForChild("Backpack", 5)
			if backpack then
				table.insert(invConns, backpack.ChildAdded:Connect(queueRebuild))
				table.insert(invConns, backpack.ChildRemoved:Connect(queueRebuild))
			end
			if char then
				table.insert(invConns, char.ChildAdded:Connect(queueRebuild))
				table.insert(invConns, char.ChildRemoved:Connect(queueRebuild))
			end
			rebuild()
		end

		task.spawn(bindInventory, lp.Character)
		local charAddedConn = lp.CharacterAdded:Connect(function(char)
			task.spawn(bindInventory, char)
		end)

		win.onClose(function()
			charAddedConn:Disconnect()
			for _, c in ipairs(invConns) do c:Disconnect() end
			for _, c in ipairs(conns) do c:Disconnect() end
			table.clear(conns)
			clearGunConns()
			firing = false
			clearPreview()
		end)
	end
end

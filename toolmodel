			TweenService:Create(equipBtn, fadeInfo, {BackgroundColor3 = Color3.fromRGB(36, 36, 41), TextColor3 = Color3.fromRGB(215, 215, 220)}):Play()
			TweenService:Create(equipStroke, fadeInfo, {Color = Color3.fromRGB(46, 46, 51)}):Play()
		end)

		-- ============================================================
		-- GUN MODS: side panel for specific guns
		-- ============================================================
		local GUNS = {
			["[Revolver]"]         = true,
			["[Double-Barrel SG]"] = true,
			["[TacticalShotgun]"]  = true,
		}

		local RATE_MIN, RATE_MAX = 1, 100
		local rate     = 15
		local rapidOn  = false
		local noSlowOn = false

		local selectedTool -- what you picked in the grid
		local equippedGun  -- the equipped tool, if it's one of GUNS (this is what fires)
		local gunConns = {}
		local mouseHeld, firing = false, false
		local fireAcc = 0
		local lastAction = 0
		local baseSpeed

		local SIDE_W, SIDE_GAP = 260, 8

		local panel = Instance.new("Frame")
		panel.Name = "GunModsPanel"
		panel.AnchorPoint = Vector2.new(0.5, 0.5)
		panel.Size = UDim2.new(0, SIDE_W, 1, 0)
		panel.Position = UDim2.new(1, SIDE_GAP + SIDE_W / 2, 0.5, 0)
		panel.BackgroundColor3 = CARD_BG

		equipBtn.AnchorPoint = Vector2.new(1, 0)
		equipBtn.Position = UDim2.new(1, -10, 0, 10)
		equipBtn.Size = UDim2.fromOffset(80, 26)
		equipBtn.BackgroundColor3 = Color3.fromRGB(36, 36, 41)
		equipBtn.BorderSizePixel = 0
		equipBtn.AutoButtonColor = false
		equipBtn.Font = Enum.Font.GothamMedium
		equipBtn.Text = "Equip"
		equipBtn.TextColor3 = Color3.fromRGB(215, 215, 220)

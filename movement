-- movement tab module
-- usage in the main script:
--   local buildMovementTab = loadstring(game:HttpGet(MOVEMENT_URL))()(lib)
--   buildMovementTab({pages = pages, fadeInfo = fadeInfo, slideInfo = slideInfo})
--
-- Movement page (scrollable). Every feature's settings stay hidden until its switch is
-- on, then they slide open (and slide shut again when it's turned off):
--   No-Clip   switch + keybind
--   Inf Jump  switch   -> power + cooldown   (infinite double jump: press jump in the air)
--   Speed     switch + keybind -> method (Velocity / Slippery) + amount
--   Flight    switch + keybind -> method (Velocity / Position) + amount
--   Jump      switch   -> jump power         (higher ground jumps)
--   Gravity   switch   -> gravity            (client-side workspace gravity)
--
-- keybind rule: switch ON + a key set  -> the key toggles the feature (switch only arms it)
--               switch ON + no key set -> the switch itself toggles it
--               switch OFF             -> the key does nothing
-- Flight controls: W A S D move along the camera, Space = up, Left Ctrl = down

return function(lib)
	local Players = lib.Players
	local TweenService = lib.TweenService
	local RunService = lib.RunService
	local UserInputService = lib.UserInputService
	local win = lib.win
	local addCorner, addStroke = lib.addCorner, lib.addStroke
	local TEXT_MAIN = lib.TEXT_MAIN

	local LocalPlayer = Players.LocalPlayer

	local CARD_BG = Color3.fromRGB(28, 28, 32)
	local CARD_STROKE = Color3.fromRGB(42, 42, 47)
	local FIELD_STROKE = Color3.fromRGB(46, 46, 51)
	local TEXT_SOFT = Color3.fromRGB(190, 190, 196)
	local ON_TRACK = Color3.fromRGB(225, 225, 232)
	local OFF_TRACK = Color3.fromRGB(44, 44, 50)
	local ON_KNOB = Color3.fromRGB(22, 22, 25)
	local OFF_KNOB = Color3.fromRGB(140, 140, 146)
	local SEL_BG = Color3.fromRGB(48, 48, 55)
	local SEL_STROKE = Color3.fromRGB(120, 120, 130)

	local METHODS_H, SLIDER_H = 36, 46

	local SHORT_KEYS = {
		LeftControl = "LCtrl", RightControl = "RCtrl",
		LeftShift = "LShift", RightShift = "RShift",
		LeftAlt = "LAlt", RightAlt = "RAlt",
		Return = "Enter", Backquote = "`",
	}

	return function(ctx)
		local page = ctx.pages["Movement"]
		local fadeInfo = ctx.fadeInfo

		-- ====================================================
		-- scrolling list of feature cards
		-- ====================================================
		local scroll = Instance.new("ScrollingFrame")
		scroll.Name = "MovementList"
		scroll.BackgroundTransparency = 1
		scroll.BorderSizePixel = 0
		scroll.Position = UDim2.fromOffset(14, 58)
		scroll.Size = UDim2.new(1, -28, 1, -66)
		scroll.CanvasSize = UDim2.new()
		scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
		scroll.ScrollingDirection = Enum.ScrollingDirection.Y
		scroll.ScrollBarThickness = 3
		scroll.ScrollBarImageColor3 = Color3.fromRGB(90, 90, 98)
		scroll.Parent = page

		local scrollLayout = Instance.new("UIListLayout")
		scrollLayout.Padding = UDim.new(0, 8)
		scrollLayout.SortOrder = Enum.SortOrder.LayoutOrder
		scrollLayout.Parent = scroll

		local scrollPad = Instance.new("UIPadding")
		scrollPad.PaddingRight = UDim.new(0, 6)
		scrollPad.PaddingBottom = UDim.new(0, 6)
		scrollPad.Parent = scroll

		-- ====================================================
		-- shared input state (slider dragging + keybind listening)
		-- ====================================================
		local dragFn
		local listening -- feature currently waiting for a key

		local function isPress(input)
			return input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
		end

		-- ====================================================
		-- feature state machine
		-- ====================================================
		local function setActive(f, value)
			if f.active == value then
				return
			end
			f.active = value
			if f.onChange then
				f.onChange(value)
			end
		end

		local function refreshFeature(f)
			if not f.enabled then
				setActive(f, false)
			elseif f.hasKey and f.key then
				setActive(f, false) -- armed: waits for the keybind
			else
				setActive(f, true)
			end
		end

		local function keyText(f)
			if not f.key then
				return "None"
			end
			return SHORT_KEYS[f.key.Name] or f.key.Name
		end

		-- ====================================================
		-- ui building blocks
		-- ====================================================
		local function newCard(order)
			local card = Instance.new("Frame")
			card.LayoutOrder = order
			card.Size = UDim2.new(1, 0, 0, 0)
			card.AutomaticSize = Enum.AutomaticSize.Y
			card.BackgroundColor3 = CARD_BG
			card.BorderSizePixel = 0
			card.Parent = scroll
			addCorner(card)
			addStroke(card, CARD_STROKE)

			local list = Instance.new("UIListLayout")
			list.SortOrder = Enum.SortOrder.LayoutOrder
			list.Parent = card
			return card
		end

		-- collapsible settings area: starts shut, slides + fades open when its switch is on
		local function newOptions(card, order)
			local group = Instance.new("CanvasGroup")
			group.Name = "Options"
			group.LayoutOrder = order
			group.BackgroundTransparency = 1
			group.BorderSizePixel = 0
			group.Size = UDim2.new(1, 0, 0, 0)
			group.GroupTransparency = 1
			group.Visible = false
			group.Parent = card

			local list = Instance.new("UIListLayout")
			list.SortOrder = Enum.SortOrder.LayoutOrder
			list.Parent = group

			-- thin divider under the header
			local divRow = Instance.new("Frame")
			divRow.LayoutOrder = 0
			divRow.BackgroundTransparency = 1
			divRow.Size = UDim2.new(1, 0, 0, 1)
			divRow.Parent = group
			local divLine = Instance.new("Frame")
			divLine.Position = UDim2.fromOffset(14, 0)
			divLine.Size = UDim2.new(1, -28, 1, 0)
			divLine.BackgroundColor3 = Color3.fromRGB(38, 38, 42)
			divLine.BorderSizePixel = 0
			divLine.Parent = divRow

			local opts = {group = group, height = 1, open = false}

			function opts.setOpen(open, animate)
				opts.open = open
				local info = TweenInfo.new(animate and 0.32 or 0, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
				if open then
					group.Visible = true
					TweenService:Create(group, info, {
						Size = UDim2.new(1, 0, 0, opts.height),
						GroupTransparency = 0,
					}):Play()
				else
					local tween = TweenService:Create(group, info, {
						Size = UDim2.new(1, 0, 0, 0),
						GroupTransparency = 1,
					})
					tween.Completed:Connect(function()
						if not opts.open then
							group.Visible = false
						end
					end)
					tween:Play()
				end
			end

			return opts
		end

		-- header row: title ............ [key] [switch]
		local function addHeader(card, f, title)
			local row = Instance.new("Frame")
			row.LayoutOrder = 1
			row.BackgroundTransparency = 1
			row.Size = UDim2.new(1, 0, 0, 40)
			row.Parent = card

			local reserve = f.hasKey and 126 or 62
			local label = Instance.new("TextLabel")
			label.BackgroundTransparency = 1
			label.Position = UDim2.fromOffset(14, 0)
			label.Size = UDim2.new(1, -(14 + reserve), 1, 0)
			label.Font = Enum.Font.GothamMedium
			label.Text = title
			label.TextColor3 = TEXT_MAIN
			label.TextSize = 13
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.TextTruncate = Enum.TextTruncate.AtEnd
			label.Parent = row

			-- switch
			local switch = Instance.new("TextButton")
			switch.Name = "Switch"
			switch.AnchorPoint = Vector2.new(1, 0.5)
			switch.Position = UDim2.new(1, -10, 0.5, 0)
			switch.Size = UDim2.fromOffset(42, 22)
			switch.AutoButtonColor = false
			switch.Text = ""
			switch.BorderSizePixel = 0
			switch.Parent = row
			addCorner(switch, 7)
			local switchStroke = addStroke(switch, Color3.fromRGB(60, 60, 66))

			local knob = Instance.new("Frame")
			knob.AnchorPoint = Vector2.new(0, 0.5)
			knob.Size = UDim2.fromOffset(16, 16)
			knob.BorderSizePixel = 0
			knob.Parent = switch
			addCorner(knob, 5)

			local function applySwitch(animate)
				local info = animate and fadeInfo or TweenInfo.new(0)
				TweenService:Create(switch, info, {BackgroundColor3 = f.enabled and ON_TRACK or OFF_TRACK}):Play()
				TweenService:Create(knob, info, {
					BackgroundColor3 = f.enabled and ON_KNOB or OFF_KNOB,
					Position = UDim2.new(0, f.enabled and 23 or 3, 0.5, 0),
				}):Play()
			end
			applySwitch(false)

			switch.MouseEnter:Connect(function()
				TweenService:Create(switchStroke, fadeInfo, {Color = Color3.fromRGB(110, 110, 120)}):Play()
			end)
			switch.MouseLeave:Connect(function()
				TweenService:Create(switchStroke, fadeInfo, {Color = Color3.fromRGB(60, 60, 66)}):Play()
			end)
			switch.MouseButton1Click:Connect(function()
				f.enabled = not f.enabled
				applySwitch(true)
				refreshFeature(f)
				if f.options then
					f.options.setOpen(f.enabled, true)
				end
			end)

			-- keybind button
			if f.hasKey then
				local keyBtn = Instance.new("TextButton")
				keyBtn.Name = "Keybind"
				keyBtn.AnchorPoint = Vector2.new(1, 0.5)
				keyBtn.Position = UDim2.new(1, -60, 0.5, 0)
				keyBtn.Size = UDim2.fromOffset(58, 22)
				keyBtn.BackgroundColor3 = Color3.fromRGB(36, 36, 41)
				keyBtn.BorderSizePixel = 0
				keyBtn.AutoButtonColor = false
				keyBtn.Font = Enum.Font.GothamMedium
				keyBtn.TextColor3 = Color3.fromRGB(215, 215, 220)
				keyBtn.TextSize = 11
				keyBtn.TextTruncate = Enum.TextTruncate.AtEnd
				keyBtn.Parent = row
				addCorner(keyBtn, 6)
				local keyStroke = addStroke(keyBtn, Color3.fromRGB(60, 60, 66))

				function f.refreshKeyButton()
					local waiting = listening == f
					keyBtn.Text = waiting and "..." or keyText(f)
					TweenService:Create(keyStroke, fadeInfo, {
						Color = waiting and Color3.fromRGB(225, 225, 232) or Color3.fromRGB(60, 60, 66),
					}):Play()
				end
				f.refreshKeyButton()

				keyBtn.MouseButton1Click:Connect(function()
					local previous = listening
					listening = f
					if previous and previous ~= f and previous.refreshKeyButton then
						previous.refreshKeyButton()
					end
					f.refreshKeyButton()
				end)
			end
		end

		-- method selector (segmented buttons)
		local function addMethods(parent, order, options, default)
			local row = Instance.new("Frame")
			row.LayoutOrder = order
			row.BackgroundTransparency = 1
			row.Size = UDim2.new(1, 0, 0, METHODS_H)
			row.Parent = parent

			local holder = Instance.new("Frame")
			holder.BackgroundTransparency = 1
			holder.Position = UDim2.fromOffset(14, 5)
			holder.Size = UDim2.new(1, -28, 0, 26)
			holder.Parent = row

			local layout = Instance.new("UIListLayout")
			layout.FillDirection = Enum.FillDirection.Horizontal
			layout.Padding = UDim.new(0, 6)
			layout.SortOrder = Enum.SortOrder.LayoutOrder
			layout.Parent = holder

			local selected = default
			local buttons, strokes = {}, {}
			local n = #options

			local function refresh(animate)
				local info = animate and fadeInfo or TweenInfo.new(0)
				for name, btn in pairs(buttons) do
					local sel = name == selected
					TweenService:Create(btn, info, {
						BackgroundColor3 = sel and SEL_BG or CARD_BG,
						TextColor3 = sel and TEXT_MAIN or TEXT_SOFT,
					}):Play()
					TweenService:Create(strokes[name], info, {Color = sel and SEL_STROKE or FIELD_STROKE}):Play()
				end
			end

			for i, name in ipairs(options) do
				local btn = Instance.new("TextButton")
				btn.Name = name
				btn.LayoutOrder = i
				btn.Size = UDim2.new(1 / n, -6 * (n - 1) / n, 1, 0)
				btn.BackgroundColor3 = CARD_BG
				btn.BorderSizePixel = 0
				btn.AutoButtonColor = false
				btn.Font = Enum.Font.GothamMedium
				btn.Text = name
				btn.TextColor3 = TEXT_SOFT
				btn.TextSize = 12
				btn.Parent = holder
				addCorner(btn)
				strokes[name] = addStroke(btn, FIELD_STROKE)
				buttons[name] = btn

				btn.MouseButton1Click:Connect(function()
					selected = name
					refresh(true)
				end)
			end
			refresh(false)

			return {
				Get = function()
					return selected
				end,
			}
		end

		-- slider with a value read-out
		local function addSlider(parent, order, title, min, max, default, suffix)
			local row = Instance.new("Frame")
			row.LayoutOrder = order
			row.BackgroundTransparency = 1
			row.Size = UDim2.new(1, 0, 0, SLIDER_H)
			row.Parent = parent

			local titleLabel = Instance.new("TextLabel")
			titleLabel.BackgroundTransparency = 1
			titleLabel.Position = UDim2.fromOffset(14, 6)
			titleLabel.Size = UDim2.new(0.5, -14, 0, 16)
			titleLabel.Font = Enum.Font.GothamMedium
			titleLabel.Text = title
			titleLabel.TextColor3 = TEXT_SOFT
			titleLabel.TextSize = 12
			titleLabel.TextXAlignment = Enum.TextXAlignment.Left
			titleLabel.Parent = row

			local valueLabel = Instance.new("TextLabel")
			valueLabel.BackgroundTransparency = 1
			valueLabel.AnchorPoint = Vector2.new(1, 0)
			valueLabel.Position = UDim2.new(1, -14, 0, 6)
			valueLabel.Size = UDim2.new(0.5, -14, 0, 16)
			valueLabel.Font = Enum.Font.GothamMedium
			valueLabel.TextColor3 = TEXT_MAIN
			valueLabel.TextSize = 12
			valueLabel.TextXAlignment = Enum.TextXAlignment.Right
			valueLabel.Parent = row

			local track = Instance.new("Frame")
			track.Position = UDim2.fromOffset(14, 30)
			track.Size = UDim2.new(1, -28, 0, 6)
			track.BackgroundColor3 = OFF_TRACK
			track.BorderSizePixel = 0
			track.Parent = row
			addCorner(track, 1000)

			local fill = Instance.new("Frame")
			fill.Size = UDim2.fromScale(0, 1)
			fill.BackgroundColor3 = ON_TRACK
			fill.BorderSizePixel = 0
			fill.Parent = track
			addCorner(fill, 1000)

			local thumb = Instance.new("Frame")
			thumb.AnchorPoint = Vector2.new(0.5, 0.5)
			thumb.Size = UDim2.fromOffset(12, 12)
			thumb.BackgroundColor3 = Color3.fromRGB(245, 245, 248)
			thumb.BorderSizePixel = 0
			thumb.ZIndex = 3
			thumb.Parent = track
			addCorner(thumb, 1000)

			local hit = Instance.new("TextButton")
			hit.Position = UDim2.fromOffset(14, 22)
			hit.Size = UDim2.new(1, -28, 0, 22)
			hit.BackgroundTransparency = 1
			hit.AutoButtonColor = false
			hit.Text = ""
			hit.ZIndex = 5
			hit.Parent = row

			local value = default
			local function setValue(v)
				v = math.clamp(math.floor(v + 0.5), min, max)
				value = v
				local pct = (v - min) / (max - min)
				fill.Size = UDim2.fromScale(pct, 1)
				thumb.Position = UDim2.fromScale(pct, 0.5)
				valueLabel.Text = tostring(v) .. (suffix or "")
			end
			setValue(default)

			hit.InputBegan:Connect(function(input)
				if isPress(input) then
					dragFn = function()
						local m = UserInputService:GetMouseLocation()
						local ap, as = track.AbsolutePosition, track.AbsoluteSize
						setValue(min + math.clamp((m.X - ap.X) / as.X, 0, 1) * (max - min))
					end
					dragFn()
				end
			end)

			return {
				Get = function()
					return value
				end,
			}
		end

		-- ====================================================
		-- helpers for the effects
		-- ====================================================
		local function getChar()
			local char = LocalPlayer.Character
			if not char then
				return nil
			end
			return char, char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart")
		end

		-- no-clip
		local noclipParts = {}
		local function restoreCollisions()
			for part in pairs(noclipParts) do
				if part.Parent then
					part.CanCollide = true
				end
			end
			table.clear(noclipParts)
		end

		-- slippery friction (speed method)
		local SLIPPERY = PhysicalProperties.new(0.7, 0, 0, 100, 100)
		local origPhysics = {}
		local slipApplied = false
		local function applyFriction(char)
			table.clear(origPhysics)
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					origPhysics[part] = part.CustomPhysicalProperties or false
					part.CustomPhysicalProperties = SLIPPERY
				end
			end
			slipApplied = true
		end
		local function restoreFriction()
			for part, orig in pairs(origPhysics) do
				if part.Parent then
					part.CustomPhysicalProperties = orig or nil
				end
			end
			table.clear(origPhysics)
			slipApplied = false
		end

		-- ====================================================
		-- features
		-- ====================================================
		local noclip   = {enabled = false, active = false, hasKey = true}
		local infJump  = {enabled = false, active = false, hasKey = false}
		local speed    = {enabled = false, active = false, hasKey = true}
		local flight   = {enabled = false, active = false, hasKey = true}
		local jump     = {enabled = false, active = false, hasKey = false}
		local gravity  = {enabled = false, active = false, hasKey = false}
		local noSlow   = {enabled = false, active = false, hasKey = false}
		local noJumpCD = {enabled = false, active = false, hasKey = false}
		local keyed = {noclip, speed, flight}

		local speedMethod, speedSlider
		local flightMethod, flightSlider
		local infPower, infCooldown
		local jumpSlider, gravitySlider

		-- No-Clip
		do
			local card = newCard(1)
			addHeader(card, noclip, "No-Clip")
			noclip.onChange = function(active)
				if not active then
					restoreCollisions()
				end
			end
		end

		-- Inf Jump (infinite double jump)
		do
			local card = newCard(2)
			local opts = newOptions(card, 2)
			infJump.options = opts
			addHeader(card, infJump, "Inf Jump")
			infPower = addSlider(opts.group, 1, "Air jump power", 30, 250, 70)
			infCooldown = addSlider(opts.group, 2, "Cooldown", 0, 500, 150, " ms")
			opts.height += SLIDER_H * 2
		end

		-- Speed
		do
			local card = newCard(3)
			local opts = newOptions(card, 2)
			speed.options = opts
			addHeader(card, speed, "Speed")
			speedMethod = addMethods(opts.group, 1, {"Velocity", "Slippery"}, "Velocity")
			speedSlider = addSlider(opts.group, 2, "Amount", 16, 300, 50)
			opts.height += METHODS_H + SLIDER_H
			speed.onChange = function(active)
				if not active and slipApplied then
					restoreFriction()
				end
			end
		end

		-- Flight
		do
			local card = newCard(4)
			local opts = newOptions(card, 2)
			flight.options = opts
			addHeader(card, flight, "Flight")
			flightMethod = addMethods(opts.group, 1, {"Velocity", "Position"}, "Velocity")
			flightSlider = addSlider(opts.group, 2, "Amount", 10, 300, 60)
			opts.height += METHODS_H + SLIDER_H
			flight.onChange = function(active)
				if not active then
					local _, _, root = getChar()
					if root then
						root.AssemblyLinearVelocity = Vector3.zero
					end
				end
			end
		end

		-- Jump (higher ground jumps)
		local origUseJumpPower, origJumpPower
		do
			local card = newCard(5)
			local opts = newOptions(card, 2)
			jump.options = opts
			addHeader(card, jump, "Jump")
			jumpSlider = addSlider(opts.group, 1, "Jump power", 50, 400, 100)
			opts.height += SLIDER_H
			jump.onChange = function(active)
				local _, hum = getChar()
				if active then
					if hum then
						origUseJumpPower, origJumpPower = hum.UseJumpPower, hum.JumpPower
					end
				elseif hum and origJumpPower ~= nil then
					hum.UseJumpPower = origUseJumpPower
					hum.JumpPower = origJumpPower
				end
			end
		end

		-- Gravity (client-side)
		local origGravity
		do
			local card = newCard(6)
			local opts = newOptions(card, 2)
			gravity.options = opts
			addHeader(card, gravity, "Gravity")
			gravitySlider = addSlider(opts.group, 1, "Gravity", 0, 400, 100)
			opts.height += SLIDER_H
			gravity.onChange = function(active)
				if active then
					origGravity = workspace.Gravity
				elseif origGravity ~= nil then
					workspace.Gravity = origGravity
				end
			end
		end

		-- No Slowdown (switch-only)
		do
			local card = newCard(7)
			addHeader(card, noSlow, "No Slowdown")
			noSlow.onChange = function(active)
				if not active then
					noSlow._baseSpeed = nil
				end
			end
		end

		-- No Jump Cooldown (switch-only)
		local jumpCDStateConn
		do
			local card = newCard(8)
			addHeader(card, noJumpCD, "No Jump Cooldown")
			noJumpCD.onChange = function(active)
				if jumpCDStateConn then
					jumpCDStateConn:Disconnect()
					jumpCDStateConn = nil
				end
				if active then
					local _, hum = getChar()
					if hum then
						jumpCDStateConn = hum.StateChanged:Connect(function(_, new)
							if new == Enum.HumanoidStateType.Landed then
								task.defer(function()
									if noJumpCD.active and hum and hum.Parent then
										hum:ChangeState(Enum.HumanoidStateType.Running)
									end
								end)
							end
						end)
					end
				end
			end
		end

		-- ====================================================
		-- keybinds
		-- ====================================================
		local inputConn = UserInputService.InputBegan:Connect(function(input, processed)
			if input.UserInputType ~= Enum.UserInputType.Keyboard then
				return
			end
			local kc = input.KeyCode

			if listening then
				local f = listening
				listening = nil
				if kc ~= Enum.KeyCode.Escape then
					local hadKey = f.key ~= nil
					f.key = (kc ~= Enum.KeyCode.Backspace and kc ~= Enum.KeyCode.Delete) and kc or nil
					if hadKey ~= (f.key ~= nil) then
						refreshFeature(f)
					end
				end
				f.refreshKeyButton()
				return
			end

			if processed then
				return
			end
			for _, f in ipairs(keyed) do
				if f.enabled and f.key and f.key == kc then
					setActive(f, not f.active)
				end
			end
		end)

		local moveConn = UserInputService.InputChanged:Connect(function(input)
			if dragFn and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				dragFn()
			end
		end)
		local endConn = UserInputService.InputEnded:Connect(function(input)
			if isPress(input) then
				dragFn = nil
			end
		end)

		-- ====================================================
		-- Inf Jump: press jump in the air -> jump again (no limit)
		-- ====================================================
		local jumpBoosted = false -- true from a jump until you touch the ground again
		local lastAirJump = 0

		local jumpConn = UserInputService.JumpRequest:Connect(function()
			if not infJump.active then
				return
			end
			local _, hum, root = getChar()
			if not (hum and root) or hum.Health <= 0 then
				return
			end
			-- on the ground the normal jump handles it
			if hum.FloorMaterial ~= Enum.Material.Air then
				return
			end
			local now = os.clock()
			if now - lastAirJump < infCooldown.Get() / 1000 then
				return
			end
			lastAirJump = now

			local power = infPower.Get()
			jumpBoosted = true -- keep the Jump feature from overriding this jump
			pcall(function()
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
			end)
			local vel = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(vel.X, power, vel.Z)
			task.defer(function()
				if root.Parent then
					local v = root.AssemblyLinearVelocity
					root.AssemblyLinearVelocity = Vector3.new(v.X, math.max(v.Y, power), v.Z)
				end
			end)
		end)

		-- ====================================================
		-- effect loops
		-- ====================================================
		-- Gravity: workspace.Gravity is client-side. It is pushed right before physics
		-- (Stepped), every frame, and instantly if the game tries to change it back.
		local function pushGravity()
			if gravity.active then
				local target = gravitySlider.Get()
				if workspace.Gravity ~= target then
					workspace.Gravity = target
				end
			end
		end
		local gravitySignal = workspace:GetPropertyChangedSignal("Gravity"):Connect(pushGravity)
		local renderConn = RunService.RenderStepped:Connect(pushGravity)

		local steppedConn = RunService.Stepped:Connect(function()
			pushGravity()
			if not noclip.active then
				return
			end
			local char = LocalPlayer.Character
			if not char then
				return
			end
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") and part.CanCollide then
					noclipParts[part] = true
					part.CanCollide = false
				end
			end
		end)

		local function doSpeed(hum, root, dt)
			local dir = hum.MoveDirection
			if dir.Magnitude < 0.01 then
				return
			end
			dir = dir.Unit
			local amount = speedSlider.Get()
			local vel = root.AssemblyLinearVelocity
			local target = Vector3.new(dir.X * amount, vel.Y, dir.Z * amount)
			if speedMethod.Get() == "Velocity" then
				root.AssemblyLinearVelocity = target
			else -- Slippery: zero friction + momentum build-up
				root.AssemblyLinearVelocity = vel:Lerp(target, math.clamp(dt * 10, 0, 1))
			end
		end

		local function doFlight(root, dt)
			local cam = workspace.CurrentCamera
			local dir = Vector3.zero
			if cam and UserInputService:GetFocusedTextBox() == nil then
				local look, right = cam.CFrame.LookVector, cam.CFrame.RightVector
				if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += look end
				if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= look end
				if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += right end
				if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= right end
				if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
				if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
			end
			if dir.Magnitude > 0 then
				dir = dir.Unit
			end
			local amount = flightSlider.Get()
			if flightMethod.Get() == "Velocity" then
				root.AssemblyLinearVelocity = dir * amount
			else
				root.AssemblyLinearVelocity = Vector3.zero
				root.CFrame = root.CFrame + dir * amount * dt
			end
		end

		local heartbeatConn = RunService.Heartbeat:Connect(function(dt)
			pushGravity()

			local char, hum, root = getChar()
			if not (char and hum and root) or hum.Health <= 0 then
				return
			end

			-- Jump: set the jump power AND boost the launch velocity, because some games
			-- ignore JumpPower. The boost fires once per jump.
			if jump.active then
				local power = jumpSlider.Get()
				hum.UseJumpPower = true
				hum.JumpPower = power
				if hum:GetState() == Enum.HumanoidStateType.Jumping then
					if not jumpBoosted then
						jumpBoosted = true
						local vel = root.AssemblyLinearVelocity
						root.AssemblyLinearVelocity = Vector3.new(vel.X, power, vel.Z)
					end
				elseif hum.FloorMaterial ~= Enum.Material.Air then
					jumpBoosted = false
				end
			elseif hum.FloorMaterial ~= Enum.Material.Air then
				jumpBoosted = false
			end

			-- No Slowdown: remember the intended WalkSpeed when first enabled, then restore
			-- it every frame if the game lowers it (reload/crouch/shoot penalties).
			if noSlow.active then
				if not noSlow._baseSpeed then
					noSlow._baseSpeed = hum.WalkSpeed
				elseif hum.WalkSpeed < noSlow._baseSpeed then
					hum.WalkSpeed = noSlow._baseSpeed
				else
					noSlow._baseSpeed = hum.WalkSpeed -- track intentional speed changes
				end
			end

			local wantSlip = speed.active and not flight.active and speedMethod.Get() == "Slippery"
			if wantSlip and not slipApplied then
				applyFriction(char)
			elseif not wantSlip and slipApplied then
				restoreFriction()
			end

			if flight.active then
				doFlight(root, dt)
			elseif speed.active then
				doSpeed(hum, root, dt)
			end
		end)

		-- a respawn replaces every part, so drop the old bookkeeping
		local charConn = LocalPlayer.CharacterAdded:Connect(function(char)
			restoreFriction()
			table.clear(noclipParts)
			jumpBoosted = false
			noSlow._baseSpeed = nil

			-- re-wire No Jump Cooldown to the new humanoid
			if jumpCDStateConn then
				jumpCDStateConn:Disconnect()
				jumpCDStateConn = nil
			end
			if noJumpCD.active then
				local hum = char:WaitForChild("Humanoid", 5)
				if hum then
					jumpCDStateConn = hum.StateChanged:Connect(function(_, new)
						if new == Enum.HumanoidStateType.Landed then
							task.defer(function()
								if noJumpCD.active and hum and hum.Parent then
									hum:ChangeState(Enum.HumanoidStateType.Running)
								end
							end)
						end
					end)
				end
			end
		end)

		-- ====================================================
		-- cleanup
		-- ====================================================
		local function destroy()
			for _, f in ipairs({noclip, infJump, speed, flight, jump, gravity, noSlow, noJumpCD}) do
				setActive(f, false)
			end
			if jumpCDStateConn then jumpCDStateConn:Disconnect(); jumpCDStateConn = nil end
			restoreFriction()
			restoreCollisions()
			jumpConn:Disconnect()
			inputConn:Disconnect()
			moveConn:Disconnect()
			endConn:Disconnect()
			steppedConn:Disconnect()
			renderConn:Disconnect()
			heartbeatConn:Disconnect()
			gravitySignal:Disconnect()
			charConn:Disconnect()
		end
		win.onClose(destroy)

		return {
			Destroy = destroy,
		}
	end
end

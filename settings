-- settings tab module
-- usage in the main script:
--   local buildSettingsTab = loadstring(game:HttpGet(SETTINGS_URL))()(lib)
--   buildSettingsTab({pages = pages, fadeInfo = fadeInfo, slideInfo = slideInfo, watermark = watermark})
--
-- Settings page:
--   Menu toggle   keybind that shows / hides the whole menu
--   Watermark     switch
--   Keybind list  switch for the on-screen list (off when the script starts)
--
-- Keybind list (own ScreenGui, middle left of the screen, visible while its switch is on):
--   * every module has a line:   "No-Clip            [X]"   (name left, [key] right, no key = just the name)
--     - bright = running, grey = switch on but waiting for its key, dark = module is off
--     - turning a module off greys it out, turning it on again makes it look normal
--   * the whole Visuals tab is a single "ESP" line (master switch + at least one ESP on = on)
--   * the top-left corner is the anchor, so the list only ever grows downwards
--   * while the menu is OPEN you can drag the list anywhere; while the menu is HIDDEN it stays
--     where it is until you open the menu again
--   * modules add themselves with lib.registerKeybind({name, getEnabled, getActive?, getKey?});
--     older Movement / Visuals files that don't do that are read straight from their pages instead

return function(lib)
	local Players = lib.Players
	local TweenService = lib.TweenService
	local RunService = lib.RunService
	local UserInputService = lib.UserInputService
	local win = lib.win
	local addCorner, addStroke = lib.addCorner, lib.addStroke
	local TEXT_MAIN = lib.TEXT_MAIN

	local ROW_BG = Color3.fromRGB(28, 28, 32)
	local ROW_STROKE = Color3.fromRGB(42, 42, 47)
	local ON_TRACK = Color3.fromRGB(225, 225, 232)
	local OFF_TRACK = Color3.fromRGB(44, 44, 50)
	local ON_KNOB = Color3.fromRGB(22, 22, 25)
	local OFF_KNOB = Color3.fromRGB(140, 140, 146)

	-- keybind list look
	local LIST_W, ROW_H, HEADER_H = 170, 20, 24
	local LIST_BG = Color3.fromRGB(17, 17, 19)
	local LIST_STROKE_IDLE = Color3.fromRGB(45, 45, 50)
	local LIST_STROKE_MOVABLE = Color3.fromRGB(90, 90, 100)
	local COLOR_ON = Color3.fromRGB(238, 238, 242)   -- module is running
	local COLOR_WAIT = Color3.fromRGB(150, 150, 158) -- switch is on, waiting for its key
	local COLOR_OFF = Color3.fromRGB(78, 78, 85)     -- module is off

	return function(ctx)
		local page = ctx.pages["Settings"]
		local fadeInfo = ctx.fadeInfo
		local watermark = ctx.watermark

		local menuOpen = true
		local watermarkWanted = true
		local listWanted = false -- off until the "Keybind list" switch is turned on

		-- ====================================================
		-- page rows
		-- ====================================================
		local function newRow(name, y)
			local row = Instance.new("Frame")
			row.Name = name
			row.Position = UDim2.fromOffset(20, y)
			row.Size = UDim2.new(1, -40, 0, 48)
			row.BackgroundColor3 = ROW_BG
			row.BorderSizePixel = 0
			row.Parent = page
			addCorner(row)
			addStroke(row, ROW_STROKE)

			local label = Instance.new("TextLabel")
			label.BackgroundTransparency = 1
			label.Position = UDim2.fromOffset(16, 0)
			label.Size = UDim2.new(0.5, 0, 1, 0)
			label.Font = Enum.Font.GothamMedium
			label.Text = name
			label.TextColor3 = TEXT_MAIN
			label.TextSize = 14
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.Parent = row
			return row, label
		end

		-- label + switch row
		local function addSwitchRow(y, text, default, onChange)
			local row, label = newRow(text, y)

			local switch = Instance.new("TextButton")
			switch.Name = "Switch"
			switch.AnchorPoint = Vector2.new(1, 0.5)
			switch.Position = UDim2.new(1, -12, 0.5, 0)
			switch.Size = UDim2.fromOffset(46, 24)
			switch.AutoButtonColor = false
			switch.Text = ""
			switch.BorderSizePixel = 0
			switch.Parent = row
			addCorner(switch, 7)
			local switchStroke = addStroke(switch, Color3.fromRGB(60, 60, 66))

			local knob = Instance.new("Frame")
			knob.AnchorPoint = Vector2.new(0, 0.5)
			knob.Size = UDim2.fromOffset(18, 18)
			knob.BorderSizePixel = 0
			knob.Parent = switch
			addCorner(knob, 5)

			local isOn = default
			local function apply(animate)
				local info = animate and fadeInfo or TweenInfo.new(0)
				TweenService:Create(switch, info, {BackgroundColor3 = isOn and ON_TRACK or OFF_TRACK}):Play()
				TweenService:Create(knob, info, {
					BackgroundColor3 = isOn and ON_KNOB or OFF_KNOB,
					Position = UDim2.new(0, isOn and 25 or 3, 0.5, 0),
				}):Play()
			end
			apply(false)

			switch.MouseEnter:Connect(function()
				TweenService:Create(switchStroke, fadeInfo, {Color = Color3.fromRGB(110, 110, 120)}):Play()
			end)
			switch.MouseLeave:Connect(function()
				TweenService:Create(switchStroke, fadeInfo, {Color = Color3.fromRGB(60, 60, 66)}):Play()
			end)

			local obj = {}
			function obj.Set(value)
				isOn = value and true or false
				apply(true)
				onChange(isOn)
			end
			switch.MouseButton1Click:Connect(function()
				obj.Set(not isOn)
			end)
			return obj
		end

		-- ---------- Menu toggle (keybind) ----------
		local beganConn, endedConn
		do
			local row = newRow("Menu toggle", 66)

			local IDLE_STROKE = Color3.fromRGB(60, 60, 66)
			local HOVER_STROKE = Color3.fromRGB(110, 110, 120)
			local LISTEN_STROKE = Color3.fromRGB(225, 225, 232)

			local keyBtn = Instance.new("TextButton")
			keyBtn.Name = "MenuKeybind"
			keyBtn.AnchorPoint = Vector2.new(1, 0.5)
			keyBtn.Position = UDim2.new(1, -12, 0.5, 0)
			keyBtn.Size = UDim2.fromOffset(110, 26)
			keyBtn.BackgroundColor3 = Color3.fromRGB(36, 36, 41)
			keyBtn.BorderSizePixel = 0
			keyBtn.AutoButtonColor = false
			keyBtn.Font = Enum.Font.GothamMedium
			keyBtn.TextColor3 = Color3.fromRGB(215, 215, 220)
			keyBtn.TextSize = 13
			keyBtn.Parent = row
			addCorner(keyBtn, 6)
			local keyStroke = addStroke(keyBtn, IDLE_STROKE)

			local bind = {key = Enum.KeyCode.Insert, ctrl = false, alt = false, shift = false}
			local listening = false
			local pendingMod

			local MOD_KEYS = {
				[Enum.KeyCode.LeftControl] = "LCtrl", [Enum.KeyCode.RightControl] = "RCtrl",
				[Enum.KeyCode.LeftShift] = "LShift", [Enum.KeyCode.RightShift] = "RShift",
				[Enum.KeyCode.LeftAlt] = "LAlt", [Enum.KeyCode.RightAlt] = "RAlt",
			}

			local function ctrlDown() return UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) end
			local function shiftDown() return UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift) end
			local function altDown() return UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt) end

			local function bindText()
				local parts = {}
				if bind.ctrl then table.insert(parts, "Ctrl") end
				if bind.alt then table.insert(parts, "Alt") end
				if bind.shift then table.insert(parts, "Shift") end
				table.insert(parts, MOD_KEYS[bind.key] or bind.key.Name)
				return table.concat(parts, " + ")
			end

			local function refresh()
				keyBtn.Text = listening and "Press a key..." or bindText()
				TweenService:Create(keyStroke, fadeInfo, {Color = listening and LISTEN_STROKE or IDLE_STROKE}):Play()
			end
			refresh()

			local function finish(key, ctrl, alt, shift)
				bind = {key = key, ctrl = ctrl, alt = alt, shift = shift}
				listening = false
				pendingMod = nil
				refresh()
			end

			keyBtn.MouseEnter:Connect(function()
				if not listening then TweenService:Create(keyStroke, fadeInfo, {Color = HOVER_STROKE}):Play() end
			end)
			keyBtn.MouseLeave:Connect(function()
				if not listening then TweenService:Create(keyStroke, fadeInfo, {Color = IDLE_STROKE}):Play() end
			end)
			keyBtn.MouseButton1Click:Connect(function()
				listening = true
				pendingMod = nil
				refresh()
			end)

			beganConn = UserInputService.InputBegan:Connect(function(input, processed)
				if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
				local kc = input.KeyCode

				if listening then
					if kc == Enum.KeyCode.Escape then
						listening = false
						pendingMod = nil
						refresh()
					elseif MOD_KEYS[kc] then
						pendingMod = kc
					else
						finish(kc, ctrlDown(), altDown(), shiftDown())
					end
					return
				end

				if processed or kc ~= bind.key then return end
				if not MOD_KEYS[bind.key] then
					if ctrlDown() ~= bind.ctrl or altDown() ~= bind.alt or shiftDown() ~= bind.shift then return end
				end
				menuOpen = not menuOpen
				win.gui.Enabled = menuOpen
				watermark.SetVisible(menuOpen and watermarkWanted)
			end)

			endedConn = UserInputService.InputEnded:Connect(function(input)
				if listening and input.UserInputType == Enum.UserInputType.Keyboard and pendingMod and input.KeyCode == pendingMod then
					finish(pendingMod, false, false, false)
				end
			end)
		end

		-- ---------- Watermark ----------
		addSwitchRow(122, "Watermark", true, function(isOn)
			watermarkWanted = isOn
			watermark.SetVisible(isOn and menuOpen)
		end)

		-- ---------- Keybind list ----------
		addSwitchRow(178, "Keybind list", false, function(isOn)
			listWanted = isOn
		end)

		-- ====================================================
		-- keybind list (separate ScreenGui so it stays visible while the menu is hidden)
		-- The top-left corner is the anchor: new rows are added below and the list never grows upwards.
		-- ====================================================
		local listGui = Instance.new("ScreenGui")
		listGui.Name = "KeybindList"
		listGui.ResetOnSpawn = false
		listGui.IgnoreGuiInset = true
		listGui.DisplayOrder = 5
		listGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		listGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

		local listFrame = Instance.new("Frame")
		listFrame.Name = "List"
		listFrame.AnchorPoint = Vector2.new(0, 0)
		listFrame.Position = UDim2.new(0, 16, 0.5, -110) -- middle left, top edge fixed
		listFrame.Size = UDim2.fromOffset(LIST_W, 0)
		listFrame.AutomaticSize = Enum.AutomaticSize.Y
		listFrame.BackgroundColor3 = LIST_BG
		listFrame.BackgroundTransparency = 0.1
		listFrame.BorderSizePixel = 0
		listFrame.Active = true
		listFrame.Visible = false
		listFrame.Parent = listGui
		addCorner(listFrame, 3)
		local listStroke = addStroke(listFrame, LIST_STROKE_IDLE)

		local listLayout = Instance.new("UIListLayout")
		listLayout.SortOrder = Enum.SortOrder.LayoutOrder
		listLayout.Parent = listFrame

		local listPad = Instance.new("UIPadding")
		listPad.PaddingBottom = UDim.new(0, 4)
		listPad.Parent = listFrame

		-- header: plain title + a thin line
		do
			local header = Instance.new("Frame")
			header.Name = "Header"
			header.LayoutOrder = 0
			header.BackgroundTransparency = 1
			header.Size = UDim2.new(1, 0, 0, HEADER_H)
			header.Parent = listFrame

			local title = Instance.new("TextLabel")
			title.BackgroundTransparency = 1
			title.Position = UDim2.fromOffset(8, 0)
			title.Size = UDim2.new(1, -16, 1, 0)
			title.Font = Enum.Font.GothamMedium
			title.Text = "Keybinds"
			title.TextColor3 = Color3.fromRGB(205, 205, 210)
			title.TextSize = 12
			title.TextXAlignment = Enum.TextXAlignment.Left
			title.Parent = header

			local line = Instance.new("Frame")
			line.AnchorPoint = Vector2.new(0, 1)
			line.Position = UDim2.new(0, 0, 1, 0)
			line.Size = UDim2.new(1, 0, 0, 1)
			line.BackgroundColor3 = Color3.fromRGB(40, 40, 44)
			line.BorderSizePixel = 0
			line.Parent = header
		end

		local entries = {} -- every module in the list (registered ones + scanned ones)
		local known = {}
		local rows = {} -- [index] = {name, key, state, keyText}

		local function addEntry(e)
			if not known[e] then
				known[e] = true
				table.insert(entries, e)
			end
		end

		-- ------------------------------------------------
		-- fallback for older Movement / Visuals files that do not register themselves:
		-- the list reads their switches (and key buttons) straight from the pages.
		-- Modules that DO register are never scanned.
		-- ------------------------------------------------
		local scanned = {} -- [name] = state of an entry created by the scan
		local MOVE_NAMES = {["Jump"] = "Jump Power"}

		local function switchOn(btn)
			return btn.BackgroundColor3.R > 0.5 -- on = light track, off = dark track
		end

		local function scannedState(name)
			local st = scanned[name]
			if not st then
				st = {enabled = false, key = nil}
				scanned[name] = st
				addEntry({
					name = name,
					getEnabled = function() return st.enabled end,
					getKey = function() return st.key end,
				})
			end
			return st
		end

		local function scanPages()
			local registered = {}
			for _, e in ipairs(lib.keybindEntries or {}) do
				registered[e.name] = true
			end

			-- Movement: every card header has a title, a "Switch" and (optionally) a "Keybind" button
			local movePage = ctx.pages["Movement"]
			local moveList = movePage and movePage:FindFirstChild("MovementList")
			if moveList then
				for _, card in ipairs(moveList:GetChildren()) do
					if card:IsA("Frame") then
						for _, row in ipairs(card:GetChildren()) do
							local switch = row:IsA("Frame") and row:FindFirstChild("Switch")
							local label = switch and row:FindFirstChildOfClass("TextLabel")
							if label then
								local name = MOVE_NAMES[label.Text] or label.Text
								if not registered[name] then
									local st = scannedState(name)
									st.enabled = switchOn(switch)
									local keyBtn = row:FindFirstChild("Keybind")
									if keyBtn and keyBtn.Text ~= "..." then
										st.key = (keyBtn.Text ~= "None" and keyBtn.Text ~= "") and keyBtn.Text or nil
									end
								end
							end
						end
					end
				end
			end

			-- Visuals: one "ESP" entry = master switch on + at least one ESP feature switch on
			if not registered["ESP"] then
				local visPage = ctx.pages["Visuals"]
				local mainCard = visPage and visPage:FindFirstChild("VisualsCard", true)
				if mainCard then
					local masterOn = false
					for _, row in ipairs(mainCard:GetChildren()) do
						if row:IsA("Frame") and row.Position.Y.Offset == 0 then
							local btn = row:FindFirstChildOfClass("TextButton")
							if btn then
								masterOn = switchOn(btn)
							end
						end
					end

					local anyOn = false
					for _, cardName in ipairs({"EspFeaturesCard", "BoxEspCard"}) do
						local featCard = visPage:FindFirstChild(cardName, true)
						if featCard then
							for _, row in ipairs(featCard:GetChildren()) do
								local btn = row:IsA("Frame") and row:FindFirstChildOfClass("TextButton")
								local label = btn and row:FindFirstChildOfClass("TextLabel")
								if label and label.Text ~= "Team Colors" and switchOn(btn) then
									anyOn = true
								end
							end
						end
					end
					scannedState("ESP").enabled = masterOn and anyOn
				end
			end
		end

		-- one line per module: name on the left, [key] on the right
		local function makeRow(entry, order)
			local frame = Instance.new("Frame")
			frame.Name = entry.name
			frame.LayoutOrder = order
			frame.BackgroundTransparency = 1
			frame.BorderSizePixel = 0
			frame.Size = UDim2.new(1, 0, 0, ROW_H)
			frame.Parent = listFrame

			local name = Instance.new("TextLabel")
			name.BackgroundTransparency = 1
			name.Position = UDim2.fromOffset(8, 0)
			name.Size = UDim2.new(1, -52, 1, 0)
			name.Font = Enum.Font.Gotham
			name.Text = entry.name
			name.TextColor3 = COLOR_OFF
			name.TextSize = 12
			name.TextXAlignment = Enum.TextXAlignment.Left
			name.TextTruncate = Enum.TextTruncate.AtEnd
			name.Parent = frame

			local key = Instance.new("TextLabel")
			key.AnchorPoint = Vector2.new(1, 0)
			key.Position = UDim2.new(1, -8, 0, 0)
			key.Size = UDim2.new(0, 44, 1, 0)
			key.BackgroundTransparency = 1
			key.Font = Enum.Font.Gotham
			key.Text = ""
			key.TextColor3 = COLOR_OFF
			key.TextSize = 12
			key.TextXAlignment = Enum.TextXAlignment.Right
			key.Parent = frame

			return {name = name, key = key, state = "off", keyText = nil}
		end

		local STATE_COLORS = {on = COLOR_ON, wait = COLOR_WAIT, off = COLOR_OFF}
		local rowInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

		local function setRowState(r, state)
			if r.state == state then
				return
			end
			r.state = state
			local c = STATE_COLORS[state]
			TweenService:Create(r.name, rowInfo, {TextColor3 = c}):Play()
			TweenService:Create(r.key, rowInfo, {TextColor3 = c}):Play()
		end

		local scanTimer = 0
		local function updateList(dt)
			-- pick up modules that registered themselves
			for _, e in ipairs(lib.keybindEntries or {}) do
				addEntry(e)
			end
			-- fallback scan, about 5 times per second
			scanTimer += dt
			if scanTimer >= 0.2 then
				scanTimer = 0
				scanPages()
			end

			for i, entry in ipairs(entries) do
				local r = rows[i]
				if not r then
					r = makeRow(entry, i)
					rows[i] = r
				end

				local okE, enabled = pcall(entry.getEnabled)
				enabled = okE and enabled and true or false

				-- on and running = bright, on but waiting for its key = grey, off = dark
				local state = "off"
				if enabled then
					state = "on"
					if entry.getActive then
						local okA, a = pcall(entry.getActive)
						if okA and not a then
							state = "wait"
						end
					end
				end
				setRowState(r, state)

				-- the key is shown for every module, also while it is off
				local key = nil
				if entry.getKey then
					local okK, k = pcall(entry.getKey)
					key = okK and k or nil
				end
				if key ~= r.keyText then
					r.keyText = key
					r.key.Text = key and ("[" .. key .. "]") or ""
				end
			end

			listFrame.Visible = listWanted and #entries > 0

			-- the border brightens while the list can be moved (menu open)
			local movable = win.gui.Enabled
			if listFrame:GetAttribute("Movable") ~= movable then
				listFrame:SetAttribute("Movable", movable)
				TweenService:Create(listStroke, fadeInfo, {Color = movable and LIST_STROKE_MOVABLE or LIST_STROKE_IDLE}):Play()
			end
		end

		-- ---------- dragging (only while the main menu is open) ----------
		local dragging = false
		local dragMouse, dragPos, dragAbs

		local inputConn = listFrame.InputBegan:Connect(function(input)
			if not win.gui.Enabled then
				return -- menu hidden: the list is stuck
			end
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragMouse = UserInputService:GetMouseLocation()
				dragPos = listFrame.Position
				dragAbs = listFrame.AbsolutePosition
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end)

		local moveConn = UserInputService.InputChanged:Connect(function(input)
			if not dragging then
				return
			end
			if not win.gui.Enabled then
				dragging = false
				return
			end
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				local delta = UserInputService:GetMouseLocation() - dragMouse
				local screen, size = listGui.AbsoluteSize, listFrame.AbsoluteSize
				local loX, loY = -dragAbs.X, -dragAbs.Y
				local hiX = math.max(loX, screen.X - size.X - dragAbs.X)
				local hiY = math.max(loY, screen.Y - size.Y - dragAbs.Y)
				local dx = math.clamp(delta.X, loX, hiX)
				local dy = math.clamp(delta.Y, loY, hiY)
				listFrame.Position = UDim2.new(
					dragPos.X.Scale, dragPos.X.Offset + dx,
					dragPos.Y.Scale, dragPos.Y.Offset + dy
				)
			end
		end)

		-- keep the list on screen when the window is resized / the list grows at the bottom
		local function fitOnScreen()
			local p, s, screen = listFrame.AbsolutePosition, listFrame.AbsoluteSize, listGui.AbsoluteSize
			local dx = math.clamp(p.X, 0, math.max(0, screen.X - s.X)) - p.X
			local dy = math.clamp(p.Y, 0, math.max(0, screen.Y - s.Y)) - p.Y
			if dx ~= 0 or dy ~= 0 then
				listFrame.Position += UDim2.fromOffset(dx, dy)
			end
		end
		local sizeConn = listGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitOnScreen)
		local growConn = listFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			if not dragging then
				fitOnScreen()
			end
		end)

		local heartbeatConn = RunService.Heartbeat:Connect(updateList)

		win.onClose(function()
			heartbeatConn:Disconnect()
			inputConn:Disconnect()
			moveConn:Disconnect()
			sizeConn:Disconnect()
			growConn:Disconnect()
			beganConn:Disconnect()
			endedConn:Disconnect()
			listGui:Destroy()
		end)

		return {
			SetKeybindList = function(value)
				listWanted = value and true or false
			end,
		}
	end
end

					aiming = false
				end)
				addSlider(opts.group, 5, "Max distance", 50, 1000, cfg.MaximumDistance, "", function(v)
					cfg.MaximumDistance = v
				end)
				addSwitchRow(opts.group, 6, "Sticky aim", cfg.Sticky, function(v)
					cfg.Sticky = v
					releaseLock()
				end)
				opts.height += METHODS_H * 3 + KEY_H + SLIDER_H + SWITCH_H
				opts.setOpen(cfg.Enabled, false)
			end

			-- Prediction and Smoothness (one window, two switches; options open when on)
			do
				local card = newCard(scroll, nextOrder())

				local pOpts = newOptions(card, 2)
				addHeader(card, "Prediction", cfg.PredictionEnabled, function(v)
					cfg.PredictionEnabled = v
					pOpts.setOpen(v, true)
				end, 1)
				addSlider(pOpts.group, 1, "X axis", 1, 20, cfg.PredX, "", function(v)
					cfg.PredX = v
				end, function(on)
					graphPanel.Active("Prediction", on)
				end)
				addSlider(pOpts.group, 2, "Y axis", 1, 20, cfg.PredY, "", function(v)
					cfg.PredY = v
				end, function(on)
					graphPanel.Active("Prediction", on)
				end)
				pOpts.height += SLIDER_H * 2
				pOpts.setOpen(cfg.PredictionEnabled, false)

				addDivider(card, 3)

				local sOpts = newOptions(card, 5)
				addHeader(card, "Smoothness", cfg.SmoothEnabled, function(v)
					cfg.SmoothEnabled = v
					sOpts.setOpen(v, true)
				end, 4)
				addSlider(sOpts.group, 1, "X axis", 1, 100, cfg.SmoothX, "", function(v)
					cfg.SmoothX = v
				end, function(on)
					graphPanel.Active("Smoothness", on)
				end)
				addSlider(sOpts.group, 2, "Y axis", 1, 100, cfg.SmoothY, "", function(v)
					cfg.SmoothY = v
				end, function(on)
					graphPanel.Active("Smoothness", on)
				end)
				sOpts.height += SLIDER_H * 2
				sOpts.setOpen(cfg.SmoothEnabled, false)
			end

			-- Checks (team + raycast visible check, one window)
			do
				local card = newCard(scroll, nextOrder())
				addTitle(card, "Checks")
				local body = Instance.new("Frame")
				body.LayoutOrder = 2
				body.BackgroundTransparency = 1
				body.Size = UDim2.new(1, 0, 0, 0)
				body.AutomaticSize = Enum.AutomaticSize.Y
				body.Parent = card
				local bl = Instance.new("UIListLayout")
				bl.SortOrder = Enum.SortOrder.LayoutOrder
				bl.Parent = body

				addDivider(body, 0)
				addSwitchRow(body, 1, "Team check", cfg.TeamCheck, function(v)
					cfg.TeamCheck = v
				end)
				addSwitchRow(body, 2, "Visible check (raycast)", cfg.VisibleCheck, function(v)
					cfg.VisibleCheck = v
				end)
				addSwitchRow(body, 3, "Ignore transparent parts", cfg.IgnoreTransparency, function(v)
					cfg.IgnoreTransparency = v
				end)
			end
		end

		-- ====================================================
		-- Trigger page
		-- ====================================================
		do
			local scroll = newScroll(subPages.Trigger)
			local card = newCard(scroll, 1)
			local opts = newOptions(card, 2)
			addHeader(card, "Trigger bot", trig.Enabled, function(v)
				trig.Enabled = v
				trigOn, trigHeld = false, false
				opts.setOpen(v, true)
			end)
			addSegmented(opts.group, 1, {"Hold", "Toggle"}, trig.Mode, function(name)
				trig.Mode = name
				trigOn, trigHeld = false, false
			end)
			addKeyRow(opts.group, 2, "Trigger key", trig.Keybind, function(name)
				trig.Keybind = name
				trigOn, trigHeld = false, false
			end)
			addSlider(opts.group, 3, "Delay", 0, 500, trig.Delay, " ms", function(v)
				trig.Delay = v
			end)
			addSlider(opts.group, 4, "Clicks per second", 1, 37, trig.ClicksPerSecond, "", function(v)
				trig.ClicksPerSecond = v
			end)
			addSlider(opts.group, 5, "Hitbox multiplier", 1, 10, trig.HitboxMult, "x", function(v)
				trig.HitboxMult = v
			end)
			addSwitchRow(opts.group, 6, "Team check", trig.TeamCheck, function(v)
				trig.TeamCheck = v
			end)
			addSwitchRow(opts.group, 7, "Visible check", trig.VisibleCheck, function(v)
				trig.VisibleCheck = v
			end)
			opts.height += METHODS_H + KEY_H + SLIDER_H * 3 + SWITCH_H * 2
			opts.setOpen(trig.Enabled, false)
		end

		-- ====================================================
		-- cleanup
		-- ====================================================
		local function destroy()
			if destroyed then
				return
			end
			destroyed = true
			cfg.Enabled = false
			trig.Enabled = false
			graphPanel.Destroy()
			for _, conn in ipairs(connections) do
				conn:Disconnect()
			end
			table.clear(connections)
		end
		win.onClose(destroy)

		selectSub(SUBTABS[1], false)

		return {
			Pages = subPages,
			Config = cfg,
			Select = function(name)
				if table.find(SUBTABS, name) then
					selectSub(name, true)
				end
			end,
			Current = function()
				return current
			end,
			Destroy = destroy,
		}
	end
end

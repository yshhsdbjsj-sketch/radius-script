			hexPad.PaddingLeft = UDim.new(0, 10)
			hexPad.Parent = hexBox

			function P.Refresh()
				local sl = P.slot
				if not sl then
					return
				end
				local c = colorOf(sl)
				svFrame.BackgroundColor3 = Color3.fromHSV(sl.h, 1, 1)
				svCursor.Position = UDim2.fromScale(sl.s, 1 - sl.v)
				hueCursor.Position = UDim2.fromScale(0.5, sl.h)
				swatch.BackgroundColor3 = c
				swatch.BackgroundTransparency = withAlpha and (1 - sl.a) or 0
				if alphaFill then
					alphaFill.BackgroundColor3 = c
					alphaCursor.Position = UDim2.fromScale(0.5, 1 - sl.a)
				end
				if not hexFocused then
					hexBox.Text = toHex(c)
				end
			end

			function P.Changed()
				P.Refresh()
				onChange()
			end

			function P.Bind(slot)
				P.slot = slot
				P.Refresh()
			end

			hexBox.Focused:Connect(function()
				hexFocused = true
				TweenService:Create(hexStroke, fadeInfo, {Color = Color3.fromRGB(95, 95, 104)}):Play()
			end)
			hexBox.FocusLost:Connect(function()
				hexFocused = false
				TweenService:Create(hexStroke, fadeInfo, {Color = FIELD_STROKE}):Play()
				local r, g, b = hexBox.Text:match("^#?(%x%x)(%x%x)(%x%x)$")
				if r and P.slot then
					local hh, ss, vv = rgbToHsv(Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16)))
					P.slot.h, P.slot.s, P.slot.v = math.min(hh, 0.999), ss, vv
					onChange()
				end
				P.Refresh()
				if P.slot then
					hexBox.Text = toHex(colorOf(P.slot))
				end
			end)

			bindDrag(svHit, function(m)
				if not P.slot then
					return
				end
				local ap, as = svHit.AbsolutePosition, svHit.AbsoluteSize
				P.slot.s = math.clamp((m.X - ap.X) / as.X, 0, 1)
				P.slot.v = 1 - math.clamp((m.Y - ap.Y) / as.Y, 0, 1)
				P.Changed()
			end)
			bindDrag(hueHit, function(m)
				if not P.slot then
					return
				end
				local ap, as = hueHit.AbsolutePosition, hueHit.AbsoluteSize
				P.slot.h = math.clamp((m.Y - ap.Y) / as.Y, 0, 0.999)
				P.Changed()
			end)
			if alphaHit then
				bindDrag(alphaHit, function(m)
					if not P.slot then
						return
					end
					local ap, as = alphaHit.AbsolutePosition, alphaHit.AbsoluteSize
					P.slot.a = 1 - math.clamp((m.Y - ap.Y) / as.Y, 0, 1)
					P.Changed()
				end)
			end

			return P
		end


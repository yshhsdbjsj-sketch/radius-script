		local function inside(pos, hit)
			local ap, as = hit.AbsolutePosition, hit.AbsoluteSize
			return pos.X >= ap.X - 1 and pos.X <= ap.X + as.X + 1 and pos.Y >= ap.Y - 1 and pos.Y <= ap.Y + as.Y + 1
		end

		local function calibrate(input, hit)
			local base = UserInputService:GetMouseLocation()
			local inset = Vector2.new(0, 0)
			pcall(function() inset = GuiService:GetGuiInset() end)
			local ip = Vector2.new(input.Position.X, input.Position.Y)
			local candidates = {base, ip, ip + inset, base - inset}
			calib = Vector2.new(0, 0)
			for _, c in ipairs(candidates) do
				if inside(c, hit) then
					calib = c - base
					return
				end
			end
		end


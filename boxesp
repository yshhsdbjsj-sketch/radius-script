		-- ---------- show / hide / switch the settings window ----------
		local settingsShown = false
		local shownKey = nil
		local curH = 150

		local function updateSettings()
			local wanted = master and selected ~= nil and page.Visible

			if wanted and selected ~= shownKey then
				if shownKey then
					panels[shownKey].frame.Visible = false
				end
				shownKey = selected
				panels[shownKey].frame.Visible = true
				curH = panels[shownKey].height
				settings.Size = UDim2.new(1, 0, 0, curH)
			end

			if wanted ~= settingsShown then
				settingsShown = wanted
				if wanted then
					settings.Visible = true
					TweenService:Create(settingsScale, slideInfo, {Scale = 1}):Play()
				else
					local out = TweenService:Create(settingsScale, fadeInfo, {Scale = 0.92})
					out.Completed:Connect(function()
						if not settingsShown then
							settings.Visible = false
						end
					end)
					out:Play()
				end
			end

			-- sit under the window, or flip above it if the screen has no room
			if settings.Visible then
				local p, sz = win.frame.AbsolutePosition, win.frame.AbsoluteSize
				local below = p.Y + sz.Y + SET_GAP + curH <= win.gui.AbsoluteSize.Y
				settings.Position = below
					and UDim2.new(0.5, 0, 1, SET_GAP + curH / 2)
					or UDim2.new(0.5, 0, 0, -(SET_GAP + curH / 2))
			end
		end

		-- ====================================================
		-- name / health helpers (shared by preview and real ESP)
		-- ====================================================
		local function nameText(player, dist)
			local t
			if nameSource == "Username" then
				t = player.Name
			elseif nameSource == "Both" then
				t = (player.DisplayName ~= player.Name) and (player.DisplayName .. " (@" .. player.Name .. ")") or player.Name
			else
				t = player.DisplayName
			end
			if nameDist then
				t = t .. " [" .. math.floor(dist + 0.5) .. "]"
			end
			return t
		end

		local function healthFrac(hum)
			local mh = hum.MaxHealth
			if mh <= 0 then
				return 0
			end
			return math.clamp(hum.Health / mh, 0, 1)
		end

		-- t: 0 = low, 0.5 = mid, 1 = full
		local function healthColor(t)
			local lo, mid, hi = colorOf(slots.hpLow), colorOf(slots.hpMid), colorOf(slots.hpFull)
			if t < 0.5 then
				return lo:Lerp(mid, t * 2)
			end
			return mid:Lerp(hi, (t - 0.5) * 2)
		end

		-- rectangles of the health bar, filled from `bnd` (call computeBounds first)
		local hpRects = {}
		for i = 1, HP_SEGS do
			hpRects[i] = {0, 0, 0, 0, Color3.new(1, 1, 1)}
		end
		local hpBg = {0, 0, 0, 0}

		-- returns how many fill rectangles to draw; also fills hpBg
		local function computeHealth(frac)
			local top = math.floor(bnd.minY - PAD)
			local bottom = math.floor(bnd.maxY + PAD)
			local H = bottom - top
			local w = HP_W
			local x = math.floor(bnd.minX - PAD - 3 - w)
			hpBg[1], hpBg[2], hpBg[3], hpBg[4] = x - 1, top - 1, w + 2, H + 2
			if frac <= 0 then
				return 0
			end
			if hpMode == "Solid" then
				local r = hpRects[1]
				r[1], r[2], r[3], r[4], r[5] = x, bottom - H * frac, w, H * frac, healthColor(frac)
				return 1
			end
			local n = 0
			for i = 0, HP_SEGS - 1 do
				local f0, f1 = i / HP_SEGS, (i + 1) / HP_SEGS
				if frac > f0 then
					local topF = math.min(f1, frac)
					n = n + 1
					local r = hpRects[n]
					r[1], r[2], r[3], r[4], r[5] = x, bottom - topF * H, w, (topF - f0) * H, healthColor((f0 + f1) / 2)
				end
			end
			return n
		end

		-- ====================================================
		-- preview on the 3D avatar render (GUI objects inside the viewport)
		-- ====================================================
		local previewViewport
		local prevBox, prevSkel, prevHp = {}, {}, {}
		local prevName

		local function findViewport()
			if previewViewport and previewViewport.Parent then
				return previewViewport
			end
			previewViewport = popup and popup:FindFirstChildWhichIsA("ViewportFrame", true) or nil
			return previewViewport
		end

		local function getFrame(pool, i, name)
			local f = pool[i]
			if not f then
				f = Instance.new("Frame")
				f.Name = name
				f.BorderSizePixel = 0
				f.Active = false
				f.ZIndex = 20
				f.Visible = false
				pool[i] = f
			end
			if f.Parent ~= previewViewport then
				f.Parent = previewViewport
			end
			return f
		end

		local function hidePool(pool)
			for _, f in ipairs(pool) do
				f.Visible = false
			end
		end

		local function hidePreview()
			hidePool(prevBox)
			hidePool(prevSkel)
			hidePool(prevHp)
			if prevName then
				prevName.Visible = false
			end
		end

		local function drawLinePool(pool, count, list, slot, thick)
			local c = colorOf(slot)
			for i = 1, count do
				local l = getFrame(pool, i, "EspLine")
				local sg = list[i]
				local dx, dy = sg[3] - sg[1], sg[4] - sg[2]
				local len = math.sqrt(dx * dx + dy * dy)
				l.AnchorPoint = Vector2.new(0.5, 0.5)
				l.BackgroundColor3 = c
				l.BackgroundTransparency = 1 - slot.a
				l.Position = UDim2.fromOffset((sg[1] + sg[3]) / 2, (sg[2] + sg[4]) / 2)
				l.Size = UDim2.fromOffset(len + thick, thick)
				l.Rotation = math.deg(math.atan2(dy, dx))
				l.Visible = true
			end
			for i = count + 1, #pool do
				pool[i].Visible = false
			end
		end

		local function drawHealthPreview(count)
			-- pool[1] = background, pool[2..] = fill rectangles
			local bg = getFrame(prevHp, 1, "EspHpBg")
			bg.AnchorPoint = Vector2.new(0, 0)
			bg.Rotation = 0
			bg.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
			bg.BackgroundTransparency = 0.3
			bg.Position = UDim2.fromOffset(hpBg[1], hpBg[2])
			bg.Size = UDim2.fromOffset(hpBg[3], hpBg[4])
			bg.Visible = true
			for i = 1, count do
				local r = hpRects[i]
				local f = getFrame(prevHp, i + 1, "EspHpFill")
				f.AnchorPoint = Vector2.new(0, 0)
				f.Rotation = 0
				f.BackgroundColor3 = r[5]
				f.BackgroundTransparency = 0
				f.Position = UDim2.fromOffset(r[1], r[2])
				f.Size = UDim2.fromOffset(r[3], r[4])
				f.Visible = true
			end
			for i = count + 2, #prevHp do
				prevHp[i].Visible = false
			end
		end

		local function drawNamePreview()
			if not prevName then
				prevName = Instance.new("TextLabel")
				prevName.Name = "EspName"
				prevName.BackgroundTransparency = 1
				prevName.AnchorPoint = Vector2.new(0.5, 1)
				prevName.Size = UDim2.fromOffset(220, 14)
				prevName.Font = Enum.Font.GothamMedium
				prevName.TextSize = 12
				prevName.TextStrokeTransparency = 0.5
				prevName.ZIndex = 20
				prevName.Visible = false
			end
			if prevName.Parent ~= previewViewport then
				prevName.Parent = previewViewport
			end
			prevName.Text = nameText(LocalPlayer, 25)
			prevName.TextColor3 = colorOf(slots.name)
			prevName.TextTransparency = 1 - slots.name.a
			prevName.Position = UDim2.fromOffset((bnd.minX + bnd.maxX) / 2, bnd.minY - PAD - 2)
			prevName.Visible = true
		end

		local function updatePreview()
			local viewport = findViewport()
			if not (master and anyOn() and popup and popup.Visible and viewport) then
				hidePreview()
				return
			end
			local camera = viewport.CurrentCamera
			local model = viewport:FindFirstChildOfClass("Model")
			if not (camera and model) then
				hidePreview()
				return
			end
			local uiScale = popup:FindFirstChildOfClass("UIScale")
			local vpSize = viewport.AbsoluteSize / (uiScale and uiScale.Scale or 1)
			if vpSize.X < 1 or vpSize.Y < 1 then
				hidePreview()
				return
			end

			local project = makeProjector(camera, vpSize)
			local needBounds = feat.Name or feat.Health or (feat.Box and style ~= "3D")
			local hasB = needBounds and computeBounds(model, project)

			-- box
			local n = feat.Box and computeBox(model, project, style, hasB) or 0
			drawLinePool(prevBox, n, segs, slots.box, THICKNESS)

			-- skeleton
			n = feat.Skeleton and computeSkeleton(model, project) or 0
			drawLinePool(prevSkel, n, bones, slots.skel, skelThick)

			-- health bar (the preview health slowly moves up and down so the colors are visible)
			if feat.Health and hasB then
				drawHealthPreview(computeHealth(0.575 + 0.425 * math.sin(os.clock() * 0.9)))
			else
				hidePool(prevHp)
			end

			-- name
			if feat.Name and hasB then
				drawNamePreview()
			elseif prevName then
				prevName.Visible = false
			end
		end

		-- ====================================================
		-- real ESP (only while the menu is hidden)
		-- ====================================================
		local records = {} -- [player] = {...drawing objects...}

		local function newLine()
			local l = Drawing.new("Line")
			l.Visible = false
			return l
		end

		local function newSquare()
			local sq = Drawing.new("Square")
			sq.Filled = true
			sq.Thickness = 1
			sq.Visible = false
			return sq
		end

		local function newRecord()
			return {
				box = {}, boxShown = 0,
				skel = {}, skelShown = 0,
				hp = {}, hpShown = 0, hpBg = nil, hpBgShown = false,
				name = nil, nameShown = false,
			}
		end

		local function removeRecord(player)
			local rec = records[player]
			if not rec then
				return
			end
			local function kill(obj)
				pcall(function() obj:Remove() end)
			end
			for _, l in ipairs(rec.box) do kill(l) end
			for _, l in ipairs(rec.skel) do kill(l) end
			for _, sq in ipairs(rec.hp) do kill(sq) end
			if rec.hpBg then kill(rec.hpBg) end
			if rec.name then kill(rec.name) end
			records[player] = nil
		end

		local function hideRecord(rec)
			for i = 1, rec.boxShown do rec.box[i].Visible = false end
			rec.boxShown = 0
			for i = 1, rec.skelShown do rec.skel[i].Visible = false end
			rec.skelShown = 0
			for i = 1, rec.hpShown do rec.hp[i].Visible = false end
			rec.hpShown = 0
			if rec.hpBg then rec.hpBg.Visible = false end
			rec.hpBgShown = false
			if rec.name then rec.name.Visible = false end
			rec.nameShown = false
		end

		local function hideAll()
			for _, rec in pairs(records) do
				hideRecord(rec)
			end
		end

		-- draws `count` segments from `src` on the line list, hides the rest, returns count
		local function setLines(list, prevShown, count, src, slot, thick)
			while #list < count do
				table.insert(list, newLine())
			end
			local c, a = colorOf(slot), dAlpha(slot.a)
			for i = 1, count do
				local sg, l = src[i], list[i]
				l.Color = c
				l.Transparency = a
				l.Thickness = thick
				l.From = Vector2.new(sg[1], sg[2])
				l.To = Vector2.new(sg[3], sg[4])
				l.Visible = true
			end
			for i = count + 1, prevShown do
				list[i].Visible = false
			end
			return count
		end

		-- draws `count` health rectangles (hpRects), hides the rest, returns count
		local function setSquares(list, prevShown, count)
			while #list < count do
				table.insert(list, newSquare())
			end
			for i = 1, count do
				local r, sq = hpRects[i], list[i]
				sq.Position = Vector2.new(r[1], r[2])
				sq.Size = Vector2.new(r[3], r[4])
				sq.Color = r[5]
				sq.Transparency = dAlpha(1)
				sq.Visible = true
			end
			for i = count + 1, prevShown do
				list[i].Visible = false
			end
			return count
		end

		local function updatePlayer(player, camera, project, camPos)
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local rec = records[player]

			local pass = char ~= nil and hum ~= nil and root ~= nil and hum.Health > 0
			local dist = 0
			if pass then
				dist = (root.Position - camPos).Magnitude
				if teamCheck and sameTeam(player) then
					pass = false
				elseif dist > renderDist then
					pass = false
				elseif visCheck and not isVisible(char, camera) then
					pass = false
				end
			end
			if not pass then
				if rec then
					hideRecord(rec)
				end
				return
			end

			if not rec then
				rec = newRecord()
				records[player] = rec
			end

			local needBounds = feat.Name or feat.Health or (feat.Box and style ~= "3D")
			local hasB = needBounds and computeBounds(char, project)

			-- box
			local n = feat.Box and computeBox(char, project, style, hasB) or 0
			rec.boxShown = setLines(rec.box, rec.boxShown, n, segs, slots.box, THICKNESS)

			-- skeleton
			n = feat.Skeleton and computeSkeleton(char, project) or 0
			rec.skelShown = setLines(rec.skel, rec.skelShown, n, bones, slots.skel, skelThick)

			-- health bar
			if feat.Health and hasB then
				n = computeHealth(healthFrac(hum))
				if not rec.hpBg then
					rec.hpBg = newSquare()
					rec.hpBg.Color = Color3.fromRGB(10, 10, 12)
					rec.hpBg.Transparency = dAlpha(0.7)
				end
				rec.hpBg.Position = Vector2.new(hpBg[1], hpBg[2])
				rec.hpBg.Size = Vector2.new(hpBg[3], hpBg[4])
				rec.hpBg.Visible = true
				rec.hpBgShown = true
				rec.hpShown = setSquares(rec.hp, rec.hpShown, n)
			else
				for i = 1, rec.hpShown do rec.hp[i].Visible = false end
				rec.hpShown = 0
				if rec.hpBg and rec.hpBgShown then
					rec.hpBg.Visible = false
					rec.hpBgShown = false
				end
			end

			-- name
			if feat.Name and hasB then
				if not rec.name then
					local t = Drawing.new("Text")
					t.Size = 13
					t.Center = true
					t.Outline = true
					t.Visible = false
					rec.name = t
				end
				local t = rec.name
				t.Text = nameText(player, dist)
				t.Color = colorOf(slots.name)
				t.Transparency = dAlpha(slots.name.a)
				t.Position = Vector2.new((bnd.minX + bnd.maxX) / 2, bnd.minY - PAD - 16)
				t.Visible = true
				rec.nameShown = true
			elseif rec.name and rec.nameShown then
				rec.name.Visible = false
				rec.nameShown = false
			end
		end

		local wasActive = false
		local function updateEsp()
			-- master off, no feature on, or menu open -> nothing on the real players
			local active = hasDrawing and master and anyOn() and win.gui.Parent ~= nil and not win.gui.Enabled
			if not active then
				if wasActive then
					hideAll()
					wasActive = false
				end
				return
			end
			wasActive = true

			local camera = workspace.CurrentCamera
			if not camera then
				return
			end
			local project = makeProjector(camera)
			local camPos = camera.CFrame.Position
			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer then
					updatePlayer(player, camera, project, camPos)
				end
			end
		end

		local renderConn = RunService.RenderStepped:Connect(function()
			refreshLocks()
			updateSettings()
			updatePreview()
			updateEsp()
		end)
		local removingConn = Players.PlayerRemoving:Connect(removeRecord)

		local function destroy()
			renderConn:Disconnect()
			removingConn:Disconnect()
			moveConn:Disconnect()
			endConn:Disconnect()
			for player in pairs(records) do
				removeRecord(player)
			end
			for _, pool in ipairs({prevBox, prevSkel, prevHp}) do
				for _, f in ipairs(pool) do
					f:Destroy()
				end
			end
			if prevName then
				prevName:Destroy()
			end
			settings:Destroy()
			scroll:Destroy()
		end
		win.onClose(destroy)

		-- ====================================================
		-- API
		-- ====================================================
		return {
			SetMaster = function(value)
				masterSwitch.Set(value)
			end,
			-- Box Esp switch (kept for backwards compatibility)
			SetEnabled = function(value)
				featSwitch.Box.Set(value)
			end,
			SetBoxEsp = function(value)
				featSwitch.Box.Set(value)
			end,
			SetNameEsp = function(value)
				featSwitch.Name.Set(value)
			end,
			SetHealthEsp = function(value)
				featSwitch.Health.Set(value)
			end,
			SetSkeletonEsp = function(value)
				featSwitch.Skeleton.Set(value)
			end,
			IsEnabled = function()
				return master and anyOn()
			end,
			SetTeamCheck = function(value)
				teamSwitch.Set(value)
			end,
			SetVisibleCheck = function(value)
				visSwitch.Set(value)
			end,
			SetRenderDistance = function(studs)
				setDistance(math.floor(studs / DIST_STEP + 0.5) * DIST_STEP)
			end,

			-- box
			SetStyle = function(name)
				if indexOf(STYLES, name) then
					styleChoice.Set(name)
				end
			end,
			SetColor = function(c) -- box color
				local hh, ss, vv = rgbToHsv(c)
				slots.box.h, slots.box.s, slots.box.v = math.min(hh, 0.999), ss, vv
				refreshAllPickers()
			end,
			SetAlpha = function(a) -- box alpha
				slots.box.a = math.clamp(a, 0, 1)
				refreshAllPickers()
			end,

			-- name
			SetNameSource = function(name) -- "Display" / "Username" / "Both"
				if indexOf(NAME_SOURCES, name) then
					sourceChoice.Set(name)
				end
			end,
			SetNameDistance = function(value)
				nameDistChoice.Set(value and "On" or "Off")
			end,
			SetNameColor = function(c)
				local hh, ss, vv = rgbToHsv(c)
				slots.name.h, slots.name.s, slots.name.v = math.min(hh, 0.999), ss, vv
				refreshAllPickers()
			end,

			-- health bar
			SetHealthMode = function(name) -- "Solid" / "Gradient"
				if name == "Solid" or name == "Gradient" then
					hpModeChoice.Set(name)
				end
			end,
			SetHealthColors = function(full, mid, low)
				for key, c in pairs({hpFull = full, hpMid = mid, hpLow = low}) do
					local hh, ss, vv = rgbToHsv(c)
					slots[key].h, slots[key].s, slots[key].v = math.min(hh, 0.999), ss, vv
				end
				refreshAllPickers()
			end,

			-- skeleton
			SetSkeletonColor = function(c)
				local hh, ss, vv = rgbToHsv(c)
				slots.skel.h, slots.skel.s, slots.skel.v = math.min(hh, 0.999), ss, vv
				refreshAllPickers()
			end,
			SetSkeletonThickness = function(name) -- "Thin" / "Normal" / "Thick"
				if THICKNESSES[name] then
					thickChoice.Set(name)
				end
			end,

			Destroy = destroy,
		}
	end
end

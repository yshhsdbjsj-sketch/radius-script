		-- gradient box fill: one frame + a UIGradient (colors and opacity)
		local function drawFillPreview(c1, a1, c2, a2)
			local f = getFrame(prevFill, 1, "EspFill", 18)
			f.AnchorPoint = Vector2.new(0, 0)
			f.Rotation = 0
			f.BackgroundColor3 = Color3.new(1, 1, 1)
			f.BackgroundTransparency = 0
			f.Position = UDim2.fromOffset(bnd.minX - PAD, bnd.minY - PAD)
			f.Size = UDim2.fromOffset(bnd.maxX - bnd.minX + PAD * 2, bnd.maxY - bnd.minY + PAD * 2)
			local g = f:FindFirstChildOfClass("UIGradient")
			if not g then
				g = Instance.new("UIGradient")
				g.Rotation = 90
				g.Parent = f
			end
			local mode = opt.fillMode
			if mode == "Fade Down" then
				g.Color = ColorSequence.new(c1)
				g.Transparency = NumberSequence.new(1 - a1, 1)
			elseif mode == "Fade Up" then
				g.Color = ColorSequence.new(c1)
				g.Transparency = NumberSequence.new(1, 1 - a1)
			elseif mode == "Two-tone" then
				g.Color = ColorSequence.new(c1, c2)
				g.Transparency = NumberSequence.new(1 - a1, 1 - a2)
			else
				g.Color = ColorSequence.new(c1)
				g.Transparency = NumberSequence.new(1 - a1)
			end
			f.Visible = true
		end

		local function easeOut(t)
			return 1 - (1 - t) * (1 - t) * (1 - t)
		end

		local function updatePreview()
			local viewport = findViewport()
			if not (master and anyOn() and popup and popup.Visible and viewport) then
				hidePreview()
				return
			end
			local camera = viewport.CurrentCamera
			local model = viewport:FindFirstChildOfClass("Model")
			if not (camera and model) then
				hidePreview()
				return
			end
			local uiScale = popup:FindFirstChildOfClass("UIScale")
			local vpSize = viewport.AbsoluteSize / (uiScale and uiScale.Scale or 1)
			if vpSize.X < 1 or vpSize.Y < 1 then
				hidePreview()
				return
			end

			local now = os.clock()
			local project = makeProjector(camera, vpSize)
			local hasB = (needsBounds() or feat.LookDir) and computeBounds(model, project)
			local cx = (bnd.minX + bnd.maxX) / 2

			-- visibility colors: the preview flips between "visible" and "hidden" so both can be seen
			if feat.VisColors then
				curVis = math.floor(now / 2.2) % 2 == 0
			else
				curVis = nil
			end

			-- demo health: a few hits, then a heal (also drives the ghost bar and the damage numbers)
			local ps = prevHpState
			if now >= ps.nextHit then
				local before = ps.target
				if ps.target > 0.35 then
					ps.target = math.max(0.12, ps.target - (0.2 + 0.18 * math.random()))
				else
					ps.target = 1
				end
				ps.nextHit = now + 1.7
				local delta = math.floor((before - ps.target) * 100 + 0.5)
				if delta ~= 0 and (delta > 0 or opt.dmgHeals == "On") then
					table.insert(prevDmg, {t0 = now, amt = math.abs(delta), heal = delta < 0, dx = math.random(-12, 12)})
					if #prevDmg > 3 then
						table.remove(prevDmg, 1)
					end
				end
			end
			ps.shown = approach(ps.shown, ps.target, frameDt, 7, 0.002)
			local frac = math.clamp(ps.shown, 0.05, 1)

			if feat.BoxFill and hasB then
				local c1 = colorFor(slots.fill, nil, true)
				local c2 = colorOverridden() and c1:Lerp(Color3.new(0, 0, 0), 0.55) or colorOf(slots.fill2)
				drawFillPreview(c1, slots.fill.a, c2, slots.fill2.a)
			else
				hidePool(prevFill)
			end

			local n = feat.Box and computeBox(model, project, opt.style, hasB) or 0
			if feat.Box and opt.boxOutline == "On" then
				drawLinePool(prevBoxOut, n, segs, OUTLINE_COLOR, 0.8, THICKNESS + 2, 19)
			else
				hidePool(prevBoxOut)
			end
			drawLinePool(prevBox, n, segs, colorFor(slots.box, nil, true), slots.box.a, THICKNESS)

			local jn = 0
			n = 0
			if feat.Skeleton then
				n, jn = computeSkeleton(model, project, opt.joints == "On")
			end
			local skelC = colorFor(slots.skel, nil, true)
			drawLinePool(prevSkel, n, bones, skelC, slots.skel.a, opt.skelThick)
			drawJointPreview(jn, skelC, slots.skel.a, 1.5 + opt.skelThick)

			n = feat.LookDir and computeLook(model, project, opt.lookLen) or 0
			if n > 0 and hasB then
				-- keep the line inside the avatar instead of poking out over the render
				local sg = lookSeg[1]
				local x0, y0, x1, y1 = bnd.minX + 2, bnd.minY + 2, bnd.maxX - 2, bnd.maxY - 2
				local sx, sy = sg[1], sg[2]
				local dx, dy = sg[3] - sx, sg[4] - sy
				local t = 1
				if dx > 0 and sx + dx > x1 then
					t = math.min(t, (x1 - sx) / dx)
				elseif dx < 0 and sx + dx < x0 then
					t = math.min(t, (x0 - sx) / dx)
				end
				if dy > 0 and sy + dy > y1 then
					t = math.min(t, (y1 - sy) / dy)
				elseif dy < 0 and sy + dy < y0 then
					t = math.min(t, (y0 - sy) / dy)
				end
				t = math.max(t, 0)
				sg[3], sg[4] = sx + dx * t, sy + dy * t
			end
			drawLinePool(prevLook, n, lookSeg, colorFor(slots.look, nil, true), slots.look.a, 1.5)

			-- velocity line: the avatar "runs" to the right, speed pulses
			n = 0
			if feat.VelLine then
				local rootPart = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
				if rootPart then
					local rv = camera.CFrame.RightVector
					local dir = Vector3.new(rv.X, 0, rv.Z)
					if dir.Magnitude > 0.01 then
						local speed = 22 + 10 * math.sin(now * 1.3)
						n = computeVelocity(rootPart.Position, dir.Unit * speed, project, math.min(opt.velLen, 4.5), opt.velArrow == "On")
					end
				end
			end
			drawLinePool(prevVel, n, velSeg, colorOf(slots.vel), slots.vel.a, 2)

			if feat.HeadDot then
				local hx, hy, hr = computeHead(model, project)
				if hx then
					showDotPreview(hx, hy, hr, colorFor(slots.head, nil, true), slots.head.a, opt.headStyle == "Filled")
				else
					hideDotPreview()
				end
			else
				hideDotPreview()
			end

			n = 0
			if feat.Tracers then
				local ox, oy = tracerOrigin(vpSize.X, vpSize.Y, nil)
				n = computeTracer(model, project, ox, oy)
			end
			drawLinePool(prevTrc, n, tracerSeg, colorFor(slots.trc, nil, true), slots.trc.a, 1)

			-- armor first: it sits next to the health bar (or in its place)
			local armBarOn = feat.Armor and hasB
			local armFrac = 0.6 + 0.4 * math.sin(now * 0.7 + 1.5)
			local armN = 0
			if (feat.Armor or feat.ArmorText) and hasB then
				armN = computeArmor(armFrac)
			end
			drawBarPreview(prevArmor, armBg, armRects, armN, armBarOn)

			local hpTextW = 0
			if (feat.Health or feat.HealthText) and hasB then
				drawBarPreview(prevHp, hpBg, hpRects, computeHealth(frac), feat.Health)
				if feat.Health and opt.hpGhost == "On" then
					local gf = stepGhost(prevGhostState, frac, frameDt)
					if gf - frac > 0.004 then
						computeGhost(frac, gf)
						drawGhostPreview(true)
					else
						drawGhostPreview(false)
					end
				else
					drawGhostPreview(false)
				end
				if feat.HealthText then
					local str = (opt.hpFormat == "Percent") and (math.floor(frac * 100 + 0.5) .. "%") or tostring(math.floor(frac * 100 + 0.5))
					hpTextW = #str * 6.5
					local edge = armBarOn and armInfo.x or hpInfo.x
					showPreviewText("hpText", str, edge - 3, hpInfo.y, 1, 0.5, colorOf(slots.hpText), slots.hpText.a, opt.font)
				else
					hidePreviewText("hpText")
				end
			else
				hidePool(prevHp)
				drawGhostPreview(false)
				hidePreviewText("hpText")
			end

			if feat.ArmorText and hasB then
				local str = (opt.armFormat == "Percent") and (math.floor(armFrac * 100 + 0.5) .. "%") or tostring(math.floor(armFrac * ARMOR_MAX + 0.5))
				local ax = armInfo.x - 3 - ((hpTextW > 0) and (hpTextW + 4) or 0)
				showPreviewText("armText", str, ax, armInfo.y, 1, 0.5, colorOf(slots.armText), slots.armText.a, opt.font)
			else
				hidePreviewText("armText")
			end

			if feat.Name and hasB then
				local str = nameText(LocalPlayer)
				if distanceOnName() then
					str = str .. " " .. distanceText(25)
				end
				showPreviewText("name", str, cx, bnd.minY - PAD - 2, 0.5, 1, colorFor(slots.name, nil), slots.name.a, opt.font)
			else
				hidePreviewText("name")
			end

			-- status: top right, cycles through the four words
			if feat.Status and hasB then
				local word, a = stepStatus(prevStatus, STATUS_LIST[math.floor(now / 1.6) % #STATUS_LIST + 1], frameDt)
				showPreviewText("status", word, bnd.maxX + PAD + 4, bnd.minY - PAD, 0, 0, STATUS_COLOR, a, opt.font)
			else
				hidePreviewText("status")
			end

			local by = bnd.maxY + PAD + 2
			if feat.Weapon and hasB then
				showPreviewText("weapon", "Weapon", cx, by, 0.5, 0, colorFor(slots.weapon, nil), slots.weapon.a, opt.font)
				by = by + LINE_H
			else
				hidePreviewText("weapon")
			end
			if feat.Distance and not distanceOnName() and hasB then
				showPreviewText("dist", distanceText(25), cx, by, 0.5, 0, colorFor(slots.dist, nil), slots.dist.a, opt.font)
			else
				hidePreviewText("dist")
			end

			-- damage numbers: float up from the head when the demo health changes
			local dur = DMG_DUR[opt.dmgSpeed] or 1.1
			for i = #prevDmg, 1, -1 do
				if now - prevDmg[i].t0 > dur then
					table.remove(prevDmg, i)
				end
			end
			local hx, hy, hr
			if feat.Damage then
				hx, hy, hr = computeHead(model, project)
			end
			for i = 1, 3 do
				local p = prevDmg[i]
				if hx and p then
					local age = (now - p.t0) / dur
					local opacity = age < 0.55 and 1 or math.clamp(1 - (age - 0.55) / 0.45, 0, 1)
					local size = (11 + math.min(p.amt / 10, 5)) * (1 + 0.4 * math.max(0, 1 - age * 4))
					local c = p.heal and colorOf(slots.heal) or colorOf(slots.dmg)
					showPreviewText("dmg" .. i, (p.heal and "+" or "-") .. p.amt, hx + p.dx, hy - hr * 2.2 - easeOut(age) * 30, 0.5, 0.5, c, opacity, opt.font, size)
				else
					hidePreviewText("dmg" .. i)
				end
			end
		end


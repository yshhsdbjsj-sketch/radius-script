				local ap, as = svHit.AbsolutePosition, svHit.AbsoluteSize
				PK.slot.s = math.clamp((m.X - ap.X) / as.X, 0, 1)
				PK.slot.v = 1 - math.clamp((m.Y - ap.Y) / as.Y, 0, 1)
				changed()
			end)
			bindDrag(hueHit, function(m)
				if not PK.slot then
					return
				end
				local ap, as = hueHit.AbsolutePosition, hueHit.AbsoluteSize
				PK.slot.h = math.clamp((m.X - ap.X) / as.X, 0, 0.999)
				changed()
			end)
			bindDrag(alphaHit, function(m)
				if not PK.slot then
					return
				end
				local ap, as = alphaHit.AbsolutePosition, alphaHit.AbsoluteSize
				PK.slot.a = math.clamp((m.X - ap.X) / as.X, 0, 1)
				changed()
			end)


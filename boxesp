			SetTeamColorSource = function(name) pick("teamSource", {"Custom", "Roblox"}, name) end,
			SetTeamColorsCustom = function(ally, enemy)
				setSlot(slots.ally, ally)
				setSlot(slots.enemy, enemy)
			end,

			Destroy = destroy,
		}
	end
end

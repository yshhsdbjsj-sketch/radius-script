		-- ---------- dragging the picker + distance slider ----------
		-- the pointer coordinate space differs between executors/GUI-inset settings,
		-- so on press we pick the candidate that actually lies inside the pressed element
		-- and keep the difference as a calibration offset
		local GuiService = game:GetService("GuiService")
		local dragTarget
		local dragHit
		local calib = Vector2.new(0, 0)

		local function inside(pos, hit)
			local ap, as = hit.AbsolutePosition, hit.AbsoluteSize
			return pos.X >= ap.X - 1 and pos.X <= ap.X + as.X + 1 and pos.Y >= ap.Y - 1 and pos.Y <= ap.Y + as.Y + 1
		end

		local function calibrate(input, hit)
			local base = UserInputService:GetMouseLocation()
			local inset = Vector2.new(0, 0)
			pcall(function() inset = GuiService:GetGuiInset() end)
			local ip = Vector2.new(input.Position.X, input.Position.Y)
			local candidates = {base, ip, ip + inset, base - inset}
			calib = Vector2.new(0, 0)
			for _, c in ipairs(candidates) do
				if inside(c, hit) then
					calib = c - base
					return
				end
			end
		end

		local function applyDrag()
			if not dragTarget then
				return
			end
			local m = UserInputService:GetMouseLocation() + calib
			local ap, as = dragHit.AbsolutePosition, dragHit.AbsoluteSize
			if dragTarget == "sv" then
				s = math.clamp((m.X - ap.X) / as.X, 0, 1)
				v = 1 - math.clamp((m.Y - ap.Y) / as.Y, 0, 1)
				refreshColor()
			elseif dragTarget == "hue" then
				h = math.clamp((m.Y - ap.Y) / as.Y, 0, 0.999)
				refreshColor()
			elseif dragTarget == "dist" then
				-- the hit area is a little wider than the track, so measure on the track itself
				local tp, ts = distTrack.AbsolutePosition, distTrack.AbsoluteSize
				local a = math.clamp((m.X - tp.X) / ts.X, 0, 1)
				local value = DIST_MIN + a * (DIST_MAX - DIST_MIN)
				setDistance(math.floor(value / DIST_STEP + 0.5) * DIST_STEP)
			else
				alpha = 1 - math.clamp((m.Y - ap.Y) / as.Y, 0, 1)
				refreshColor()
			end
		end

		local function isPress(input)
			return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
		end

		local function bindDrag(hit, target)
			hit.InputBegan:Connect(function(input)
				-- locked while "Enabled" is off
				if isPress(input) and master then
					dragTarget = target
					dragHit = hit
					calibrate(input, hit)
					applyDrag()
				end
			end)
		end
		bindDrag(svHit, "sv")
		bindDrag(hueHit, "hue")
		bindDrag(alphaHit, "alpha")
		bindDrag(distHit, "dist")
		local moveConn = UserInputService.InputChanged:Connect(function(input)
			if dragTarget and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				applyDrag()
			end
		end)
		local endConn = UserInputService.InputEnded:Connect(function(input)
			if isPress(input) then
				dragTarget = nil
			end
		end)

		-- ---------- show / hide the settings window ----------
		local settingsShown = false
		local function updateSettings()
			local wanted = master and enabled and page.Visible
			if wanted ~= settingsShown then
				settingsShown = wanted
				if wanted then
					settings.Visible = true
					TweenService:Create(settingsScale, slideInfo, {Scale = 1}):Play()
				else
					local out = TweenService:Create(settingsScale, fadeInfo, {Scale = 0.92})
					out.Completed:Connect(function()
						if not settingsShown then
							settings.Visible = false
						end
					end)
					out:Play()
				end
			end

			-- sit under the window, or flip above it if the screen has no room
			if settings.Visible then
				local p, sz = win.frame.AbsolutePosition, win.frame.AbsoluteSize
				local below = p.Y + sz.Y + SET_GAP + SET_H <= win.gui.AbsoluteSize.Y
				settings.Position = below
					and UDim2.new(0.5, 0, 1, SET_GAP + SET_H / 2)
					or UDim2.new(0.5, 0, 0, -(SET_GAP + SET_H / 2))
			end
		end

		-- ====================================================
		-- preview on the 3D avatar render (GUI lines inside the viewport)
		-- ====================================================
		local previewViewport
		local previewLines = {}

		local function findViewport()
			if previewViewport and previewViewport.Parent then
				return previewViewport
			end
			previewViewport = popup and popup:FindFirstChildWhichIsA("ViewportFrame", true) or nil
			return previewViewport
		end

		local function hidePreview()
			for _, l in ipairs(previewLines) do
				l.Visible = false
			end
		end

		local function drawPreview(count)
			for i = 1, count do
				local l = previewLines[i]
				if not l then
					l = Instance.new("Frame")
					l.Name = "BoxEspLine"
					l.AnchorPoint = Vector2.new(0.5, 0.5)
					l.BorderSizePixel = 0
					l.Active = false
					l.ZIndex = 20
					l.Visible = false
					previewLines[i] = l
				end
				if l.Parent ~= previewViewport then
					l.Parent = previewViewport
				end
				local sg = segs[i]
				local dx, dy = sg[3] - sg[1], sg[4] - sg[2]
				local len = math.sqrt(dx * dx + dy * dy)
				l.BackgroundColor3 = color
				l.BackgroundTransparency = 1 - alpha
				l.Position = UDim2.fromOffset((sg[1] + sg[3]) / 2, (sg[2] + sg[4]) / 2)
				l.Size = UDim2.fromOffset(len + THICKNESS, THICKNESS)
				l.Rotation = math.deg(math.atan2(dy, dx))
				l.Visible = true
			end
			for i = count + 1, #previewLines do
				previewLines[i].Visible = false
			end
		end

		local function updatePreview()
			local viewport = findViewport()
			if not (master and enabled and popup and popup.Visible and viewport) then
				hidePreview()
				return
			end
			local camera = viewport.CurrentCamera
			local model = viewport:FindFirstChildOfClass("Model")
			if not (camera and model) then
				hidePreview()
				return
			end
			local uiScale = popup:FindFirstChildOfClass("UIScale")
			local vpSize = viewport.AbsoluteSize / (uiScale and uiScale.Scale or 1)
			if vpSize.X < 1 or vpSize.Y < 1 then
				hidePreview()
				return
			end
			drawPreview(computeSegments(model, makeProjector(camera, vpSize), style))
		end

		-- ====================================================
		-- real ESP (only while the menu is hidden)
		-- ====================================================
		local boxes = {} -- [player] = {lines = {}, shown = 0, version = n}

		local function newLine()
			local l = Drawing.new("Line")
			l.Color = color
			l.Transparency = drawingAlpha()
			l.Thickness = THICKNESS
			l.Visible = false
			return l
		end

		local function removeBox(player)
			local rec = boxes[player]
			if not rec then
				return
			end
			for _, l in ipairs(rec.lines) do
				pcall(function() l:Remove() end)
			end
			boxes[player] = nil
		end

		local function getBox(player)
			local rec = boxes[player]
			if not rec then
				rec = {lines = {}, shown = 0, version = styleVersion}
				boxes[player] = rec
			end
			return rec
		end

		local function hideAll()
			for _, rec in pairs(boxes) do
				for i = 1, rec.shown do
					rec.lines[i].Visible = false
				end
				rec.shown = 0
			end
		end

		local function drawBox(rec, count)
			local lines = rec.lines
			while #lines < count do
				table.insert(lines, newLine())
			end
			if rec.version ~= styleVersion then
				rec.version = styleVersion
				for _, l in ipairs(lines) do
					l.Color = color
					l.Transparency = drawingAlpha()
				end
			end
			for i = 1, count do
				local sg, l = segs[i], lines[i]
				l.From = Vector2.new(sg[1], sg[2])
				l.To = Vector2.new(sg[3], sg[4])
				l.Visible = true
			end
			for i = count + 1, rec.shown do
				lines[i].Visible = false
			end
			rec.shown = count
		end

		local wasActive = false
		local function updateEsp()
			-- master off, Box Esp off, or menu open -> nothing on the real players
			local active = hasDrawing and master and enabled and win.gui.Parent ~= nil and not win.gui.Enabled
			if not active then
				if wasActive then
					hideAll()
					wasActive = false
				end
				return
			end
			wasActive = true

			local camera = workspace.CurrentCamera
			if not camera then
				return
			end
			local project = makeProjector(camera)
			local camPos = camera.CFrame.Position
			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer then
					local char = player.Character
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					local root = char and char:FindFirstChild("HumanoidRootPart")
					local count = 0
					if char and hum and root and hum.Health > 0 then
						local pass = true
						if teamCheck and sameTeam(player) then
							pass = false
						end
						if pass and (root.Position - camPos).Magnitude > renderDist then
							pass = false
						end
						if pass and visCheck and not isVisible(char, camera) then
							pass = false
						end
						if pass then
							count = computeSegments(char, project, style)
						end
					end
					if count > 0 or boxes[player] then
						drawBox(getBox(player), count)
					end
				end
			end
		end

		local renderConn = RunService.RenderStepped:Connect(function()
			refreshLocks()
			updateSettings()
			updatePreview()
			updateEsp()
		end)
		local removingConn = Players.PlayerRemoving:Connect(removeBox)

		local function destroy()
			renderConn:Disconnect()
			removingConn:Disconnect()
			moveConn:Disconnect()
			endConn:Disconnect()
			for player in pairs(boxes) do
				removeBox(player)
			end
			for _, l in ipairs(previewLines) do
				l:Destroy()
			end
			settings:Destroy()
			boxCard:Destroy()
		end
		win.onClose(destroy)

		return {
			SetMaster = function(value)
				masterSwitch.Set(value)
			end,
			SetEnabled = function(value)
				boxSwitch.Set(value)
			end,
			IsEnabled = function()
				return master and enabled
			end,
			SetTeamCheck = function(value)
				teamSwitch.Set(value)
			end,
			SetVisibleCheck = function(value)
				visSwitch.Set(value)
			end,
			SetRenderDistance = function(studs)
				setDistance(math.floor(studs / DIST_STEP + 0.5) * DIST_STEP)
			end,
			SetStyle = function(name)
				if indexOf(STYLES, name) then
					style = name
					refreshStyleButtons(true)
				end
			end,
			SetColor = function(c)
				h, s, v = rgbToHsv(c)
				h = math.min(h, 0.999)
				refreshColor()
			end,
			SetAlpha = function(a)
				alpha = math.clamp(a, 0, 1)
				refreshColor()
			end,
			Destroy = destroy,
		}
	end

			for i = 0, 6 do
				table.insert(hueKeys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6 >= 1 and 0 or i / 6, 1, 1)))
			end
			local hueGradient = Instance.new("UIGradient")

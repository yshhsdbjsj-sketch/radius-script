-- esp module (Visuals tab)
-- usage in the main script (unchanged):
--   local buildBoxEsp = loadstring(game:HttpGet(BOXESP_URL))()(lib)
--   buildBoxEsp({pages = pages, fadeInfo = fadeInfo, slideInfo = slideInfo, popup = popup})
--
-- FIX: all settings-panel code now lives inside buildPanels(), so the main function
-- stays under Luau's limit of 200 local variables per function.

return function(lib)
	local Players = lib.Players
	local TweenService = lib.TweenService
	local RunService = lib.RunService
	local UserInputService = lib.UserInputService
	local win = lib.win
	local addCorner, addStroke = lib.addCorner, lib.addStroke
	local TEXT_MAIN = lib.TEXT_MAIN

	local LocalPlayer = Players.LocalPlayer

	local THICKNESS = 1.5
	local PAD = 2
	local SEG_MAX = 12
	local BONE_MAX = 14
	local HP_SEGS = 16 -- gradient resolution of the health bar
	local HP_W = 3     -- health bar width in pixels
	local LINE_H = 14  -- height of one text line under the player
	local ARMOR_MAX = 130 -- armor value that counts as a full bar
	local LOOK_LEN = 6    -- studs the look-direction line reaches in front of the head

	local ARROW_SIZE = {Small = 9, Medium = 13, Large = 18}
	local ARROW_RADIUS = {Near = 0.22, Mid = 0.34, Far = 0.44} -- fraction of the smaller screen side

	local R15_PARTS = {
		"Head", "UpperTorso", "LowerTorso",
		"LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm",
		"LeftHand", "RightHand",
		"LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg",
		"LeftFoot", "RightFoot",
	}
	local R6_PARTS = {"Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}

	local R15_BONES = {
		{"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
		{"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
		{"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
		{"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
		{"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
	}
	local R6_BONES = {
		{"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
		{"Torso", "Left Leg"}, {"Torso", "Right Leg"},
	}

	-- font name (as shown in the menu) -> Drawing font id / GUI font
	local DRAW_FONT = {UI = 0, System = 1, Plex = 2, Mono = 3}
	pcall(function()
		local f = Drawing.Fonts
		if f then
			DRAW_FONT = {UI = f.UI, System = f.System, Plex = f.Plex, Mono = f.Monospace}
		end
	end)
	local PREVIEW_FONT = {
		UI = Enum.Font.GothamMedium,
		System = Enum.Font.Arial,
		Plex = Enum.Font.RobotoMono,
		Mono = Enum.Font.Code,
	}

	-- ========================================================
	-- helpers that don't depend on optional executor APIs
	-- ========================================================
	local function hasBit(n, bit)
		return math.floor(n / bit) % 2 == 1
	end

	local function indexOf(list, value)
		for i, x in ipairs(list) do
			if x == value then
				return i
			end
		end
		return nil
	end

	local function rgbToHsv(c)
		local r, g, b = c.R, c.G, c.B
		local mx, mn = math.max(r, g, b), math.min(r, g, b)
		local d = mx - mn
		local hh = 0
		if d > 0 then
			if mx == r then
				hh = ((g - b) / d) % 6
			elseif mx == g then
				hh = (b - r) / d + 2
			else
				hh = (r - g) / d + 4
			end
			hh = hh / 6
		end
		return hh, (mx == 0) and 0 or d / mx, mx
	end

	-- ========================================================
	-- checks: team / visible
	-- ========================================================
	local function sameTeam(player)
		local myTeam = LocalPlayer.Team
		return myTeam ~= nil and player.Team == myTeam
	end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.IgnoreWater = true

	local function isVisible(char, camera)
		local origin = camera.CFrame.Position
		local myChar = LocalPlayer.Character
		rayParams.FilterDescendantsInstances = myChar and {myChar} or {}
		for _, name in ipairs({"Head", "HumanoidRootPart"}) do
			local part = char:FindFirstChild(name)
			if part then
				local hit = workspace:Raycast(origin, part.Position - origin, rayParams)
				if not hit or hit.Instance:IsDescendantOf(char) then
					return true
				end
			end
		end
		return false
	end

	local function weaponName(char)
		local tool = char:FindFirstChildOfClass("Tool")
		return tool and tool.Name or nil
	end

	local function armorFrac(char)
		local effects = char:FindFirstChild("BodyEffects")
		local armor = effects and effects:FindFirstChild("Armor")
		if armor and (armor:IsA("NumberValue") or armor:IsA("IntValue")) then
			return math.clamp(armor.Value / ARMOR_MAX, 0, 1)
		end
		return nil
	end

	-- ========================================================
	-- geometry
	-- ========================================================
	local segs = {}
	for i = 1, SEG_MAX do
		segs[i] = {0, 0, 0, 0}
	end
	local bones = {}
	for i = 1, BONE_MAX do
		bones[i] = {0, 0, 0, 0}
	end
	local tracerSeg = {{0, 0, 0, 0}}
	local lookSeg = {{0, 0, 0, 0}}

	local function setSeg(i, ax, ay, bx, by)
		local s = segs[i]
		s[1], s[2], s[3], s[4] = ax, ay, bx, by
	end

	local function makeProjector(camera, vpSize)
		if vpSize then
			local camCF = camera.CFrame
			local tanHalf = math.tan(math.rad(camera.FieldOfView) / 2)
			local w, h = vpSize.X, vpSize.Y
			local aspect = w / h
			return function(world)
				local rel = camCF:PointToObjectSpace(world)
				if rel.Z >= -0.05 then
					return 0, 0, false
				end
				local d = -rel.Z * tanHalf
				return (rel.X / (d * aspect) * 0.5 + 0.5) * w, (0.5 - rel.Y / d * 0.5) * h, true
			end
		end
		return function(world)
			local sp, onScreen = camera:WorldToViewportPoint(world)
			return sp.X, sp.Y, onScreen
		end
	end

	local bnd = {minX = 0, minY = 0, maxX = 0, maxY = 0}

	local function computeBounds(char, project)
		local parts = char:FindFirstChild("UpperTorso") and R15_PARTS or R6_PARTS
		local minX, minY = math.huge, math.huge
		local maxX, maxY = -math.huge, -math.huge
		local any = false
		for _, name in ipairs(parts) do
			local part = char:FindFirstChild(name)
			if part then
				local cf, half = part.CFrame, part.Size / 2
				for ix = -1, 1, 2 do
					for iy = -1, 1, 2 do
						for iz = -1, 1, 2 do
							local x, y, visible = project(cf:PointToWorldSpace(Vector3.new(half.X * ix, half.Y * iy, half.Z * iz)))
							if visible then
								any = true
								if x < minX then minX = x end
								if y < minY then minY = y end
								if x > maxX then maxX = x end
								if y > maxY then maxY = y end
							end
						end
					end
				end
			end
		end
		if not any then
			return false
		end
		bnd.minX, bnd.minY, bnd.maxX, bnd.maxY = minX, minY, maxX, maxY
		return true
	end

	local EDGES3D = {}
	for c = 0, 7 do
		for _, bit in ipairs({1, 2, 4}) do
			if not hasBit(c, bit) then
				table.insert(EDGES3D, {c + 1, c + bit + 1})
			end
		end
	end
	local cornerX, cornerY = {}, {}

	local function computeBox3D(char, project)
		local parts = char:FindFirstChild("UpperTorso") and R15_PARTS or R6_PARTS
		local root = char:FindFirstChild("HumanoidRootPart")
			or char:FindFirstChild("UpperTorso")
			or char:FindFirstChild("Torso")
		if not root then
			return 0
		end
		local rootCF = root.CFrame
		local loX, loY, loZ = math.huge, math.huge, math.huge
		local hiX, hiY, hiZ = -math.huge, -math.huge, -math.huge
		local any = false
		for _, name in ipairs(parts) do
			local part = char:FindFirstChild(name)
			if part then
				local cf, half = part.CFrame, part.Size / 2
				for ix = -1, 1, 2 do
					for iy = -1, 1, 2 do
						for iz = -1, 1, 2 do
							local lp = rootCF:PointToObjectSpace(cf:PointToWorldSpace(Vector3.new(half.X * ix, half.Y * iy, half.Z * iz)))
							any = true
							if lp.X < loX then loX = lp.X end
							if lp.Y < loY then loY = lp.Y end
							if lp.Z < loZ then loZ = lp.Z end
							if lp.X > hiX then hiX = lp.X end
							if lp.Y > hiY then hiY = lp.Y end
							if lp.Z > hiZ then hiZ = lp.Z end
						end
					end
				end
			end
		end
		if not any then
			return 0
		end
		for c = 0, 7 do
			local lx = hasBit(c, 1) and hiX or loX
			local ly = hasBit(c, 2) and hiY or loY
			local lz = hasBit(c, 4) and hiZ or loZ
			local x, y, visible = project(rootCF:PointToWorldSpace(Vector3.new(lx, ly, lz)))
			if not visible then
				return 0
			end
			cornerX[c + 1], cornerY[c + 1] = x, y
		end
		for i, e in ipairs(EDGES3D) do
			setSeg(i, cornerX[e[1]], cornerY[e[1]], cornerX[e[2]], cornerY[e[2]])
		end
		return #EDGES3D
	end

	local function computeBox(char, project, style, hasBounds)
		if style == "3D" then
			return computeBox3D(char, project)
		end
		if not hasBounds then
			return 0
		end
		local minX, minY, maxX, maxY = bnd.minX, bnd.minY, bnd.maxX, bnd.maxY
		local x0, y0, x1, y1 = minX - PAD, minY - PAD, maxX + PAD, maxY + PAD
		if style == "Corners" then
			local cw = math.min((maxX - minX) * 0.25, 12)
			local ch = math.min((maxY - minY) * 0.25, 12)
			setSeg(1, x0, y0, x0 + cw, y0)
			setSeg(2, x0, y0, x0, y0 + ch)
			setSeg(3, x1, y0, x1 - cw, y0)
			setSeg(4, x1, y0, x1, y0 + ch)
			setSeg(5, x0, y1, x0 + cw, y1)
			setSeg(6, x0, y1, x0, y1 - ch)
			setSeg(7, x1, y1, x1 - cw, y1)
			setSeg(8, x1, y1, x1, y1 - ch)
			return 8
		end
		setSeg(1, x0, y0, x1, y0)
		setSeg(2, x0, y1, x1, y1)
		setSeg(3, x0, y0, x0, y1)
		setSeg(4, x1, y0, x1, y1)
		return 4
	end

	local function computeSkeleton(char, project)
		local list = char:FindFirstChild("UpperTorso") and R15_BONES or R6_BONES
		local n = 0
		for _, pair in ipairs(list) do
			local a, b = char:FindFirstChild(pair[1]), char:FindFirstChild(pair[2])
			if a and b then
				local ax, ay, av = project(a.Position)
				local bx, by, bv = project(b.Position)
				if av and bv then
					n = n + 1
					local s = bones[n]
					s[1], s[2], s[3], s[4] = ax, ay, bx, by
				end
			end
		end
		return n
	end

	local function computeTracer(char, project, ox, oy)
		local root = char:FindFirstChild("HumanoidRootPart")
			or char:FindFirstChild("UpperTorso")
			or char:FindFirstChild("Torso")
		if not root then
			return 0
		end
		local x, y, visible = project(root.Position - Vector3.new(0, 3, 0))
		if not visible then
			return 0
		end
		local s = tracerSeg[1]
		s[1], s[2], s[3], s[4] = ox, oy, x, y
		return 1
	end

	local function computeHead(char, project)
		local head = char:FindFirstChild("Head")
		if not head then
			return nil
		end
		local x, y, visible = project(head.Position)
		if not visible then
			return nil
		end
		local _, ty, topVisible = project(head.Position + Vector3.new(0, head.Size.Y / 2, 0))
		local r = topVisible and math.abs(ty - y) or 3
		return x, y, math.max(r, 2.5)
	end

	local function computeLook(char, project)
		local head = char:FindFirstChild("Head")
		if not head then
			return 0
		end
		local from = head.Position
		local to = from + head.CFrame.LookVector * LOOK_LEN
		local ax, ay, av = project(from)
		local bx, by, bv = project(to)
		if not (av and bv) then
			return 0
		end
		local s = lookSeg[1]
		s[1], s[2], s[3], s[4] = ax, ay, bx, by
		return 1
	end

	local function computeArrow(camera, worldPos, vs, size, ringFrac)
		local sp, onScreen = camera:WorldToViewportPoint(worldPos)
		if onScreen and sp.X >= 0 and sp.X <= vs.X and sp.Y >= 0 and sp.Y <= vs.Y then
			return nil
		end
		local rel = camera.CFrame:PointToObjectSpace(worldPos)
		local dx, dy = rel.X, -rel.Y
		local mag = math.sqrt(dx * dx + dy * dy)
		if mag < 1e-4 then
			dx, dy, mag = 0, 1, 1
		end
		dx, dy = dx / mag, dy / mag

		local ring = math.min(vs.X, vs.Y) * ringFrac
		local cx, cy = vs.X / 2 + dx * ring, vs.Y / 2 + dy * ring
		local px, py = -dy, dx
		local bx, by = cx - dx * size * 0.6, cy - dy * size * 0.6
		return cx + dx * size, cy + dy * size,
			bx + px * size * 0.7, by + py * size * 0.7,
			bx - px * size * 0.7, by - py * size * 0.7
	end

	return function(ctx)
		local page = ctx.pages["Visuals"]
		local fadeInfo = ctx.fadeInfo
		local slideInfo = ctx.slideInfo or ctx.fadeInfo
		local popup = ctx.popup

		-- ====================================================
		-- state
		-- ====================================================
		local master = false
		local teamCheck = false
		local visCheck = false
		local DIST_MIN, DIST_MAX, DIST_STEP = 50, 5000, 50
		local renderDist = 1500

		local FEATURES = {
			"Box", "BoxFill", "Chams", "Name", "Health", "Armor", "HealthText", "Skeleton",
			"HeadDot", "LookDir", "Tracers", "Arrows", "Distance", "Weapon", "TeamColors",
		}
		local LABELS = {
			Box = "Box Esp", BoxFill = "Box Fill", Chams = "Chams", Name = "Name Esp",
			Health = "Health Bar", Armor = "Armor Bar", HealthText = "Health Text",
			Skeleton = "Skeleton Esp", HeadDot = "Head Dot", LookDir = "Look Direction",
			Tracers = "Tracers", Arrows = "Off-screen Arrows", Distance = "Distance Text",
			Weapon = "Weapon Text", TeamColors = "Team Colors",
		}
		local feat = {}
		for _, key in ipairs(FEATURES) do
			feat[key] = false
		end
		local selected = nil

		local style = "Full"
		local nameSource = "Display"
		local hpMode = "Gradient"
		local hpFormat = "Number"
		local skelThick = 1
		local tracerFrom = "Bottom"
		local teamSource = "Custom"
		local headStyle = "Outline"
		local chamStyle = "Both"
		local chamWalls = "On"
		local arrowSize = "Medium"
		local arrowRadius = "Mid"
		local fonts = {Name = "UI", HealthText = "UI", Distance = "UI", Weapon = "UI"}

		local function newSlot(c, a)
			local hh, ss, vv = rgbToHsv(c)
			return {h = math.min(hh, 0.999), s = ss, v = vv, a = a or 1}
		end
		local function colorOf(slot)
			return Color3.fromHSV(slot.h, slot.s, slot.v)
		end

		local slots = {
			box = newSlot(Color3.fromRGB(180, 180, 180)),
			fill = newSlot(Color3.fromRGB(180, 180, 180), 0.25),
			name = newSlot(Color3.fromRGB(255, 255, 255)),
			skel = newSlot(Color3.fromRGB(180, 180, 180)),
			trc = newSlot(Color3.fromRGB(180, 180, 180)),
			hpText = newSlot(Color3.fromRGB(255, 255, 255)),
			dist = newSlot(Color3.fromRGB(255, 255, 255)),
			weapon = newSlot(Color3.fromRGB(255, 255, 255)),
			hpFull = newSlot(Color3.fromRGB(60, 220, 90)),
			hpMid = newSlot(Color3.fromRGB(240, 210, 60)),
			hpLow = newSlot(Color3.fromRGB(235, 60, 60)),
			armor = newSlot(Color3.fromRGB(70, 140, 255)),
			head = newSlot(Color3.fromRGB(255, 255, 255)),
			look = newSlot(Color3.fromRGB(255, 255, 255)),
			arrow = newSlot(Color3.fromRGB(255, 255, 255)),
			chamFill = newSlot(Color3.fromRGB(190, 190, 200), 0.35),
			chamOutline = newSlot(Color3.fromRGB(255, 255, 255), 0.9),
			ally = newSlot(Color3.fromRGB(80, 200, 120)),
			enemy = newSlot(Color3.fromRGB(235, 70, 70)),
		}

		local function colorFor(slot, player)
			if feat.TeamColors then
				if teamSource == "Roblox" then
					local p = player or LocalPlayer
					if p.Team then
						return p.TeamColor.Color
					end
				elseif player then
					return sameTeam(player) and colorOf(slots.ally) or colorOf(slots.enemy)
				else
					return colorOf(slots.enemy)
				end
			end
			return colorOf(slot)
		end

		local function anyOn()
			for _, key in ipairs(FEATURES) do
				if key ~= "TeamColors" and feat[key] then
					return true
				end
			end
			return false
		end

		local function needsBounds()
			return feat.BoxFill or feat.Name or feat.Health or feat.Armor or feat.HealthText or feat.Distance or feat.Weapon
				or (feat.Box and style ~= "3D")
		end

		local curFade = 1
		local function fadeFor(dist)
			local start = renderDist * 0.35
			if dist <= start then
				return 1
			end
			return 1 - 0.8 * math.clamp((dist - start) / math.max(renderDist - start, 1), 0, 1)
		end

		local DRAWING_ALPHA_INVERTED = false
		local function dAlpha(a)
			return DRAWING_ALPHA_INVERTED and (1 - a) or a
		end

		local hasDrawing = typeof(Drawing) == "table" or (Drawing ~= nil and Drawing.new ~= nil)
		if not hasDrawing then
			warn("[esp] Drawing library not available - only the preview will work")
		end

		-- ====================================================
		-- colors / constants
		-- ====================================================
		local CARD_BG = Color3.fromRGB(28, 28, 32)
		local CARD_STROKE = Color3.fromRGB(42, 42, 47)
		local PANEL_BG = Color3.fromRGB(22, 22, 25)
		local PANEL_STROKE = Color3.fromRGB(42, 42, 47)
		local FIELD_STROKE = Color3.fromRGB(46, 46, 51)
		local TEXT_DIM = Color3.fromRGB(110, 110, 116)
		local TEXT_SOFT = Color3.fromRGB(190, 190, 196)
		local ON_TRACK = Color3.fromRGB(225, 225, 232)
		local OFF_TRACK = Color3.fromRGB(44, 44, 50)
		local ON_KNOB = Color3.fromRGB(22, 22, 25)
		local OFF_KNOB = Color3.fromRGB(140, 140, 146)
		local LOCKED_T = 0.6
		local ROW_H, SLIDER_H = 44, 56

		local function toHex(c)
			return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
		end

		-- ====================================================
		-- dragging
		-- ====================================================
		local GuiService = game:GetService("GuiService")
		local dragFn
		local calib = Vector2.new(0, 0)

		local function inside(pos, hit)
			local ap, as = hit.AbsolutePosition, hit.AbsoluteSize
			return pos.X >= ap.X - 1 and pos.X <= ap.X + as.X + 1 and pos.Y >= ap.Y - 1 and pos.Y <= ap.Y + as.Y + 1
		end

		local function calibrate(input, hit)
			local base = UserInputService:GetMouseLocation()
			local inset = Vector2.new(0, 0)
			pcall(function() inset = GuiService:GetGuiInset() end)
			local ip = Vector2.new(input.Position.X, input.Position.Y)
			local candidates = {base, ip, ip + inset, base - inset}
			calib = Vector2.new(0, 0)
			for _, c in ipairs(candidates) do
				if inside(c, hit) then
					calib = c - base
					return
				end
			end
		end

		local function applyDrag()
			if dragFn then
				dragFn(UserInputService:GetMouseLocation() + calib)
			end
		end

		local function isPress(input)
			return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
		end

		local function bindDrag(hit, fn)
			hit.InputBegan:Connect(function(input)
				if isPress(input) and master then
					dragFn = fn
					calibrate(input, hit)
					applyDrag()
				end
			end)
		end

		local moveConn = UserInputService.InputChanged:Connect(function(input)
			if dragFn and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				applyDrag()
			end
		end)
		local endConn = UserInputService.InputEnded:Connect(function(input)
			if isPress(input) then
				dragFn = nil
			end
		end)

		-- ====================================================
		-- Visuals page
		-- ====================================================
		local CARD1_H = 191
		local CARD_GAP = 10
		local FEAT_H = #FEATURES * 45 - 1

		local scroll = Instance.new("ScrollingFrame")
		scroll.Name = "VisualsScroll"
		scroll.BackgroundTransparency = 1
		scroll.BorderSizePixel = 0
		scroll.Position = UDim2.fromOffset(0, 66)
		scroll.Size = UDim2.new(1, 0, 1, -66)
		scroll.CanvasSize = UDim2.fromOffset(0, CARD1_H + CARD_GAP + FEAT_H + 20)
		scroll.ScrollingDirection = Enum.ScrollingDirection.Y
		scroll.ScrollBarThickness = 4
		scroll.ScrollBarImageColor3 = Color3.fromRGB(90, 90, 100)
		scroll.ScrollBarImageTransparency = 0.2
		scroll.ElasticBehavior = Enum.ElasticBehavior.Never
		scroll.VerticalScrollBarInset = Enum.ScrollBarInset.None
		scroll.Parent = page

		local card = Instance.new("Frame")
		card.Name = "VisualsCard"
		card.Position = UDim2.fromOffset(20, 0)
		card.Size = UDim2.new(1, -40, 0, CARD1_H)

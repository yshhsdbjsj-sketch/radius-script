		-- row of exclusive buttons; onPick(name) runs on every change (click or .Set)
		local function makeChoice(parent, x, y, names, initial, onPick)
			local row = Instance.new("Frame")
			row.BackgroundTransparency = 1
			row.Position = UDim2.fromOffset(x, y)
			row.Size = UDim2.new(1, -(x + 14), 0, 26)
			row.Parent = parent

			local layout = Instance.new("UIListLayout")
			layout.FillDirection = Enum.FillDirection.Horizontal
			layout.Padding = UDim.new(0, 6)
			layout.SortOrder = Enum.SortOrder.LayoutOrder
			layout.Parent = row

			local n = #names
			local buttons, strokes = {}, {}
			local current = initial
			local api = {buttons = buttons}

			local function refresh(animate)
				local info = animate and fadeInfo or TweenInfo.new(0)
				for name, btn in pairs(buttons) do
					local sel = name == current
					TweenService:Create(btn, info, {
						BackgroundColor3 = sel and Color3.fromRGB(48, 48, 55) or Color3.fromRGB(28, 28, 32),
						TextColor3 = sel and TEXT_MAIN or TEXT_SOFT,
					}):Play()
					TweenService:Create(strokes[name], info, {
						Color = sel and Color3.fromRGB(120, 120, 130) or FIELD_STROKE,
					}):Play()
				end
			end

			function api.Set(name)
				if not buttons[name] then
					return
				end
				current = name
				refresh(true)
				onPick(name)
			end

			for i, name in ipairs(names) do
				local btn = Instance.new("TextButton")
				btn.Name = name
				btn.LayoutOrder = i
				btn.Size = UDim2.new(1 / n, -6 * (n - 1) / n, 1, 0)
				btn.BackgroundColor3 = Color3.fromRGB(28, 28, 32)
				btn.BorderSizePixel = 0
				btn.AutoButtonColor = false
				btn.Font = Enum.Font.GothamMedium
				btn.Text = name
				btn.TextColor3 = TEXT_SOFT
				btn.TextSize = 13
				btn.Parent = row
				addCorner(btn)
				strokes[name] = addStroke(btn, FIELD_STROKE)
				buttons[name] = btn
				btn.MouseButton1Click:Connect(function()
					api.Set(name)
				end)
			end
			refresh(false)
			return api
		end


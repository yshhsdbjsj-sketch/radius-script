	local DMG_MAX = 24
	local RING_MAX, RING_SEGS = 14, 16
	local HIT_MAX = 6
	local HL_MAX = 28
	local STRIDE = 4.2
	local HIT_WINDOW = 0.4
	local DASH, GAP = 7, 5
	local OUTLINE_COLOR = Color3.fromRGB(8, 8, 10)

	local ARROW_SIZE = {Small = 9, Medium = 13, Large = 18}
	local ARROW_RADIUS = {Near = 0.22, Mid = 0.34, Far = 0.44}
	local STATUS_COLOR = Color3.fromRGB(170, 170, 176)
	local HIT_DUR = {Slow = 0.8, Normal = 0.5, Fast = 0.3}
	local CHAM_THICK = {Thin = 0, Normal = 1, Thick = 2}

	local R15_PARTS = {
		"Head", "UpperTorso", "LowerTorso",
		"LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm",
		"LeftHand", "RightHand",
		"LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg",
		"LeftFoot", "RightFoot",
	}
	local R6_PARTS = {"Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}

	local R15_BONES = {
		{"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
		{"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
		{"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
		{"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
		{"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
	}
	local R6_BONES = {
		{"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
		{"Torso", "Left Leg"}, {"Torso", "Right Leg"},
	}

	local DRAW_FONT = {UI = 0, System = 1, Plex = 2, Mono = 3}
	pcall(function()
		local f = Drawing.Fonts
		if f then
			DRAW_FONT = {UI = f.UI, System = f.System, Plex = f.Plex, Mono = f.Monospace}
		end
	end)
	local PREVIEW_FONT = {

		local function layoutCard(card)
			local y = 0
			for _, it in ipairs(card.items) do
				local h = it.rowH + it.dropH * it.t
				it.frame.Position = UDim2.fromOffset(0, y)
				it.frame.Size = UDim2.new(1, 0, 0, h)
				y = y + h
			end
			card.frame.Size = UDim2.new(1, -40, 0, y)
			return y
		end

		local function animateItems(dt)
			local k = 1 - math.exp(-dt * 14)
			for _, card in ipairs(cards) do
				for _, it in ipairs(card.items) do
					local target = it.open and 1 or 0
					if it.t ~= target then
						it.t = it.t + (target - it.t) * k
						if math.abs(target - it.t) < 0.01 then
							it.t = target
						end
						if it.arrow then
							it.arrow.Rotation = 180 * it.t
						end
						layoutDirty = true
					end
				end
			end
			if layoutDirty then
				layoutDirty = false
				local y1 = layoutCard(card1)
				card2.frame.Position = UDim2.fromOffset(20, y1 + GAP)
				local y2 = layoutCard(card2)
				scroll.CanvasSize = UDim2.fromOffset(0, y1 + GAP + y2 + 20)
			end
		end


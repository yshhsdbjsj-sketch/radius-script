					ui.choices.style.Set(name)
				end
			end,
			SetColor = function(c) setSlot(slots.box, c) end,
			SetAlpha = function(a)
				slots.box.a = math.clamp(a, 0, 1)
				refreshAllPickers()
			end,
			SetBoxFillColor = function(c, a)
				setSlot(slots.fill, c)
				if a then
					slots.fill.a = math.clamp(a, 0, 1)
					refreshAllPickers()
				end
			end,

			-- chams
			SetChamsStyle = function(name)
				if indexOf(CHAM_STYLES, name) then
					ui.choices.chamStyle.Set(name)
				end
			end,
			SetChamsThroughWalls = function(value)
				ui.choices.chamWalls.Set(value and "On" or "Off")
			end,
			SetChamsColors = function(fill, outline, fillAlpha, outlineAlpha)
				setSlot(slots.chamFill, fill)
				if outline then
					setSlot(slots.chamOutline, outline)
				end
				if fillAlpha then
					slots.chamFill.a = math.clamp(fillAlpha, 0, 1)
				end
				if outlineAlpha then
					slots.chamOutline.a = math.clamp(outlineAlpha, 0, 1)
				end
				refreshAllPickers()
			end,

			-- name
			SetNameSource = function(name)
				if indexOf(NAME_SOURCES, name) then
					ui.choices.source.Set(name)
				end
			end,
			SetNameColor = function(c) setSlot(slots.name, c) end,

			-- health / armor
			SetHealthMode = function(name)
				if name == "Solid" or name == "Gradient" then
					ui.choices.hpMode.Set(name)
				end
			end,
			SetHealthColors = function(full, mid, low)
				setSlot(slots.hpFull, full)
				setSlot(slots.hpMid, mid)
				setSlot(slots.hpLow, low)
			end,
			SetArmorColor = function(c) setSlot(slots.armor, c) end,
			SetHealthTextFormat = function(name)
				if indexOf(HP_FORMATS, name) then
					ui.choices.hpFormat.Set(name)
				end
			end,
			SetHealthTextColor = function(c) setSlot(slots.hpText, c) end,

			-- skeleton
			SetSkeletonColor = function(c) setSlot(slots.skel, c) end,
			SetSkeletonThickness = function(name)
				if THICKNESSES[name] then
					ui.choices.thick.Set(name)
				end
			end,

			-- head dot / look direction
			SetHeadDotStyle = function(name)
				if indexOf(HEAD_STYLES, name) then
					ui.choices.head.Set(name)
				end
			end,
			SetHeadDotColor = function(c) setSlot(slots.head, c) end,
			SetLookColor = function(c) setSlot(slots.look, c) end,

			-- tracers / arrows
			SetTracerOrigin = function(name)
				if indexOf(TRACER_ORIGINS, name) then
					ui.choices.tracer.Set(name)
				end
			end,
			SetTracerColor = function(c) setSlot(slots.trc, c) end,
			SetArrowSize = function(name)
				if indexOf(ARROW_SIZES, name) then
					ui.choices.arrowSize.Set(name)
				end
			end,
			SetArrowDistance = function(name)
				if indexOf(ARROW_RADII, name) then
					ui.choices.arrowRadius.Set(name)
				end
			end,
			SetArrowColor = function(c) setSlot(slots.arrow, c) end,

			-- distance / weapon text
			SetDistanceColor = function(c) setSlot(slots.dist, c) end,
			SetWeaponColor = function(c) setSlot(slots.weapon, c) end,

			-- fonts
			SetFont = function(feature, name)
				if fontChoices[feature] and indexOf(FONT_NAMES, name) then
					fontChoices[feature].Set(name)
				end
			end,

			-- team colors
			SetTeamColorSource = function(name)
				if name == "Custom" or name == "Roblox" then
					ui.choices.teamSource.Set(name)
				end
			end,
			SetTeamColorsCustom = function(ally, enemy)
				setSlot(slots.ally, ally)
				setSlot(slots.enemy, enemy)
			end,

			Destroy = destroy,
		}
	end
end

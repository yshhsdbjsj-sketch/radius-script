		-- ---------- show / hide / switch the settings window ----------
		local settingsShown = false
		local shownKey = nil
		local curH = 150

		local function updateSettings()
			local wanted = master and selected ~= nil and page.Visible

			if wanted and selected ~= shownKey then
				if shownKey then
					panels[shownKey].frame.Visible = false
				end
				shownKey = selected
				panels[shownKey].frame.Visible = true
				curH = panels[shownKey].height
				settings.Size = UDim2.new(1, 0, 0, curH)
			end

			if wanted ~= settingsShown then
				settingsShown = wanted
				if wanted then
					settings.Visible = true
					TweenService:Create(settingsScale, slideInfo, {Scale = 1}):Play()
				else
					local out = TweenService:Create(settingsScale, fadeInfo, {Scale = 0.92})
					out.Completed:Connect(function()
						if not settingsShown then
							settings.Visible = false
						end
					end)
					out:Play()
				end
			end

			if settings.Visible then
				local p, sz = win.frame.AbsolutePosition, win.frame.AbsoluteSize
				local below = p.Y + sz.Y + SET_GAP + curH <= win.gui.AbsoluteSize.Y
				settings.Position = below
					and UDim2.new(0.5, 0, 1, SET_GAP + curH / 2)
					or UDim2.new(0.5, 0, 0, -(SET_GAP + curH / 2))
			end
		end


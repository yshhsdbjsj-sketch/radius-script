			end
			lastLocked = locked
			for _, o in ipairs(lockables) do
				o.SetLocked(locked)
			end
			local t = locked and LOCKED_T or 0
			TweenService:Create(distTrack, fadeInfo, {BackgroundTransparency = t}):Play()
			TweenService:Create(distFill, fadeInfo, {BackgroundTransparency = t}):Play()
			TweenService:Create(distKnob, fadeInfo, {BackgroundTransparency = t}):Play()
			TweenService:Create(distValue, fadeInfo, {TextTransparency = locked and 0.5 or 0}):Play()

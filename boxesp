		local function drawLinePool(pool, count, list, c, a, thick, z)
			for i = 1, count do
				local l = getFrame(pool, i, "EspLine", z)
				local sg = list[i]
				local dx, dy = sg[3] - sg[1], sg[4] - sg[2]
				local len = math.sqrt(dx * dx + dy * dy)
				l.AnchorPoint = Vector2.new(0.5, 0.5)
				l.BackgroundColor3 = c
				l.BackgroundTransparency = 1 - a
				l.Position = UDim2.fromOffset((sg[1] + sg[3]) / 2, (sg[2] + sg[4]) / 2)
				l.Size = UDim2.fromOffset(len + thick, thick)
				l.Rotation = math.deg(math.atan2(dy, dx))
				l.Visible = true
			end
			for i = count + 1, #pool do
				pool[i].Visible = false
			end
		end


			for i = 1, count do
				local f = getFrame(prevJoint, i, "EspJoint", 21)
				if not f:FindFirstChildOfClass("UICorner") then
					local cr = Instance.new("UICorner")
					cr.CornerRadius = UDim.new(1, 0)
					cr.Parent = f
				end
				f.AnchorPoint = Vector2.new(0.5, 0.5)
				f.Rotation = 0
				f.BackgroundColor3 = c
				f.BackgroundTransparency = 1 - a
				f.Position = UDim2.fromOffset(jointX[i], jointY[i])
				f.Size = UDim2.fromOffset(r * 2, r * 2)
				f.Visible = true
			end
			for i = count + 1, #prevJoint do
				prevJoint[i].Visible = false
			end
		end

		-- pool[1] = background, pool[2..] = the colored pieces
		local function drawBarPreview(pool, bgRect, rects, count, show)
			if not show then
				hidePool(pool)
				return
			end
			local bg = getFrame(pool, 1, "EspBarBg")
			bg.AnchorPoint = Vector2.new(0, 0)
			bg.Rotation = 0
			bg.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
			bg.BackgroundTransparency = 0.3
			bg.Position = UDim2.fromOffset(bgRect[1], bgRect[2])
			bg.Size = UDim2.fromOffset(bgRect[3], bgRect[4])
			bg.Visible = true
			for i = 1, count do
				local r = rects[i]
				local f = getFrame(pool, i + 1, "EspBarFill", 21)
				f.AnchorPoint = Vector2.new(0, 0)
				f.Rotation = 0
				f.BackgroundColor3 = r[5]
				f.BackgroundTransparency = 0
				f.Position = UDim2.fromOffset(r[1], r[2])
				f.Size = UDim2.fromOffset(r[3], r[4])
				f.Visible = true
			end
			for i = count + 2, #pool do
				pool[i].Visible = false
			end
		end

		local function drawGhostPreview(show)
			if not show then
				hidePool(prevGhost)
				return
			end
			local f = getFrame(prevGhost, 1, "EspGhost", 20)
			f.AnchorPoint = Vector2.new(0, 0)
			f.Rotation = 0
			f.BackgroundColor3 = colorOf(slots.ghost)
			f.BackgroundTransparency = 0.05
			f.Position = UDim2.fromOffset(ghostRect[1], ghostRect[2])
			f.Size = UDim2.fromOffset(ghostRect[3], ghostRect[4])
			f.Visible = true
		end

		-- gradient box fill: one frame + a UIGradient (colors and opacity)
		local function drawFillPreview(c1, a1, c2, a2, mode)
			local f = getFrame(prevFill, 1, "EspFill", 18)
			f.AnchorPoint = Vector2.new(0, 0)
			f.Rotation = 0
			f.BackgroundColor3 = Color3.new(1, 1, 1)
			f.BackgroundTransparency = 0
			f.Position = UDim2.fromOffset(bnd.minX - PAD, bnd.minY - PAD)
			f.Size = UDim2.fromOffset(bnd.maxX - bnd.minX + PAD * 2, bnd.maxY - bnd.minY + PAD * 2)
			local g = f:FindFirstChildOfClass("UIGradient")
			if not g then
				g = Instance.new("UIGradient")
				g.Rotation = 90
				g.Parent = f
			end
			if mode == "Fade Down" then
				g.Color = ColorSequence.new(c1)
				g.Transparency = NumberSequence.new(1 - a1, 1)
			elseif mode == "Fade Up" then
				g.Color = ColorSequence.new(c1)
				g.Transparency = NumberSequence.new(1, 1 - a1)
			elseif mode == "Two-tone" then
				g.Color = ColorSequence.new(c1, c2)
				g.Transparency = NumberSequence.new(1 - a1, 1 - a2)
			else
				g.Color = ColorSequence.new(c1)
				g.Transparency = NumberSequence.new(1 - a1)
			end
			f.Visible = true
		end

		local function updatePreview()
			local viewport = findViewport()
			if not (master and anyOn() and popup and popup.Visible and viewport) then
				hidePreview()
				return
			end
			local camera = viewport.CurrentCamera
			local model = viewport:FindFirstChildOfClass("Model")
			if not (camera and model) then
				hidePreview()
				return
			end
			local uiScale = popup:FindFirstChildOfClass("UIScale")
			local vpSize = viewport.AbsoluteSize / (uiScale and uiScale.Scale or 1)
			if vpSize.X < 1 or vpSize.Y < 1 then
				hidePreview()
				return
			end

			local now = os.clock()
			local project = makeProjector(camera, vpSize)
			local hasB = (needsBounds() or feat.LookDir) and computeBounds(model, project)
			local cx = (bnd.minX + bnd.maxX) / 2

			-- visibility colors: the preview flips between "visible" and "hidden"
			if feat.VisColors then
				curVis = math.floor(now / 2.2) % 2 == 0
			else
				curVis = nil
			end

			-- demo health: a few hits, then a heal (drives the ghost bar, damage numbers, cham pulse, hit marker)
			local ps = prevHpState
			if now >= ps.nextHit then
				local before = ps.target
				if ps.target > 0.35 then
					ps.target = math.max(0.12, ps.target - (0.2 + 0.18 * math.random()))
				else
					ps.target = 1
				end
				ps.nextHit = now + 1.7
				local delta = math.floor((before - ps.target) * 100 + 0.5)
				if delta > 0 then
					ps.hitAt = now
				end
				if delta ~= 0 and (delta > 0 or opt.dmgHeals == "On") then
					table.insert(prevDmg, {t0 = now, amt = math.abs(delta), heal = delta < 0, dx = math.random(-12, 12)})
					if #prevDmg > 3 then
						table.remove(prevDmg, 1)
					end
				end
			end
			ps.shown = approach(ps.shown, ps.target, frameDt, 7, 0.002)
			local frac = math.clamp(ps.shown, 0.05, 1)

			-- chams (shell parts in the viewport)
			if feat.Chams then
				Chams.preview(model, ensure3D(), {
					mode = opt.chamStyle,
					fill = colorFor(slots.chamFill, nil, true),
					outline = colorOf(slots.chamOutline),
					fillA = slots.chamFill.a,
					outA = slots.chamOutline.a,
					pulse = (opt.chamPulse == "On") and math.clamp(1 - (now - ps.hitAt) / 0.5, 0, 1) or 0,
					pulseColor = colorOf(slots.chamPulse),
					thick = CHAM_THICK[opt.chamThick] or 0,
				}, prevChamState)
			else
				Chams.previewClear(prevChamState)
			end

			-- box fill
			if feat.BoxFill and hasB then
				local c1 = colorFor(slots.fill, nil, true)
				local mode = opt.fillMode
				if mode == "Health" then
					if not (feat.VisColors and curVis ~= nil) then
						c1 = healthColor(frac)
					end
					mode = "Solid"
				end
				local c2 = colorOverridden() and c1:Lerp(Color3.new(0, 0, 0), 0.55) or colorOf(slots.fill2)
				drawFillPreview(c1, slots.fill.a, c2, slots.fill2.a, mode)
			else
				hidePool(prevFill)
			end

			-- box (shape + pulse)
			local pm = opt.boxPulse == "On" and pulseMul(now) or 1
			local n = feat.Box and computeBox(model, project, opt.style, hasB, opt.boxShape) or 0
			if feat.Box and opt.boxOutline == "On" then
				drawLinePool(prevBoxOut, n, segs, OUTLINE_COLOR, 0.8 * pm, THICKNESS + 2, 19)
			else
				hidePool(prevBoxOut)
			end
			drawLinePool(prevBox, n, segs, colorFor(slots.box, nil, true), slots.box.a * pm,
				THICKNESS * (opt.boxPulse == "On" and (0.85 + 0.35 * pm) or 1))

			local jn = 0
			n = 0
			if feat.Skeleton then
				n, jn = computeSkeleton(model, project, opt.joints == "On")
			end
			local skelC = colorFor(slots.skel, nil, true)
			drawLinePool(prevSkel, n, bones, skelC, slots.skel.a, opt.skelThick)
			drawJointPreview(jn, skelC, slots.skel.a, 1.5 + opt.skelThick)

			n = feat.LookDir and computeLook(model, project, opt.lookLen) or 0
			if n > 0 and hasB then
				-- keep the line inside the avatar instead of poking out over the render
				local sg = lookSeg[1]
				local x0, y0, x1, y1 = bnd.minX + 2, bnd.minY + 2, bnd.maxX - 2, bnd.maxY - 2
				local sx, sy = sg[1], sg[2]
				local dx, dy = sg[3] - sx, sg[4] - sy
				local t = 1
				if dx > 0 and sx + dx > x1 then
					t = math.min(t, (x1 - sx) / dx)
				elseif dx < 0 and sx + dx < x0 then
					t = math.min(t, (x0 - sx) / dx)
				end
				if dy > 0 and sy + dy > y1 then
					t = math.min(t, (y1 - sy) / dy)
				elseif dy < 0 and sy + dy < y0 then
					t = math.min(t, (y0 - sy) / dy)
				end
				t = math.max(t, 0)
				sg[3], sg[4] = sx + dx * t, sy + dy * t
			end
			drawLinePool(prevLook, n, lookSeg, colorFor(slots.look, nil, true), slots.look.a, 1.5)

			-- velocity line + movement trail: 3D parts that follow the way the avatar faces
			local rootPart = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
			local fwd = Vector3.new(0, 0, -1)
			if rootPart then
				local look = rootPart.CFrame.LookVector
				local flat = Vector3.new(look.X, 0, look.Z)
				if flat.Magnitude > 0.01 then
					fwd = flat.Unit
				end
			end
			local sideV = fwd:Cross(Vector3.new(0, 1, 0))
			local pps = rootPart and pxPerStud(project, rootPart.Position) or 40

			local vn = 0
			if feat.VelLine and rootPart then
				local speed = 22 + 10 * math.sin(now * 1.3)
				local len = math.min(speed * 0.3, opt.velLen, 4)
				local col, op, th = colorOf(slots.vel), slots.vel.a, 2 / pps
				local from = rootPart.Position + fwd * 0.6
				local to = from + fwd * len
				vn = vn + 1
				place3D(velParts, vn, from, to, col, op, th)
				if opt.velArrow == "On" and len > 0.7 then
					local hl = math.min(0.9, len * 0.45)
					local back = -fwd
					local ang = math.rad(28)
					local up = Vector3.new(0, 1, 0)
					local wings = {
						CFrame.fromAxisAngle(up, ang):VectorToWorldSpace(back),
						CFrame.fromAxisAngle(up, -ang):VectorToWorldSpace(back),
						CFrame.fromAxisAngle(sideV, ang):VectorToWorldSpace(back),
						CFrame.fromAxisAngle(sideV, -ang):VectorToWorldSpace(back),
					}
					for _, w in ipairs(wings) do
						vn = vn + 1
						place3D(velParts, vn, to, to + w * hl, col, op, th)
					end
				end
			end
			hide3DPool(velParts, vn + 1)

			local tn = 0
			if feat.Trail and rootPart then
				local foot = rootPart.Position - Vector3.new(0, 2.8, 0)
				local c1 = colorFor(slots.trail, nil, true)
				local c2 = colorOverridden() and c1:Lerp(Color3.new(0, 0, 0), 0.55) or colorOf(slots.trail2)
				local gradient, fade, taper = opt.trailMode == "Gradient", opt.trailFade == "On", opt.trailTaper == "On"
				local cnt = 26
				local prevPt, prevAge
				for i = 1, cnt do
					local age = (i - 1) / (cnt - 1)
					local pt = foot - fwd * (age * 4.2) + sideV * (math.sin(age * 7 - now * 4) * 0.18 * age)
					if prevPt then
						local col, op, th = trailStyle((prevAge + age) / 2, c1, slots.trail.a, c2, slots.trail2.a, gradient, fade, opt.trailWidth, taper)
						tn = tn + 1
						place3D(trailParts, tn, prevPt, pt, col, op, th / pps)
					end
					prevPt, prevAge = pt, age
				end
			end
			hide3DPool(trailParts, tn + 1)

			if feat.HeadDot then
				local hx, hy, hr = computeHead(model, project)
				if hx then
					showDotPreview(hx, hy, hr, colorFor(slots.head, nil, true), slots.head.a, opt.headStyle == "Filled")
				else
					hideDotPreview()
				end
			else
				hideDotPreview()
			end

			n = 0
			if feat.Tracers then
				local ox, oy = tracerOrigin(vpSize.X, vpSize.Y, nil)
				n = computeTracer(model, project, ox, oy)
			end
			drawLinePool(prevTrc, n, tracerSeg, colorFor(slots.trc, nil, true), slots.trc.a, 1)

			-- footstep ring demo: a ring keeps expanding under the avatar's feet
			if feat.Footsteps and rootPart then
				local age = (now % opt.stepLife) / opt.stepLife
				local rn = computeRing(rootPart.Position - Vector3.new(0, 2.9, 0),
					0.6 + easeOut(age) * (math.min(opt.stepRadius, 6) - 0.6), project)
				drawLinePool(prevRing, rn, ringSeg, colorFor(slots.step, nil, true), slots.step.a * (1 - age) ^ 1.5, 1.5)
			else
				hidePool(prevRing)
			end

			-- hit marker demo: shows on every demo hit
			local hitDur = HIT_DUR[opt.hitDur] or 0.5
			if feat.HitMarker and now - ps.hitAt < hitDur then
				local age = (now - ps.hitAt) / hitDur
				local mx, my = vpSize.X / 2, vpSize.Y / 2
				if hasB then
					mx, my = cx, (bnd.minY + bnd.maxY) / 2
				end
				computeHit(mx, my, opt.hitSize, opt.hitStyle, 1 + 0.35 * math.max(0, 1 - age * 5))
				local a = (age < 0.5 and 1 or 1 - (age - 0.5) / 0.5) * slots.hit.a
				drawLinePool(prevHit, 4, hitSeg, colorOf(slots.hit), a, 2)
			else
				hidePool(prevHit)
			end

			-- ================= bars (same layout code as the real ESP) =================
			local side, idx, lastKey = opt.hpSide, 0, nil

			if hasB and (feat.Health or feat.HealthText) then
				local cnt = computeBar("hp", side, idx, frac, healthColor, opt.hpMode == "Gradient")
				if feat.Health then
					drawBarPreview(prevBars.hp, barBg.hp, barRects.hp, cnt, true)
					if opt.hpGhost == "On" then
						local gf = stepGhost(prevGhostState, frac, frameDt)
						if gf - frac > 0.004 then
							computeGhost(frac, gf)
							drawGhostPreview(true)
						else
							drawGhostPreview(false)
						end
					else
						drawGhostPreview(false)
					end
					idx, lastKey = idx + 1, "hp"
				else
					hidePool(prevBars.hp)
					drawGhostPreview(false)
				end
			else
				hidePool(prevBars.hp)
				drawGhostPreview(false)
			end

			if hasB and feat.Health and opt.overheal == "On" then
				local c = colorOf(slots.overheal)
				local cnt = computeBar("ov", side, idx, 0.35 + 0.35 * math.sin(now * 1.1), function() return c end, false)
				drawBarPreview(prevBars.ov, barBg.ov, barRects.ov, cnt, true)
				idx, lastKey = idx + 1, "ov"
			else
				hidePool(prevBars.ov)
			end

			if hasB and feat.Health and opt.shield == "On" then
				local c = colorOf(slots.shield)
				local cnt = computeBar("sh", side, idx, 0.45 + 0.4 * math.sin(now * 0.9), function() return c end, false)
				drawBarPreview(prevBars.sh, barBg.sh, barRects.sh, cnt, true)
				idx, lastKey = idx + 1, "sh"
			else
				hidePool(prevBars.sh)
			end

			local armFrac = 0.6 + 0.4 * math.sin(now * 0.7 + 1.5)
			if hasB and (feat.Armor or feat.ArmorText) then
				local c = colorOf(slots.armor)
				local cnt = computeBar("arm", side, idx, armFrac, function() return c end, false)
				if feat.Armor then
					drawBarPreview(prevBars.arm, barBg.arm, barRects.arm, cnt, true)
					idx, lastKey = idx + 1, "arm"
				else
					hidePool(prevBars.arm)
				end
			else
				hidePool(prevBars.arm)
			end

			-- texts sit outside the whole bar stack
			local edge = barInfo[lastKey or "hp"]
			local horizSide = side == "Left" or side == "Right"
			local hpExtra = 0
			if hasB and feat.HealthText then
				local str = (opt.hpFormat == "Percent") and (math.floor(frac * 100 + 0.5) .. "%") or tostring(math.floor(frac * 100 + 0.5))
				local tw, th = #str * 6.5, 13
				local x, y = textPos(edge, barInfo.hp, tw, th, 0)
				showPreviewText("hpText", str, x, y, 0.5, 0, colorOf(slots.hpText), slots.hpText.a, opt.font)
				hpExtra = horizSide and (tw + 4) or (th + 1)
			else
				hidePreviewText("hpText")
			end
			if hasB and feat.ArmorText then
				local str = (opt.armFormat == "Percent") and (math.floor(armFrac * 100 + 0.5) .. "%") or tostring(math.floor(armFrac * ARMOR_MAX + 0.5))
				local tw, th = #str * 6.5, 13
				local x, y = textPos(edge, barInfo.arm, tw, th, hpExtra)
				showPreviewText("armText", str, x, y, 0.5, 0, colorOf(slots.armText), slots.armText.a, opt.font)
			else
				hidePreviewText("armText")
			end

			local barRoom = idx > 0 and (3 + idx * BAR_STEP) or 0
			local topRoom = side == "Top" and barRoom or 0
			local bottomRoom = side == "Bottom" and barRoom or 0

			if feat.Name and hasB then
				local str = nameText(LocalPlayer)
				if distanceOnName() then
					str = str .. " " .. distanceText(25)
				end
				showPreviewText("name", str, cx, bnd.minY - PAD - 2 - topRoom, 0.5, 1, colorFor(slots.name, nil), slots.name.a, opt.font)
			else
				hidePreviewText("name")
			end

			-- status: top right, cycles through the four words
			if feat.Status and hasB then
				local word, a = stepStatus(prevStatus, STATUS_LIST[math.floor(now / 1.6) % #STATUS_LIST + 1], frameDt)
				showPreviewText("status", word, bnd.maxX + PAD + 4, bnd.minY - PAD, 0, 0, STATUS_COLOR, a, opt.font)
			else
				hidePreviewText("status")
			end

			local by = bnd.maxY + PAD + 2 + bottomRoom
			if feat.Weapon and hasB then
				showPreviewText("weapon", "Weapon", cx, by, 0.5, 0, colorFor(slots.weapon, nil), slots.weapon.a, opt.font)
				by = by + LINE_H
			else
				hidePreviewText("weapon")
			end
			if feat.Distance and not distanceOnName() and hasB then
				showPreviewText("dist", distanceText(25), cx, by, 0.5, 0, colorFor(slots.dist, nil), slots.dist.a, opt.font)
			else
				hidePreviewText("dist")
			end

			-- damage numbers: float up from the head when the demo health changes
			local dur = DMG_DUR[opt.dmgSpeed] or 1.1
			for i = #prevDmg, 1, -1 do
				if now - prevDmg[i].t0 > dur then
					table.remove(prevDmg, i)
				end
			end
			local hx, hy, hr
			if feat.Damage then
				hx, hy, hr = computeHead(model, project)
			end
			for i = 1, 3 do
				local p = prevDmg[i]
				if hx and p then
					local age = (now - p.t0) / dur
					local opacity = age < 0.55 and 1 or math.clamp(1 - (age - 0.55) / 0.45, 0, 1)
					local size = (11 + math.min(p.amt / 10, 5)) * (1 + 0.4 * math.max(0, 1 - age * 4))
					local c = p.heal and colorOf(slots.heal) or colorOf(slots.dmg)
					showPreviewText("dmg" .. i, (p.heal and "+" or "-") .. p.amt, hx + p.dx, hy - hr * 2.2 - easeOut(age) * 30, 0.5, 0.5, c, opacity, opt.font, size)
				else
					hidePreviewText("dmg" .. i)
				end
			end
		end

		-- ====================================================
		-- real ESP (only while the menu is hidden)
		-- ====================================================
		local records = {}

		local chamFolder = Instance.new("Folder")
		chamFolder.Name = "EspChams"
		do
			local parented = false
			pcall(function()
				if typeof(gethui) == "function" then
					chamFolder.Parent = gethui()
					parented = true
				end
			end)
			if not parented then
				pcall(function()
					chamFolder.Parent = game:GetService("CoreGui")
					parented = true
				end)
			end
			if not parented then
				chamFolder.Parent = LocalPlayer:WaitForChild("PlayerGui")
			end
		end
		local chamCfg = {folder = chamFolder}

		local function setZ(obj, z)
			pcall(function() obj.ZIndex = z end)
		end

		local function newLine(z)
			local l = Drawing.new("Line")
			l.Visible = false
			setZ(l, z or 2)
			return l
		end

		local function newSquare(z)
			local sq = Drawing.new("Square")
			sq.Filled = true
			sq.Thickness = 1
			sq.Visible = false
			setZ(sq, z or 2)
			return sq
		end

		local function newCircle(z)
			local c = Drawing.new("Circle")
			pcall(function() c.NumSides = 24 end)
			c.Thickness = 1.5
			c.Filled = false
			c.Visible = false
			setZ(c, z or 2)
			return c
		end

		local function newTriangle()
			local t = Drawing.new("Triangle")
			t.Filled = true
			t.Thickness = 1
			t.Visible = false
			setZ(t, 2)
			return t
		end

		local function newRecord()
			return {
				box = {}, boxShown = 0,
				boxOut = {}, boxOutShown = 0,
				skel = {}, skelShown = 0,
				joint = {}, jointShown = 0,
				trc = {}, trcShown = 0,
				look = {}, lookShown = 0,
				vel = {}, velShown = 0,
				trailLines = {}, trailShown = 0, trail = nil,
				bars = {},
				ghostSq = nil, ghostOn = false, ghost = nil,
				dot = nil, dotOn = false,
				arrow = nil, arrowOn = false,
				cham = nil,
				fillList = {}, fillShown = 0,
				text = {}, textOn = {}, textFont = {},
				status = {},
				hpVal = nil, armVal = nil, ovVal = nil, shVal = nil,
				lastHp = nil, lastChar = nil,
				hitAt = -10, stepAcc = 0,
				visAt = 0, visVal = true,
			}
		end

		local function kill(obj)
			pcall(function() obj:Remove() end)
		end

		local function removeRecord(player)
			local rec = records[player]
			if not rec then
				return
			end
			for _, list in ipairs({rec.box, rec.boxOut, rec.skel, rec.joint, rec.trc, rec.look, rec.vel, rec.trailLines, rec.fillList}) do
				for _, obj in ipairs(list) do
					kill(obj)
				end
			end
			for _, b in pairs(rec.bars) do
				for _, obj in ipairs(b.list) do
					kill(obj)
				end
				if b.bg then kill(b.bg) end
			end
			if rec.ghostSq then kill(rec.ghostSq) end
			if rec.dot then kill(rec.dot) end
			if rec.arrow then kill(rec.arrow) end
			for _, t in pairs(rec.text) do kill(t) end
			if rec.cham then
				pcall(Chams.destroy, rec.cham)
			end
			records[player] = nil
		end

		local function hideText(rec, key)
			if rec.textOn[key] then
				rec.text[key].Visible = false
				rec.textOn[key] = false
			end
		end

		local function hideShown(list, shown)
			for i = 1, shown do
				list[i].Visible = false
			end
		end

		local function hideGhost(rec)
			if rec.ghostOn then
				rec.ghostSq.Visible = false
				rec.ghostOn = false
			end
		end

		-- bars: one entry per kind (hp / ov / sh / arm) with its own squares and background
		local function barState(rec, key)
			local b = rec.bars[key]
			if not b then
				b = {list = {}, shown = 0, bgOn = false}
				rec.bars[key] = b
			end
			return b
		end

		local function hideBarK(rec, key)
			local b = rec.bars[key]
			if b then
				hideShown(b.list, b.shown)
				b.shown = 0
				if b.bgOn then
					b.bg.Visible = false
					b.bgOn = false
				end
			end
			if key == "hp" then
				hideGhost(rec)
			end
		end

		-- keepArrow: the off-screen arrow ignores the visible check
		local function hideRecord(rec, keepArrow)
			hideShown(rec.box, rec.boxShown)
			rec.boxShown = 0
			hideShown(rec.boxOut, rec.boxOutShown)
			rec.boxOutShown = 0
			hideShown(rec.skel, rec.skelShown)
			rec.skelShown = 0
			hideShown(rec.joint, rec.jointShown)
			rec.jointShown = 0
			hideShown(rec.trc, rec.trcShown)
			rec.trcShown = 0
			hideShown(rec.look, rec.lookShown)
			rec.lookShown = 0
			hideShown(rec.vel, rec.velShown)
			rec.velShown = 0
			hideShown(rec.trailLines, rec.trailShown)
			rec.trailShown = 0
			rec.trail = nil
			hideShown(rec.fillList, rec.fillShown)
			rec.fillShown = 0
			for key in pairs(rec.bars) do
				hideBarK(rec, key)
			end
			hideGhost(rec)
			rec.hpVal, rec.armVal, rec.ovVal, rec.shVal, rec.ghost = nil, nil, nil, nil, nil
			if rec.dotOn then
				rec.dot.Visible = false
				rec.dotOn = false
			end
			if rec.arrowOn and not keepArrow then
				rec.arrow.Visible = false
				rec.arrowOn = false
			end
			if rec.cham then
				Chams.hide(rec.cham)
			end
			for key in pairs(rec.text) do
				hideText(rec, key)
			end
		end

		local function hideAll()
			for _, rec in pairs(records) do
				hideRecord(rec)
			end
		end

		local function setLines(list, prevShown, count, src, c, a, thick, z)
			while #list < count do
				table.insert(list, newLine(z))
			end
			local alpha = dAlpha(a * curFade)
			for i = 1, count do
				local sg, l = src[i], list[i]
				l.Color = c
				l.Transparency = alpha
				l.Thickness = thick
				l.From = Vector2.new(sg[1], sg[2])
				l.To = Vector2.new(sg[3], sg[4])
				l.Visible = true
			end
			for i = count + 1, prevShown do
				list[i].Visible = false
			end
			return count
		end

		-- movement trail segments (each has its own color / opacity / thickness)
		local function setTrailLines(list, prevShown, count)
			while #list < count do
				table.insert(list, newLine(2))
			end
			for i = 1, count do
				local s, l = trailSegs[i], list[i]
				l.Color = s[5]
				l.Transparency = dAlpha(s[6] * curFade)
				l.Thickness = s[7]
				l.From = Vector2.new(s[1], s[2])
				l.To = Vector2.new(s[3], s[4])
				l.Visible = true
			end
			for i = count + 1, prevShown do
				list[i].Visible = false
			end
			return count
		end

		-- round dots on the skeleton joints
		local function setCircles(list, prevShown, count, c, a, r)
			while #list < count do
				local ci = newCircle(4)
				ci.Filled = true
				ci.Thickness = 1
				pcall(function() ci.NumSides = 14 end)
				table.insert(list, ci)
			end
			local alpha = dAlpha(a * curFade)
			for i = 1, count do
				local ci = list[i]
				ci.Position = Vector2.new(jointX[i], jointY[i])
				ci.Radius = r
				ci.Color = c
				ci.Transparency = alpha
				ci.Visible = true
			end
			for i = count + 1, prevShown do
				list[i].Visible = false
			end
			return count
		end

		-- colored pieces of a bar
		local function setSquares(list, prevShown, count, rects)
			while #list < count do
				table.insert(list, newSquare(4))
			end
			for i = 1, count do
				local r, sq = rects[i], list[i]
				sq.Position = Vector2.new(r[1], r[2])
				sq.Size = Vector2.new(r[3], r[4])
				sq.Color = r[5]
				sq.Transparency = dAlpha(curFade)
				sq.Visible = true
			end
			for i = count + 1, prevShown do
				list[i].Visible = false
			end
			return count
		end

		-- box fill strips (every rect has its own opacity)
		local function setFill(list, prevShown, count, rects)
			while #list < count do
				table.insert(list, newSquare(1))
			end
			for i = 1, count do
				local r, sq = rects[i], list[i]
				sq.Position = Vector2.new(r[1], r[2])
				sq.Size = Vector2.new(r[3], r[4])
				sq.Color = r[5]
				sq.Transparency = dAlpha(r[6] * curFade)
				sq.Visible = true
			end
			for i = count + 1, prevShown do
				list[i].Visible = false
			end
			return count
		end

		local function drawBarK(rec, key, count)
			local b = barState(rec, key)
			if not b.bg then
				b.bg = newSquare(2)
				b.bg.Color = Color3.fromRGB(10, 10, 12)
			end
			local r = barBg[key]
			b.bg.Transparency = dAlpha(0.7 * curFade)
			b.bg.Position = Vector2.new(r[1], r[2])
			b.bg.Size = Vector2.new(r[3], r[4])
			b.bg.Visible = true
			b.bgOn = true
			b.shown = setSquares(b.list, b.shown, count, barRects[key])
		end

		local function drawGhost(rec)
			if not rec.ghostSq then
				rec.ghostSq = newSquare(3)
			end
			local g = rec.ghostSq
			g.Color = colorOf(slots.ghost)
			g.Transparency = dAlpha(0.95 * curFade)
			g.Position = Vector2.new(ghostRect[1], ghostRect[2])
			g.Size = Vector2.new(ghostRect[3], ghostRect[4])
			g.Visible = true
			rec.ghostOn = true
		end

		local function getText(rec, key, str, c, a, fontName)
			local t = rec.text[key]
			if not t then
				t = Drawing.new("Text")
				t.Size = 13
				t.Center = true
				t.Outline = true
				t.Visible = false
				setZ(t, 5)
				rec.text[key] = t
			end
			if rec.textFont[key] ~= fontName then
				rec.textFont[key] = fontName
				pcall(function() t.Font = DRAW_FONT[fontName] end)
			end
			t.Text = str
			t.Color = c
			t.Transparency = dAlpha(a * curFade)
			return t
		end

		local function showText(rec, key, t, x, y)
			t.Position = Vector2.new(x, y)
			t.Visible = true
			rec.textOn[key] = true
		end

		local function textSize(t, str)
			local ok, tb = pcall(function() return t.TextBounds end)
			if ok and tb and tb.X > 0 then
				return tb.X, tb.Y
			end
			return #str * 6.5, 13
		end

		local function chamColors(player)
			local fill = colorFor(slots.chamFill, player, true)
			local outline
			if colorOverridden() then
				outline = fill:Lerp(Color3.new(1, 1, 1), 0.35)
			else
				outline = colorOf(slots.chamOutline)
			end
			return fill, outline
		end

		-- ====================================================
		-- damage numbers: float up from the head, fade out
		-- ====================================================
		local popups, dmgTexts, dmgFonts = {}, {}, {}

		local function spawnPopup(pos, amount, heal)
			table.insert(popups, {
				pos = pos,
				amt = math.floor(amount + 0.5),
				heal = heal,
				t0 = os.clock(),
				off = Vector3.new((math.random() - 0.5) * 1.4, 0, (math.random() - 0.5) * 1.4),
			})
			if #popups > DMG_MAX then
				table.remove(popups, 1)
			end
		end

		local function popupPos(char, root)
			local head = char:FindFirstChild("Head")
			return (head and head.Position or (root.Position + Vector3.new(0, 1.5, 0))) + Vector3.new(0, 1.2, 0)
		end

		local function hideDamage()
			for _, t in ipairs(dmgTexts) do
				t.Visible = false
			end
		end

		local function updateDamage(project)
			if not feat.Damage then
				table.clear(popups)
				hideDamage()
				return
			end
			local dur = DMG_DUR[opt.dmgSpeed] or 1.1
			local now = os.clock()
			for i = #popups, 1, -1 do
				if now - popups[i].t0 >= dur then
					table.remove(popups, i)
				end
			end
			local used = 0
			for _, p in ipairs(popups) do
				local age = (now - p.t0) / dur
				local x, y, vis = project(p.pos + p.off + Vector3.new(0, easeOut(age) * 2.4, 0))
				if vis then
					used = used + 1
					local t = dmgTexts[used]
					if not t then
						t = Drawing.new("Text")
						t.Center = true
						t.Outline = true
						t.Visible = false
						setZ(t, 6)
						dmgTexts[used] = t
					end
					if dmgFonts[t] ~= opt.font then
						dmgFonts[t] = opt.font
						pcall(function() t.Font = DRAW_FONT[opt.font] end)
					end
					t.Text = (p.heal and "+" or "-") .. p.amt
					t.Color = p.heal and colorOf(slots.heal) or colorOf(slots.dmg)
					t.Size = math.floor((15 + math.min(p.amt / 8, 6)) * (1 + 0.35 * math.max(0, 1 - age * 4)))
					t.Position = Vector2.new(x, y)
					t.Transparency = dAlpha(age < 0.55 and 1 or math.clamp(1 - (age - 0.55) / 0.45, 0, 1))
					t.Visible = true
				end
			end
			for i = used + 1, #dmgTexts do
				dmgTexts[i].Visible = false
			end
		end

		-- ====================================================
		-- hit markers + footstep rings
		-- ====================================================
		local hits, rings, hitLines, ringLines = {}, {}, {}, {}
		local lastShot = -10

		-- a health drop within HIT_WINDOW of your click counts as your hit
		local shotConn = UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				lastShot = os.clock()
			end
		end)

		local function spawnHit(pos, killed)
			table.insert(hits, {t0 = os.clock(), pos = pos, kill = killed})
			if #hits > HIT_MAX then
				table.remove(hits, 1)
			end
		end

		local function spawnRing(pos, color)
			table.insert(rings, {t0 = os.clock(), pos = pos, color = color})
			if #rings > RING_MAX then
				table.remove(rings, 1)
			end
		end

		local function hideLines(list)
			for _, l in ipairs(list) do
				l.Visible = false
			end
		end

		local function updateHits(project, vs)
			if not feat.HitMarker then
				table.clear(hits)
				hideLines(hitLines)
				return
			end
			local dur, now, k = HIT_DUR[opt.hitDur] or 0.5, os.clock(), 0
			for i = #hits, 1, -1 do
				if now - hits[i].t0 >= dur then
					table.remove(hits, i)
				end
			end
			for _, h in ipairs(hits) do
				local age = (now - h.t0) / dur
				local cx, cy, vis = vs.X / 2, vs.Y / 2, true
				if opt.hitAnchor == "Target" then
					cx, cy, vis = project(h.pos)
				end
				if vis then
					computeHit(cx, cy, opt.hitSize, opt.hitStyle, 1 + 0.35 * math.max(0, 1 - age * 5))
					local col = h.kill and colorOf(slots.kill) or colorOf(slots.hit)
					local a = (age < 0.5 and 1 or 1 - (age - 0.5) / 0.5) * slots.hit.a
					for i = 1, 4 do
						k = k + 1
						local l = hitLines[k]
						if not l then
							l = newLine(7)
							hitLines[k] = l
						end
						local s = hitSeg[i]
						l.From = Vector2.new(s[1], s[2])
						l.To = Vector2.new(s[3], s[4])
						l.Color = col
						l.Thickness = 2
						l.Transparency = dAlpha(a)
						l.Visible = true
					end
				end
			end
			for i = k + 1, #hitLines do
				hitLines[i].Visible = false
			end
		end

		local function updateRings(project)
			if not feat.Footsteps then
				table.clear(rings)
				hideLines(ringLines)
				return
			end
			local life, now, k = opt.stepLife, os.clock(), 0
			for i = #rings, 1, -1 do
				if now - rings[i].t0 >= life then
					table.remove(rings, i)
				end
			end
			for _, r in ipairs(rings) do
				local age = (now - r.t0) / life
				local radius = 0.6 + easeOut(age) * (opt.stepRadius - 0.6)
				local a = (1 - age) ^ 1.5 * slots.step.a
				local n = computeRing(r.pos, radius, project)
				for i = 1, n do
					k = k + 1
					local l = ringLines[k]
					if not l then
						l = newLine(2)
						ringLines[k] = l
					end
					local s = ringSeg[i]
					l.From = Vector2.new(s[1], s[2])
					l.To = Vector2.new(s[3], s[4])
					l.Color = r.color
					l.Thickness = 1.5
					l.Transparency = dAlpha(a)
					l.Visible = true
				end
			end
			for i = k + 1, #ringLines do
				ringLines[i].Visible = false
			end
		end

		-- ====================================================
		-- per player. hl = {n = Highlights used this frame}
		-- ====================================================
		local function updatePlayer(player, camera, project, camPos, vs, ox, oy, hl)
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local rec = records[player]

			local pass = char ~= nil and hum ~= nil and root ~= nil
			if pass and opt.dead and hum.Health <= DEAD_HP then
				pass = false -- dead check
			end
			local dist = 0
			if pass then
				dist = (root.Position - camPos).Magnitude
				if teamCheck and player ~= LocalPlayer and sameTeam(player) then
					pass = false
				elseif dist > renderDist then
					pass = false
				end
			end
			if not pass then
				if rec then
					hideRecord(rec)
				end
				return
			end

			if not rec then
				rec = newRecord()
				records[player] = rec
			end
			curFade = fadeFor(dist)
			curVis = nil
			local now = os.clock()
			local maxHp = math.max(hum.MaxHealth, 1)
			local hpFrac = math.clamp(hum.Health / maxHp, 0, 1)

			-- new character (respawn): forget the old health values
			if rec.lastChar ~= char then
				rec.lastChar = char
				rec.lastHp = nil
				rec.hpVal, rec.ghost = nil, nil
				rec.hitAt = -10
			end

			-- health events: damage numbers, hit markers, chams pulse
			if feat.Damage or feat.HitMarker or (feat.Chams and opt.chamPulse == "On") then
				local hp, last = hum.Health, rec.lastHp
				if last then
					if hp < last - 0.5 then
						rec.hitAt = now
						if feat.Damage and last - hp >= 1 then
							spawnPopup(popupPos(char, root), last - hp, false)
						end
						if feat.HitMarker and player ~= LocalPlayer and now - lastShot < HIT_WINDOW then
							spawnHit(popupPos(char, root), hp <= DEAD_HP)
						end
					elseif hp > last + 1.9 and feat.Damage and opt.dmgHeals == "On" and hp > 0 then
						spawnPopup(popupPos(char, root), hp - last, true)
					end
				end
				rec.lastHp = hp
			else
				rec.lastHp = nil
			end

			-- footstep rings: one ring per STRIDE studs walked on the ground
			if feat.Footsteps and (player ~= LocalPlayer or opt.stepSelf == "On") then
				local v = root.AssemblyLinearVelocity
				local hs = Vector3.new(v.X, 0, v.Z).Magnitude
				if hum.FloorMaterial ~= Enum.Material.Air and hs > 4 then
					rec.stepAcc = (rec.stepAcc or 0) + hs * frameDt
					if rec.stepAcc >= STRIDE then
						rec.stepAcc = 0
						local drop = hum.HipHeight > 0 and (hum.HipHeight + root.Size.Y / 2) or 3
						spawnRing(root.Position - Vector3.new(0, drop - 0.05, 0), colorFor(slots.step, player, true))
					end
				end
			end

			-- off-screen arrow (ignores the visible check, not drawn for yourself)
			if feat.Arrows and player ~= LocalPlayer then
				local ax, ay, bx, by, cx, cy = computeArrow(camera, root.Position, vs, ARROW_SIZE[opt.arrowSize], ARROW_RADIUS[opt.arrowRadius])
				if ax then
					local t = rec.arrow
					if not t then
						t = newTriangle()
						rec.arrow = t
					end
					t.PointA = Vector2.new(ax, ay)
					t.PointB = Vector2.new(bx, by)
					t.PointC = Vector2.new(cx, cy)
					t.Color = colorFor(slots.arrow, player)
					t.Transparency = dAlpha(slots.arrow.a * curFade)
					t.Visible = true
					rec.arrowOn = true
				elseif rec.arrowOn then
					rec.arrow.Visible = false
					rec.arrowOn = false
				end
			elseif rec.arrowOn then
				rec.arrow.Visible = false
				rec.arrowOn = false
			end

			-- line of sight (checked a few times a second, not every frame)
			local vis
			if visCheck or feat.VisColors then
				if now >= rec.visAt then
					rec.visAt = now + 0.08
					rec.visVal = isVisible(char, camera)
				end
				vis = rec.visVal
			end
			if visCheck and not vis then
				hideRecord(rec, true)
				return
			end
			curVis = vis

			-- chams (nearest players get the limited Highlights, the rest use materials / wires)
			if feat.Chams then
				chamCfg.fill, chamCfg.outline = chamColors(player)
				chamCfg.mode = opt.chamStyle
				chamCfg.walls = opt.chamWalls == "On"
				chamCfg.fillA, chamCfg.outA = slots.chamFill.a, slots.chamOutline.a
				chamCfg.fade = curFade
				chamCfg.pulse = opt.chamPulse == "On" and math.clamp(1 - (now - (rec.hitAt or -10)) / 0.5, 0, 1) or 0
				chamCfg.pulseColor = colorOf(slots.chamPulse)
				chamCfg.thick = CHAM_THICK[opt.chamThick] or 0
				chamCfg.noHighlight = hl.n >= HL_MAX
				if not chamCfg.noHighlight then
					hl.n = hl.n + 1
				end
				Chams.update(rec, char, chamCfg)
			elseif rec.cham then
				Chams.hide(rec.cham)
			end

			local hasB = needsBounds() and computeBounds(char, project)
			local cx = (bnd.minX + bnd.maxX) / 2

			-- box fill (solid, gradient strips, or colored by health)
			if feat.BoxFill and hasB then
				local c1 = colorFor(slots.fill, player, true)
				local mode = opt.fillMode
				if mode == "Health" then
					if not (feat.VisColors and curVis ~= nil) then
						c1 = healthColor(hpFrac)
					end
					mode = "Solid"
				end
				local c2 = colorOverridden() and c1:Lerp(Color3.new(0, 0, 0), 0.55) or colorOf(slots.fill2)
				local fn = computeFill(mode, c1, slots.fill.a, c2, slots.fill2.a)
				rec.fillShown = setFill(rec.fillList, rec.fillShown, fn, fillRects)
			elseif rec.fillShown > 0 then
				hideShown(rec.fillList, rec.fillShown)
				rec.fillShown = 0
			end

			-- box: shape + pulse (+ dark outline behind it)
			local pm = opt.boxPulse == "On" and pulseMul(now) or 1
			local n = feat.Box and computeBox(char, project, opt.style, hasB, opt.boxShape) or 0
			local outN = (n > 0 and opt.boxOutline == "On") and n or 0
			rec.boxOutShown = setLines(rec.boxOut, rec.boxOutShown, outN, segs, OUTLINE_COLOR, 0.8 * pm, THICKNESS + 2, 2)
			rec.boxShown = setLines(rec.box, rec.boxShown, n, segs, colorFor(slots.box, player, true), slots.box.a * pm,
				THICKNESS * (opt.boxPulse == "On" and (0.85 + 0.35 * pm) or 1), 3)

			-- skeleton (+ joint dots)
			local sn, jn = 0, 0
			if feat.Skeleton then
				sn, jn = computeSkeleton(char, project, opt.joints == "On")
			end
			local skelC = colorFor(slots.skel, player, true)
			rec.skelShown = setLines(rec.skel, rec.skelShown, sn, bones, skelC, slots.skel.a, opt.skelThick, 3)
			rec.jointShown = setCircles(rec.joint, rec.jointShown, jn, skelC, slots.skel.a, 1.5 + opt.skelThick)

			n = feat.LookDir and computeLook(char, project, opt.lookLen) or 0
			rec.lookShown = setLines(rec.look, rec.lookShown, n, lookSeg, colorFor(slots.look, player, true), slots.look.a, 1.5, 3)

			-- velocity line
			n = 0
			if feat.VelLine then
				n = computeVelocity(root.Position, root.AssemblyLinearVelocity, project, opt.velLen, opt.velArrow == "On")
			end
			rec.velShown = setLines(rec.vel, rec.velShown, n, velSeg, colorOf(slots.vel), slots.vel.a, 1.5, 3)

			-- movement trail: remember where the player has been, draw it as a ribbon
			n = 0
			if feat.Trail then
				local life = opt.trailLife
				local foot = root.Position - Vector3.new(0, 3, 0)
				local tr = rec.trail
				if not tr then
					tr = {}
					rec.trail = tr
				end
				local last = tr[#tr]
				if last and (foot - last.p).Magnitude > 25 then
					table.clear(tr) -- teleport / respawn
					last = nil
				end
				if not last or (now - last.t >= math.max(0.03, life / TRAIL_MAX) and (foot - last.p).Magnitude > 0.2) then
					table.insert(tr, {p = foot, t = now})
				end
				while #tr > 0 and now - tr[1].t > life do
					table.remove(tr, 1)
				end
				while #tr > TRAIL_MAX do
					table.remove(tr, 1)
				end
				local cnt = gatherTrail(tr, foot, now, life)
				local c1 = colorFor(slots.trail, player, true)
				local c2 = colorOverridden() and c1:Lerp(Color3.new(0, 0, 0), 0.55) or colorOf(slots.trail2)
				n = computeTrail(cnt, project, c1, slots.trail.a, c2, slots.trail2.a,
					opt.trailMode == "Gradient", opt.trailFade == "On", opt.trailWidth, opt.trailTaper == "On")
			elseif rec.trail then
				rec.trail = nil
			end
			rec.trailShown = setTrailLines(rec.trailLines, rec.trailShown, n)

			if feat.HeadDot then
				local hx, hy, hr = computeHead(char, project)
				if hx then
					local d = rec.dot
					if not d then
						d = newCircle(3)
						rec.dot = d
					end
					d.Position = Vector2.new(hx, hy)
					d.Radius = hr
					d.Filled = opt.headStyle == "Filled"
					d.Color = colorFor(slots.head, player, true)
					d.Transparency = dAlpha(slots.head.a * curFade)
					d.Visible = true
					rec.dotOn = true
				elseif rec.dotOn then
					rec.dot.Visible = false
					rec.dotOn = false
				end
			elseif rec.dotOn then
				rec.dot.Visible = false
				rec.dotOn = false
			end

			n = feat.Tracers and computeTracer(char, project, ox, oy) or 0
			rec.trcShown = setLines(rec.trc, rec.trcShown, n, tracerSeg, colorFor(slots.trc, player, true), slots.trc.a, 1, 2)

			-- ================= bars: health / overheal / shield / armor, on the chosen side =================
			local side, idx, lastKey = opt.hpSide, 0, nil

			if hasB and (feat.Health or feat.HealthText) then
				rec.hpVal = approach(rec.hpVal, math.min(hum.Health, maxHp), frameDt)
				local frac = math.clamp(rec.hpVal / maxHp, 0, 1)
				local cnt = computeBar("hp", side, idx, frac, healthColor, opt.hpMode == "Gradient")
				if feat.Health then
					drawBarK(rec, "hp", cnt)
					if opt.hpGhost == "On" then
						rec.ghost = rec.ghost or {}
						local gf = stepGhost(rec.ghost, frac, frameDt)
						if gf - frac > 0.004 then
							computeGhost(frac, gf)
							drawGhost(rec)
						else
							hideGhost(rec)
						end
					else
						rec.ghost = nil
						hideGhost(rec)
					end
					idx, lastKey = idx + 1, "hp"
				else
					hideBarK(rec, "hp")
					rec.ghost = nil
				end
			else
				rec.hpVal, rec.ghost = nil, nil
				hideBarK(rec, "hp")
			end

			-- overheal: health above max
			if hasB and feat.Health and opt.overheal == "On" and hum.Health > hum.MaxHealth + 0.5 then
				rec.ovVal = approach(rec.ovVal, hum.Health - hum.MaxHealth, frameDt)
				local c = colorOf(slots.overheal)
				local cnt = computeBar("ov", side, idx, math.clamp(rec.ovVal / maxHp, 0, 1), function() return c end, false)
				drawBarK(rec, "ov", cnt)
				idx, lastKey = idx + 1, "ov"
			else
				rec.ovVal = nil
				hideBarK(rec, "ov")
			end

			-- shield
			local shV = (hasB and feat.Health and opt.shield == "On") and shieldValue(char) or nil
			if shV and shV > 0.5 then
				rec.shVal = approach(rec.shVal, shV, frameDt)
				local c = colorOf(slots.shield)
				local cnt = computeBar("sh", side, idx, math.clamp(rec.shVal / SHIELD_MAX, 0, 1), function() return c end, false)
				drawBarK(rec, "sh", cnt)
				idx, lastKey = idx + 1, "sh"
			else
				rec.shVal = nil
				hideBarK(rec, "sh")
			end

			-- armor
			local armHas = false
			if hasB and (feat.Armor or feat.ArmorText) then
				local _, v = armorFrac(char)
				rec.armVal = approach(rec.armVal, v or 0, frameDt)
				armHas = rec.armVal > 0.5
			else
				rec.armVal = nil
			end
			local armFrac = armHas and math.clamp(rec.armVal / ARMOR_MAX, 0, 1) or 0
			if armHas then
				local c = colorOf(slots.armor)
				local cnt = computeBar("arm", side, idx, armFrac, function() return c end, false)
				if feat.Armor then
					drawBarK(rec, "arm", cnt)
					idx, lastKey = idx + 1, "arm"
				else
					hideBarK(rec, "arm")
				end
			else
				hideBarK(rec, "arm")
			end

			-- texts sit outside the whole bar stack
			local edge = barInfo[lastKey or "hp"]
			local horizSide = side == "Left" or side == "Right"
			local hpExtra = 0
			if hasB and feat.HealthText and rec.hpVal then
				local frac = math.clamp(rec.hpVal / maxHp, 0, 1)
				local str = (opt.hpFormat == "Percent") and (math.floor(frac * 100 + 0.5) .. "%") or tostring(math.floor(rec.hpVal + 0.5))
				local t = getText(rec, "hpText", str, colorOf(slots.hpText), slots.hpText.a, opt.font)
				local tw, th = textSize(t, str)
				local x, y = textPos(edge, barInfo.hp, tw, th, 0)
				showText(rec, "hpText", t, x, y)
				hpExtra = horizSide and (tw + 4) or (th + 1)
			else
				hideText(rec, "hpText")
			end
			if armHas and feat.ArmorText then
				local str = (opt.armFormat == "Percent") and (math.floor(armFrac * 100 + 0.5) .. "%") or tostring(math.floor(rec.armVal + 0.5))
				local t = getText(rec, "armText", str, colorOf(slots.armText), slots.armText.a, opt.font)
				local tw, th = textSize(t, str)
				local x, y = textPos(edge, barInfo.arm, tw, th, hpExtra)
				showText(rec, "armText", t, x, y)
			else
				hideText(rec, "armText")
			end

			-- room that top / bottom bars take from the name and the weapon / distance text
			local barRoom = idx > 0 and (3 + idx * BAR_STEP) or 0
			local topRoom = side == "Top" and barRoom or 0
			local bottomRoom = side == "Bottom" and barRoom or 0

			-- name (+ distance when the weapon text is on too)
			if feat.Name and hasB then
				local str = nameText(player)
				if distanceOnName() then
					str = str .. " " .. distanceText(dist)
				end
				local t = getText(rec, "name", str, colorFor(slots.name, player), slots.name.a, opt.font)
				showText(rec, "name", t, cx, bnd.minY - PAD - 16 - topRoom)
			else
				hideText(rec, "name")
			end

			-- status: top right, opposite side of the health bar, fades between words
			if feat.Status and hasB then
				local word, a = stepStatus(rec.status, statusOf(hum, root), frameDt)
				local t = getText(rec, "status", word, STATUS_COLOR, a, opt.font)
				local tw = textSize(t, word)
				showText(rec, "status", t, bnd.maxX + PAD + 4 + tw / 2, bnd.minY - PAD)
			else
				hideText(rec, "status")
			end

			-- weapon, then distance, under the player
			local by = bnd.maxY + PAD + 2 + bottomRoom
			local wStr = (feat.Weapon and hasB) and weaponName(char) or nil
			if wStr then
				local t = getText(rec, "weapon", wStr, colorFor(slots.weapon, player), slots.weapon.a, opt.font)
				showText(rec, "weapon", t, cx, by)
				by = by + LINE_H
			else
				hideText(rec, "weapon")
			end
			if feat.Distance and not distanceOnName() and hasB then
				local t = getText(rec, "dist", distanceText(dist), colorFor(slots.dist, player), slots.dist.a, opt.font)
				showText(rec, "dist", t, cx, by)
			else
				hideText(rec, "dist")
			end
		end

		local wasActive = false
		local function updateEsp()
			local active = hasDrawing and master and anyOn() and win.gui.Parent ~= nil and not win.gui.Enabled
			if not active then
				if wasActive then
					hideAll()
					hideDamage()
					hideLines(hitLines)
					hideLines(ringLines)
					table.clear(popups)
					table.clear(hits)
					table.clear(rings)
					wasActive = false
				end
				return
			end
			wasActive = true

			local camera = workspace.CurrentCamera
			if not camera then
				return
			end
			local project = makeProjector(camera)
			local camPos = camera.CFrame.Position
			local vs = camera.ViewportSize
			local ox, oy = 0, 0
			if feat.Tracers then
				ox, oy = tracerOrigin(vs.X, vs.Y, UserInputService:GetMouseLocation())
			end
			if not opt.self and records[LocalPlayer] then
				hideRecord(records[LocalPlayer])
			end

			-- nearest players first, so they get the limited number of Highlights
			local list = {}
			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer or opt.self then
					local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
					list[#list + 1] = {player, r and (r.Position - camPos).Magnitude or math.huge}
				end
			end
			table.sort(list, function(a, b) return a[2] < b[2] end)
			local hl = {n = 0}
			for _, e in ipairs(list) do
				updatePlayer(e[1], camera, project, camPos, vs, ox, oy, hl)
			end
			curVis = nil
			updateDamage(project)
			updateHits(project, vs)
			updateRings(project)
		end

		local renderConn = RunService.RenderStepped:Connect(function(dt)
			frameDt = dt
			refreshLocks()
			animateItems(dt)
			ui.update()
			updatePreview()
			updateEsp()
		end)
		local removingConn = Players.PlayerRemoving:Connect(removeRecord)
		animateItems(0)

		local function destroy()
			renderConn:Disconnect()
			removingConn:Disconnect()
			moveConn:Disconnect()
			endConn:Disconnect()
			shotConn:Disconnect()
			for player in pairs(records) do
				removeRecord(player)
			end
			for _, t in ipairs(dmgTexts) do
				kill(t)
			end
			for _, l in ipairs(hitLines) do
				kill(l)
			end
			for _, l in ipairs(ringLines) do
				kill(l)
			end
			local pools = {prevBox, prevBoxOut, prevSkel, prevJoint, prevTrc, prevFill, prevLook, prevGhost, prevHit, prevRing}
			for _, pool in pairs(prevBars) do
				table.insert(pools, pool)
			end
			for _, pool in ipairs(pools) do
				for _, f in ipairs(pool) do
					f:Destroy()
				end
			end
			for _, l in pairs(prevTexts) do
				l:Destroy()
			end
			if prevDot then
				prevDot:Destroy()
			end
			Chams.previewDestroy(prevChamState)
			chamFolder:Destroy()
			if folder3D then
				folder3D:Destroy()
			end
			ui.destroy()
			panel:Destroy()
			panelStore:Destroy()
			scroll:Destroy()
		end
		win.onClose(destroy)


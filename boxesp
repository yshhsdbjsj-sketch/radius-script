local Players     = game:GetService("Players")
local RunService  = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera      = workspace.CurrentCamera

local boxes = {}

local R15_PARTS = {
    "Head","UpperTorso","LowerTorso",
    "LeftUpperArm","RightUpperArm","LeftLowerArm","RightLowerArm",
    "LeftHand","RightHand",
    "LeftUpperLeg","RightUpperLeg","LeftLowerLeg","RightLowerLeg",
    "LeftFoot","RightFoot"
}
local R6_PARTS = {
    "Head","Torso","Left Arm","Right Arm","Left Leg","Right Leg"
}

local function newLine()
    local l = Drawing.new("Line")
    l.Color     = Color3.fromRGB(180, 180, 180)
    l.Thickness = 1.5
    l.Visible   = false
    return l
end

local function removeBox(player)
    local data = boxes[player]
    if not data then return end
    for _, l in pairs(data) do pcall(function() l:Remove() end) end
    boxes[player] = nil
end

local function createBox(player)
    removeBox(player)
    boxes[player] = { newLine(), newLine(), newLine(), newLine() }
end

local function getScreenBounds(char)
    local parts = char:FindFirstChild("UpperTorso") and R15_PARTS or R6_PARTS
    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local any = false
    for _, name in ipairs(parts) do
        local part = char:FindFirstChild(name)
        if part then
            local s = part.Size
            local offsets = {
                Vector3.new( s.X/2,  s.Y/2,  s.Z/2), Vector3.new(-s.X/2,  s.Y/2,  s.Z/2),
                Vector3.new( s.X/2, -s.Y/2,  s.Z/2), Vector3.new(-s.X/2, -s.Y/2,  s.Z/2),
                Vector3.new( s.X/2,  s.Y/2, -s.Z/2), Vector3.new(-s.X/2,  s.Y/2, -s.Z/2),
                Vector3.new( s.X/2, -s.Y/2, -s.Z/2), Vector3.new(-s.X/2, -s.Y/2, -s.Z/2),
            }
            for _, offset in ipairs(offsets) do
                local sp, onScreen = Camera:WorldToViewportPoint((part.CFrame * CFrame.new(offset)).Position)
                if onScreen then
                    any = true
                    if sp.X < minX then minX = sp.X end
                    if sp.Y < minY then minY = sp.Y end
                    if sp.X > maxX then maxX = sp.X end
                    if sp.Y > maxY then maxY = sp.Y end
                end
            end
        end
    end
    if any then return minX, minY, maxX, maxY end
    return nil, nil, nil, nil
end

local function onPlayerAdded(player)
    if player == LocalPlayer then return end
    createBox(player)
    player.CharacterAdded:Connect(function()
        task.wait(0.1)
        createBox(player)
    end)
end

for _, p in ipairs(Players:GetPlayers()) do onPlayerAdded(p) end
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(removeBox)

RunService.RenderStepped:Connect(function()
    for player, lines in pairs(boxes) do
        local char = player.Character
        local hum  = char and char:FindFirstChild("Humanoid")
        local minX, minY, maxX, maxY = nil, nil, nil, nil

        if char then
            minX, minY, maxX, maxY = getScreenBounds(char)
        end

        if not minX or not hum or hum.Health <= 0 then
            for _, l in pairs(lines) do l.Visible = false end
            continue
        end

        local tl = Vector2.new(minX - 2, minY - 2)
        local tr = Vector2.new(maxX + 2, minY - 2)
        local bl = Vector2.new(minX - 2, maxY + 2)
        local br = Vector2.new(maxX + 2, maxY + 2)

        lines[1].From = tl; lines[1].To = tr; lines[1].Visible = true
        lines[2].From = bl; lines[2].To = br; lines[2].Visible = true
        lines[3].From = tl; lines[3].To = bl; lines[3].Visible = true
        lines[4].From = tr; lines[4].To = br; lines[4].Visible = true
    end
end)

-- boxesp module (Visuals tab)
-- usage in the main script (unchanged):
--   local buildBoxEsp = loadstring(game:HttpGet(BOXESP_URL))()(lib)
--   buildBoxEsp({pages = pages, fadeInfo = fadeInfo, slideInfo = slideInfo, popup = popup})
--
-- Visuals page = two cards:
--   Card 1:
--     Enabled         master switch - the controls below are locked (faded, unclickable) until it is on
--     Team check      only players who are NOT on your team
--     Visible check   only players you can actually see (raycast)
--     Render distance only players closer than this many studs
--   Card 2 (separate):
--     Box Esp         the box itself (opens the color / style window under the menu)
--
-- behaviour:
--   * while the menu is OPEN the box only shows on the 3D avatar preview
--   * when the menu is HIDDEN (menu toggle key) the box draws on every player that
--     passes the checks
--   * the preview and the real ESP always use the same color and style

return function(lib)
	local Players = lib.Players
	local TweenService = lib.TweenService
	local RunService = lib.RunService
	local UserInputService = lib.UserInputService
	local win = lib.win
	local addCorner, addStroke = lib.addCorner, lib.addStroke
	local TEXT_MAIN = lib.TEXT_MAIN

	local LocalPlayer = Players.LocalPlayer

	local THICKNESS = 1.5
	local PAD = 2
	local SEG_MAX = 12

	local R15_PARTS = {
		"Head", "UpperTorso", "LowerTorso",
		"LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm",
		"LeftHand", "RightHand",
		"LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg",
		"LeftFoot", "RightFoot",
	}
	local R6_PARTS = {"Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}

	-- ========================================================
	-- helpers that don't depend on optional executor APIs
	-- ========================================================
	local function hasBit(n, bit)
		return math.floor(n / bit) % 2 == 1
	end

	local function indexOf(list, value)
		for i, x in ipairs(list) do
			if x == value then
				return i
			end
		end
		return nil
	end

	local function rgbToHsv(c)
		local r, g, b = c.R, c.G, c.B
		local mx, mn = math.max(r, g, b), math.min(r, g, b)
		local d = mx - mn
		local hh = 0
		if d > 0 then
			if mx == r then
				hh = ((g - b) / d) % 6
			elseif mx == g then
				hh = (b - r) / d + 2
			else
				hh = (r - g) / d + 4
			end
			hh = hh / 6
		end
		return hh, (mx == 0) and 0 or d / mx, mx
	end

	-- ========================================================
	-- checks: team / visible
	-- ========================================================
	-- true when the player is on your team (no teams in the game = nobody counts as teammate)
	local function sameTeam(player)
		local myTeam = LocalPlayer.Team
		return myTeam ~= nil and player.Team == myTeam
	end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.IgnoreWater = true

	-- true if a ray from the camera reaches the head or the body of `char` unblocked
	local function isVisible(char, camera)
		local origin = camera.CFrame.Position
		local myChar = LocalPlayer.Character
		rayParams.FilterDescendantsInstances = myChar and {myChar} or {}
		for _, name in ipairs({"Head", "HumanoidRootPart"}) do
			local part = char:FindFirstChild(name)
			if part then
				local hit = workspace:Raycast(origin, part.Position - origin, rayParams)
				if not hit or hit.Instance:IsDescendantOf(char) then
					return true
				end
			end
		end
		return false
	end

	-- ========================================================
	-- geometry: one function turns a character into line segments
	-- (used by both the Drawing ESP and the GUI preview)
	-- ========================================================
	local segs = {}
	for i = 1, SEG_MAX do
		segs[i] = {0, 0, 0, 0}
	end

	local function setSeg(i, ax, ay, bx, by)
		local s = segs[i]
		s[1], s[2], s[3], s[4] = ax, ay, bx, by
	end

	-- project(world) -> x, y, visible
	-- no vpSize -> normal camera (WorldToViewportPoint)
	-- vpSize    -> ViewportFrame camera, projected manually with that frame size
	local function makeProjector(camera, vpSize)
		if vpSize then
			local camCF = camera.CFrame
			local tanHalf = math.tan(math.rad(camera.FieldOfView) / 2)
			local w, h = vpSize.X, vpSize.Y
			local aspect = w / h
			return function(world)
				local rel = camCF:PointToObjectSpace(world)
				if rel.Z >= -0.05 then
					return 0, 0, false
				end
				local d = -rel.Z * tanHalf
				return (rel.X / (d * aspect) * 0.5 + 0.5) * w, (0.5 - rel.Y / d * 0.5) * h, true
			end
		end
		return function(world)
			local sp, onScreen = camera:WorldToViewportPoint(world)
			return sp.X, sp.Y, onScreen
		end
	end

	-- 12 edges of a box; corner c (0-7): bit0 = X, bit1 = Y, bit2 = Z (0 = min, 1 = max)
	local EDGES3D = {}
	for c = 0, 7 do
		for _, bit in ipairs({1, 2, 4}) do
			if not hasBit(c, bit) then
				table.insert(EDGES3D, {c + 1, c + bit + 1})
			end
		end
	end
	local cornerX, cornerY = {}, {}

	-- fills `segs`, returns how many segments to draw (0 = hide)
	local function computeSegments(char, project, style)
		local parts = char:FindFirstChild("UpperTorso") and R15_PARTS or R6_PARTS

		if style == "3D" then
			-- box that rotates with the character (measured in the root part's space)
			local root = char:FindFirstChild("HumanoidRootPart")
				or char:FindFirstChild("UpperTorso")
				or char:FindFirstChild("Torso")
			if not root then
				return 0
			end
			local rootCF = root.CFrame
			local loX, loY, loZ = math.huge, math.huge, math.huge
			local hiX, hiY, hiZ = -math.huge, -math.huge, -math.huge
			local any = false
			for _, name in ipairs(parts) do
				local part = char:FindFirstChild(name)
				if part then
					local cf, half = part.CFrame, part.Size / 2
					for ix = -1, 1, 2 do
						for iy = -1, 1, 2 do
							for iz = -1, 1, 2 do
								local lp = rootCF:PointToObjectSpace(cf:PointToWorldSpace(Vector3.new(half.X * ix, half.Y * iy, half.Z * iz)))
								any = true
								if lp.X < loX then loX = lp.X end
								if lp.Y < loY then loY = lp.Y end
								if lp.Z < loZ then loZ = lp.Z end
								if lp.X > hiX then hiX = lp.X end
								if lp.Y > hiY then hiY = lp.Y end
								if lp.Z > hiZ then hiZ = lp.Z end
							end
						end
					end
				end
			end
			if not any then
				return 0
			end
			for c = 0, 7 do
				local lx = hasBit(c, 1) and hiX or loX
				local ly = hasBit(c, 2) and hiY or loY
				local lz = hasBit(c, 4) and hiZ or loZ
				local x, y, visible = project(rootCF:PointToWorldSpace(Vector3.new(lx, ly, lz)))
				if not visible then
					return 0
				end
				cornerX[c + 1], cornerY[c + 1] = x, y
			end
			for i, e in ipairs(EDGES3D) do
				setSeg(i, cornerX[e[1]], cornerY[e[1]], cornerX[e[2]], cornerY[e[2]])
			end
			return #EDGES3D
		end

		-- 2D boxes (Full / Corners): screen-space bounds of every body part
		local minX, minY = math.huge, math.huge
		local maxX, maxY = -math.huge, -math.huge
		local any = false
		for _, name in ipairs(parts) do
			local part = char:FindFirstChild(name)
			if part then
				local cf, half = part.CFrame, part.Size / 2
				for ix = -1, 1, 2 do
					for iy = -1, 1, 2 do
						for iz = -1, 1, 2 do
							local x, y, visible = project(cf:PointToWorldSpace(Vector3.new(half.X * ix, half.Y * iy, half.Z * iz)))
							if visible then
								any = true
								if x < minX then minX = x end
								if y < minY then minY = y end
								if x > maxX then maxX = x end
								if y > maxY then maxY = y end
							end
						end
					end
				end
			end
		end
		if not any then
			return 0
		end

		local x0, y0, x1, y1 = minX - PAD, minY - PAD, maxX + PAD, maxY + PAD
		if style == "Corners" then
			local cw = math.min((maxX - minX) * 0.25, 12)
			local ch = math.min((maxY - minY) * 0.25, 12)
			setSeg(1, x0, y0, x0 + cw, y0)
			setSeg(2, x0, y0, x0, y0 + ch)
			setSeg(3, x1, y0, x1 - cw, y0)
			setSeg(4, x1, y0, x1, y0 + ch)
			setSeg(5, x0, y1, x0 + cw, y1)
			setSeg(6, x0, y1, x0, y1 - ch)
			setSeg(7, x1, y1, x1 - cw, y1)
			setSeg(8, x1, y1, x1, y1 - ch)
			return 8
		end
		setSeg(1, x0, y0, x1, y0)
		setSeg(2, x0, y1, x1, y1)
		setSeg(3, x0, y0, x0, y1)
		setSeg(4, x1, y0, x1, y1)
		return 4
	end

	return function(ctx)
		local page = ctx.pages["Visuals"]
		local fadeInfo = ctx.fadeInfo
		local slideInfo = ctx.slideInfo or ctx.fadeInfo
		local popup = ctx.popup

		-- ====================================================
		-- state
		-- ====================================================
		local master = false      -- "Enabled": the controls below are locked until this is on
		local enabled = false     -- Box Esp switch
		local teamCheck = false
		local visCheck = false
		local DIST_MIN, DIST_MAX, DIST_STEP = 50, 5000, 50
		local renderDist = 1500

		local style = "Full"
		local h, s, v = 0, 0, 180 / 255 -- default color (180, 180, 180)
		local color = Color3.fromHSV(h, s, v)
		local styleVersion = 0
		local alpha = 1 -- 1 = opaque, 0 = invisible
		-- set to true if your executor's Drawing Transparency is reversed (0 = opaque)
		local DRAWING_ALPHA_INVERTED = false
		local function drawingAlpha()
			return DRAWING_ALPHA_INVERTED and (1 - alpha) or alpha
		end

		local hasDrawing = typeof(Drawing) == "table" or (Drawing ~= nil and Drawing.new ~= nil)
		if not hasDrawing then
			warn("[boxesp] Drawing library not available - only the preview will work")
		end

		-- ====================================================
		-- Visuals page: card 1 (Enabled / checks / distance) + card 2 (Box Esp)
		-- ====================================================
		local CARD_BG = Color3.fromRGB(28, 28, 32)
		local CARD_STROKE = Color3.fromRGB(42, 42, 47)
		local ROW_H, SLIDER_H = 44, 56
		local CARD1_H = 191
		local CARD_GAP = 10

		local card = Instance.new("Frame")
		card.Name = "VisualsCard"
		card.Position = UDim2.fromOffset(20, 66)
		card.Size = UDim2.new(1, -40, 0, CARD1_H)
		card.BackgroundColor3 = CARD_BG
		card.BorderSizePixel = 0
		card.Parent = page
		addCorner(card)
		addStroke(card, CARD_STROKE)

		local boxCard = Instance.new("Frame")
		boxCard.Name = "BoxEspCard"
		boxCard.Position = UDim2.fromOffset(20, 66 + CARD1_H + CARD_GAP)
		boxCard.Size = UDim2.new(1, -40, 0, ROW_H)
		boxCard.BackgroundColor3 = CARD_BG
		boxCard.BorderSizePixel = 0
		boxCard.Parent = page
		addCorner(boxCard)
		addStroke(boxCard, CARD_STROKE)

		local function addRow(y, height, parent)
			local f = Instance.new("Frame")
			f.BackgroundTransparency = 1
			f.Position = UDim2.fromOffset(0, y)
			f.Size = UDim2.new(1, 0, 0, height)
			f.Parent = parent or card
			return f
		end

		local function addSeparator(y)
			local f = Instance.new("Frame")
			f.BackgroundColor3 = CARD_STROKE
			f.BorderSizePixel = 0
			f.Position = UDim2.fromOffset(12, y)
			f.Size = UDim2.new(1, -24, 0, 1)
			f.Parent = card
		end

		-- y == nil -> label is vertically centered across the whole row
		-- y given  -> label sits at that offset with a fixed height (used above the slider)
		local function addRowLabel(parent, text, y)
			local l = Instance.new("TextLabel")
			l.BackgroundTransparency = 1
			l.Position = UDim2.fromOffset(16, y or 0)
			if y then
				l.Size = UDim2.new(0.6, 0, 0, 18)
			else
				l.Size = UDim2.new(0.6, 0, 1, 0)
			end
			l.Font = Enum.Font.GothamMedium
			l.Text = text
			l.TextColor3 = TEXT_MAIN
			l.TextSize = 14
			l.TextXAlignment = Enum.TextXAlignment.Left
			l.Parent = parent
			return l
		end

		local ON_TRACK = Color3.fromRGB(225, 225, 232)
		local OFF_TRACK = Color3.fromRGB(44, 44, 50)
		local ON_KNOB = Color3.fromRGB(22, 22, 25)
		local OFF_KNOB = Color3.fromRGB(140, 140, 146)
		local LOCKED_T = 0.6 -- transparency of a locked control

		-- switch on the right edge of a row; onChange(on) runs on every change
		-- gated = true -> the switch ignores clicks while "Enabled" (master) is off
		local function makeSwitch(parent, onChange, gated)
			local isOn = false

			local switch = Instance.new("TextButton")
			switch.AnchorPoint = Vector2.new(1, 0.5)
			switch.Position = UDim2.new(1, -12, 0.5, 0)
			switch.Size = UDim2.fromOffset(46, 24)
			switch.AutoButtonColor = false
			switch.Text = ""
			switch.BorderSizePixel = 0
			switch.Parent = parent
			addCorner(switch, 7)
			local switchStroke = addStroke(switch, Color3.fromRGB(60, 60, 66))

			local knob = Instance.new("Frame")
			knob.AnchorPoint = Vector2.new(0, 0.5)
			knob.Size = UDim2.fromOffset(18, 18)
			knob.BorderSizePixel = 0
			knob.Parent = switch
			addCorner(knob, 5)

			local locked = false

			local function apply(animate)
				local info = animate and fadeInfo or TweenInfo.new(0)
				TweenService:Create(switch, info, {BackgroundColor3 = isOn and ON_TRACK or OFF_TRACK}):Play()
				TweenService:Create(knob, info, {
					BackgroundColor3 = isOn and ON_KNOB or OFF_KNOB,
					Position = UDim2.new(0, isOn and 25 or 3, 0.5, 0),
				}):Play()
			end
			apply(false)

			switch.MouseEnter:Connect(function()
				if locked then
					return
				end
				TweenService:Create(switchStroke, fadeInfo, {Color = Color3.fromRGB(110, 110, 120)}):Play()
			end)
			switch.MouseLeave:Connect(function()
				TweenService:Create(switchStroke, fadeInfo, {Color = Color3.fromRGB(60, 60, 66)}):Play()
			end)

			local obj = {}
			function obj.Set(value)
				isOn = value and true or false
				apply(true)
				onChange(isOn)
			end
			-- faded look while locked
			function obj.SetLocked(value)
				locked = value
				local t = value and LOCKED_T or 0
				TweenService:Create(switch, fadeInfo, {BackgroundTransparency = t}):Play()
				TweenService:Create(knob, fadeInfo, {BackgroundTransparency = t}):Play()
				TweenService:Create(switchStroke, fadeInfo, {Transparency = t}):Play()
			end
			switch.MouseButton1Click:Connect(function()
				if gated and not master then
					return -- locked while "Enabled" is off
				end
				obj.Set(not isOn)
			end)
			return obj
		end

		-- card 1 rows
		local masterRow = addRow(0, ROW_H)
		addRowLabel(masterRow, "Enabled")
		addSeparator(ROW_H)

		local teamRow = addRow(45, ROW_H)
		addRowLabel(teamRow, "Team check")
		addSeparator(89)

		local visRow = addRow(90, ROW_H)
		addRowLabel(visRow, "Visible check")
		addSeparator(134)

		local distRow = addRow(135, SLIDER_H)
		addRowLabel(distRow, "Render distance", 6)

		-- card 2 row
		local boxRow = addRow(0, ROW_H, boxCard)
		addRowLabel(boxRow, "Box Esp")

		local masterSwitch = makeSwitch(masterRow, function(on)
			master = on
		end, false)
		local teamSwitch = makeSwitch(teamRow, function(on)
			teamCheck = on
		end, true)
		local visSwitch = makeSwitch(visRow, function(on)
			visCheck = on
		end, true)
		local boxSwitch = makeSwitch(boxRow, function(on)
			enabled = on
		end, true)

		-- ---------- render distance slider ----------
		local distValue = Instance.new("TextLabel")
		distValue.BackgroundTransparency = 1
		distValue.AnchorPoint = Vector2.new(1, 0)
		distValue.Position = UDim2.new(1, -16, 0, 6)
		distValue.Size = UDim2.fromOffset(110, 18)
		distValue.Font = Enum.Font.GothamMedium
		distValue.TextColor3 = Color3.fromRGB(190, 190, 196)
		distValue.TextSize = 12
		distValue.TextXAlignment = Enum.TextXAlignment.Right
		distValue.Parent = distRow

		local distTrack = Instance.new("Frame")
		distTrack.Position = UDim2.new(0, 16, 0, 38)
		distTrack.Size = UDim2.new(1, -32, 0, 4)
		distTrack.BackgroundColor3 = OFF_TRACK
		distTrack.BorderSizePixel = 0
		distTrack.Parent = distRow
		addCorner(distTrack, 2)

		local distFill = Instance.new("Frame")
		distFill.BackgroundColor3 = ON_TRACK
		distFill.BorderSizePixel = 0
		distFill.Size = UDim2.fromScale(0, 1)
		distFill.Parent = distTrack
		addCorner(distFill, 2)

		local distKnob = Instance.new("Frame")
		distKnob.AnchorPoint = Vector2.new(0.5, 0.5)
		distKnob.Size = UDim2.fromOffset(12, 12)
		distKnob.BackgroundColor3 = Color3.fromRGB(245, 245, 248)
		distKnob.BorderSizePixel = 0
		distKnob.ZIndex = 2
		distKnob.Parent = distTrack
		addCorner(distKnob, 6)

		local function setDistance(value)
			renderDist = math.clamp(value, DIST_MIN, DIST_MAX)
			local a = (renderDist - DIST_MIN) / (DIST_MAX - DIST_MIN)
			distFill.Size = UDim2.fromScale(a, 1)
			distKnob.Position = UDim2.fromScale(a, 0.5)
			distValue.Text = renderDist .. " studs"
		end
		setDistance(renderDist)

		local distHit = Instance.new("TextButton")
		distHit.BackgroundTransparency = 1
		distHit.AutoButtonColor = false
		distHit.Text = ""
		distHit.Position = UDim2.new(0, 10, 0, 28)
		distHit.Size = UDim2.new(1, -20, 0, 24)
		distHit.ZIndex = 3
		distHit.Parent = distRow

		-- ---------- locking: everything except "Enabled" fades and ignores input while master is off ----------
		local lastLocked
		local function refreshLocks()
			local locked = not master
			if locked == lastLocked then
				return
			end
			lastLocked = locked
			teamSwitch.SetLocked(locked)
			visSwitch.SetLocked(locked)
			boxSwitch.SetLocked(locked)
			local t = locked and LOCKED_T or 0
			TweenService:Create(distTrack, fadeInfo, {BackgroundTransparency = t}):Play()
			TweenService:Create(distFill, fadeInfo, {BackgroundTransparency = t}):Play()
			TweenService:Create(distKnob, fadeInfo, {BackgroundTransparency = t}):Play()
			TweenService:Create(distValue, fadeInfo, {TextTransparency = locked and 0.5 or 0}):Play()
		end
		refreshLocks()

		-- ====================================================
		-- settings window (connected under the main window)
		-- ====================================================
		local SET_H, SET_GAP = 150, 6
		local PANEL_BG = Color3.fromRGB(22, 22, 25)
		local PANEL_STROKE = Color3.fromRGB(42, 42, 47)
		local FIELD_STROKE = Color3.fromRGB(46, 46, 51)
		local TEXT_DIM = Color3.fromRGB(110, 110, 116)
		local TEXT_SOFT = Color3.fromRGB(190, 190, 196)

		local settings = Instance.new("Frame")
		settings.Name = "BoxEspSettings"
		settings.AnchorPoint = Vector2.new(0.5, 0.5)
		settings.Size = UDim2.new(1, 0, 0, SET_H)
		settings.Position = UDim2.new(0.5, 0, 1, SET_GAP + SET_H / 2)
		settings.BackgroundColor3 = PANEL_BG
		settings.BorderSizePixel = 0
		settings.Active = true
		settings.Visible = false
		settings.Parent = win.frame
		addCorner(settings)
		addStroke(settings, PANEL_STROKE)

		local settingsScale = Instance.new("UIScale")
		settingsScale.Scale = 0.92
		settingsScale.Parent = settings

		local function smallLabel(text, x, y)
			local l = Instance.new("TextLabel")
			l.BackgroundTransparency = 1
			l.Position = UDim2.fromOffset(x, y)
			l.Size = UDim2.new(1, -(x + 14), 0, 14)
			l.Font = Enum.Font.GothamBold
			l.Text = text
			l.TextColor3 = TEXT_DIM
			l.TextSize = 11
			l.TextXAlignment = Enum.TextXAlignment.Left
			l.Parent = settings
			return l
		end

		smallLabel("BOX ESP", 14, 10)
		local sep = Instance.new("Frame")
		sep.BackgroundColor3 = Color3.fromRGB(38, 38, 42)
		sep.BorderSizePixel = 0
		sep.Position = UDim2.fromOffset(12, 32)
		sep.Size = UDim2.new(1, -24, 0, 1)
		sep.Parent = settings

		-- ---------- color picker: saturation/value square + hue bar ----------
		local svFrame = Instance.new("Frame")
		svFrame.Name = "SV"
		svFrame.Position = UDim2.fromOffset(14, 44)
		svFrame.Size = UDim2.fromOffset(150, 92)
		svFrame.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svFrame.BorderSizePixel = 0
		svFrame.Parent = settings
		addCorner(svFrame, 4)
		addStroke(svFrame, FIELD_STROKE)

		local white = Instance.new("Frame")
		white.Size = UDim2.fromScale(1, 1)
		white.BackgroundColor3 = Color3.new(1, 1, 1)
		white.BorderSizePixel = 0
		white.Parent = svFrame
		addCorner(white, 4)
		local whiteGradient = Instance.new("UIGradient")
		whiteGradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(1, 1),
		})
		whiteGradient.Parent = white

		local black = Instance.new("Frame")
		black.Size = UDim2.fromScale(1, 1)
		black.BackgroundColor3 = Color3.new(0, 0, 0)
		black.BorderSizePixel = 0
		black.Parent = svFrame
		addCorner(black, 4)
		local blackGradient = Instance.new("UIGradient")
		blackGradient.Rotation = 90
		blackGradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0),
		})

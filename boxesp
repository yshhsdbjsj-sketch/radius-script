				if locked then
					return
				end
				TweenService:Create(switchStroke, fadeInfo, {Color = Color3.fromRGB(110, 110, 120)}):Play()
			end)
			switch.MouseLeave:Connect(function()
				TweenService:Create(switchStroke, fadeInfo, {Color = Color3.fromRGB(60, 60, 66)}):Play()
			end)

			local obj = {}
			function obj.Set(value)
				isOn = value and true or false
				apply(true)
				onChange(isOn)
			end
			function obj.SetLocked(value)
				locked = value
				local t = value and LOCKED_T or 0
				TweenService:Create(switch, fadeInfo, {BackgroundTransparency = t}):Play()

		-- ====================================================
		-- damage numbers: float up from the head, fade out
		-- ====================================================
		local popups, dmgTexts, dmgFonts = {}, {}, {}

		local function spawnPopup(pos, amount, heal)
			table.insert(popups, {
				pos = pos,
				amt = math.floor(amount + 0.5),
				heal = heal,
				t0 = os.clock(),
				off = Vector3.new((math.random() - 0.5) * 1.4, 0, (math.random() - 0.5) * 1.4),
			})
			if #popups > DMG_MAX then
				table.remove(popups, 1)
			end
		end

		local function popupPos(char, root)
			local head = char:FindFirstChild("Head")
			return (head and head.Position or (root.Position + Vector3.new(0, 1.5, 0))) + Vector3.new(0, 1.2, 0)
		end

		local function hideDamage()
			for _, t in ipairs(dmgTexts) do
				t.Visible = false
			end
		end

		local function updateDamage(project)
			if not feat.Damage then
				table.clear(popups)
				hideDamage()
				return
			end
			local dur = DMG_DUR[opt.dmgSpeed] or 1.1
			local now = os.clock()
			for i = #popups, 1, -1 do
				if now - popups[i].t0 >= dur then
					table.remove(popups, i)
				end
			end
			local used = 0
			for _, p in ipairs(popups) do
				local age = (now - p.t0) / dur
				local x, y, vis = project(p.pos + p.off + Vector3.new(0, easeOut(age) * 2.4, 0))
				if vis then
					used = used + 1
					local t = dmgTexts[used]
					if not t then
						t = Drawing.new("Text")
						t.Center = true
						t.Outline = true
						t.Visible = false
						setZ(t, 6)
						dmgTexts[used] = t
					end
					if dmgFonts[t] ~= opt.font then
						dmgFonts[t] = opt.font
						pcall(function() t.Font = DRAW_FONT[opt.font] end)
					end
					t.Text = (p.heal and "+" or "-") .. p.amt
					t.Color = p.heal and colorOf(slots.heal) or colorOf(slots.dmg)
					t.Size = math.floor((15 + math.min(p.amt / 8, 6)) * (1 + 0.35 * math.max(0, 1 - age * 4)))
					t.Position = Vector2.new(x, y)
					t.Transparency = dAlpha(age < 0.55 and 1 or math.clamp(1 - (age - 0.55) / 0.45, 0, 1))
					t.Visible = true
				end
			end
			for i = used + 1, #dmgTexts do
				dmgTexts[i].Visible = false
			end
		end

		-- ====================================================
		-- per player
		-- ====================================================
		local function updatePlayer(player, camera, project, camPos, vs, ox, oy)
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local rec = records[player]

			local pass = char ~= nil and hum ~= nil and root ~= nil
			if pass and opt.dead and hum.Health <= DEAD_HP then
				pass = false -- dead check
			end
			local dist = 0
			if pass then
				dist = (root.Position - camPos).Magnitude
				if teamCheck and player ~= LocalPlayer and sameTeam(player) then
					pass = false
				elseif dist > renderDist then
					pass = false
				end
			end
			if not pass then
				if rec then
					hideRecord(rec)
				end
				return
			end

			if not rec then
				rec = newRecord()
				records[player] = rec
			end
			curFade = fadeFor(dist)
			curVis = nil

			-- new character (respawn): forget the old health values
			if rec.lastChar ~= char then
				rec.lastChar = char
				rec.lastHp = nil
				rec.hpVal, rec.ghost = nil, nil
			end

			-- damage / heal numbers
			if feat.Damage then
				local hp = hum.Health
				local last = rec.lastHp
				if last and hp ~= last then
					local d = last - hp
					if d >= 1 then
						spawnPopup(popupPos(char, root), d, false)
					elseif d <= -2 and opt.dmgHeals == "On" and hp > 0 then
						spawnPopup(popupPos(char, root), -d, true)
					end
				end
				rec.lastHp = hp
			else
				rec.lastHp = nil
			end

			-- off-screen arrow (ignores the visible check, not drawn for yourself)
			if feat.Arrows and player ~= LocalPlayer then
				local ax, ay, bx, by, cx, cy = computeArrow(camera, root.Position, vs, ARROW_SIZE[opt.arrowSize], ARROW_RADIUS[opt.arrowRadius])
				if ax then
					local t = rec.arrow
					if not t then
						t = newTriangle()
						rec.arrow = t
					end
					t.PointA = Vector2.new(ax, ay)
					t.PointB = Vector2.new(bx, by)
					t.PointC = Vector2.new(cx, cy)
					t.Color = colorFor(slots.arrow, player)
					t.Transparency = dAlpha(slots.arrow.a * curFade)
					t.Visible = true
					rec.arrowOn = true
				elseif rec.arrowOn then
					rec.arrow.Visible = false
					rec.arrowOn = false
				end
			elseif rec.arrowOn then
				rec.arrow.Visible = false
				rec.arrowOn = false
			end

			-- line of sight (checked a few times a second, not every frame)
			local vis
			if visCheck or feat.VisColors then
				local now = os.clock()
				if now >= rec.visAt then
					rec.visAt = now + 0.08
					rec.visVal = isVisible(char, camera)
				end
				vis = rec.visVal
			end
			if visCheck and not vis then
				hideRecord(rec, true)
				return
			end
			curVis = vis

			-- chams
			if feat.Chams then
				chamCfg.fill, chamCfg.outline = chamColors(player)
				chamCfg.mode = opt.chamStyle
				chamCfg.walls = opt.chamWalls == "On"
				chamCfg.fillA, chamCfg.outA = slots.chamFill.a, slots.chamOutline.a
				chamCfg.fade = curFade
				Chams.update(rec, char, chamCfg)
			elseif rec.cham then
				Chams.hide(rec.cham)
			end

			local hasB = needsBounds() and computeBounds(char, project)
			local cx = (bnd.minX + bnd.maxX) / 2

			-- box fill (solid or gradient strips)
			if feat.BoxFill and hasB then
				local c1 = colorFor(slots.fill, player, true)
				local c2 = colorOverridden() and c1:Lerp(Color3.new(0, 0, 0), 0.55) or colorOf(slots.fill2)
				local fn = computeFill(opt.fillMode, c1, slots.fill.a, c2, slots.fill2.a)
				rec.fillShown = setFill(rec.fillList, rec.fillShown, fn, fillRects)
			elseif rec.fillShown > 0 then
				hideShown(rec.fillList, rec.fillShown)
				rec.fillShown = 0
			end

			-- box (+ dark outline behind it)
			local n = feat.Box and computeBox(char, project, opt.style, hasB) or 0
			local outN = (n > 0 and opt.boxOutline == "On") and n or 0
			rec.boxOutShown = setLines(rec.boxOut, rec.boxOutShown, outN, segs, OUTLINE_COLOR, 0.8, THICKNESS + 2, 2)
			rec.boxShown = setLines(rec.box, rec.boxShown, n, segs, colorFor(slots.box, player, true), slots.box.a, THICKNESS, 3)

			-- skeleton (+ joint dots)
			local sn, jn = 0, 0
			if feat.Skeleton then
				sn, jn = computeSkeleton(char, project, opt.joints == "On")
			end
			local skelC = colorFor(slots.skel, player, true)
			rec.skelShown = setLines(rec.skel, rec.skelShown, sn, bones, skelC, slots.skel.a, opt.skelThick, 3)
			rec.jointShown = setCircles(rec.joint, rec.jointShown, jn, skelC, slots.skel.a, 1.5 + opt.skelThick)

			n = feat.LookDir and computeLook(char, project, opt.lookLen) or 0
			rec.lookShown = setLines(rec.look, rec.lookShown, n, lookSeg, colorFor(slots.look, player, true), slots.look.a, 1.5, 3)

			-- velocity line
			n = 0
			if feat.VelLine then
				n = computeVelocity(root.Position, root.AssemblyLinearVelocity, project, opt.velLen, opt.velArrow == "On")
			end
			rec.velShown = setLines(rec.vel, rec.velShown, n, velSeg, colorOf(slots.vel), slots.vel.a, 1.5, 3)

			if feat.HeadDot then
				local hx, hy, hr = computeHead(char, project)
				if hx then
					local d = rec.dot
					if not d then
						d = newCircle(3)
						rec.dot = d
					end
					d.Position = Vector2.new(hx, hy)
					d.Radius = hr
					d.Filled = opt.headStyle == "Filled"
					d.Color = colorFor(slots.head, player, true)
					d.Transparency = dAlpha(slots.head.a * curFade)
					d.Visible = true
					rec.dotOn = true
				elseif rec.dotOn then
					rec.dot.Visible = false
					rec.dotOn = false
				end
			elseif rec.dotOn then
				rec.dot.Visible = false
				rec.dotOn = false
			end

			n = feat.Tracers and computeTracer(char, project, ox, oy) or 0
			rec.trcShown = setLines(rec.trc, rec.trcShown, n, tracerSeg, colorFor(slots.trc, player, true), slots.trc.a, 1, 2)

			-- armor bar: the value moves toward the real one a little every frame
			local armHas = false
			if (feat.Armor or feat.ArmorText) and hasB then
				local _, v = armorFrac(char)
				rec.armVal = approach(rec.armVal, v or 0, frameDt)
				armHas = rec.armVal > 0.5
			else
				rec.armVal = nil
			end
			local armFrac = armHas and math.clamp(rec.armVal / ARMOR_MAX, 0, 1) or 0
			local armBarOn = armHas and feat.Armor
			local armN = armHas and computeArmor(armFrac) or 0
			if armBarOn then
				drawBarBg(rec, "armBg", "armBgOn", armBg)
				rec.armShown = setSquares(rec.arm, rec.armShown, armN, armRects)
			else
				hideArmBar(rec)
			end

			-- health bar + text (also smoothed); the ghost bar trails behind after damage
			local hpTextW = 0
			if (feat.Health or feat.HealthText) and hasB then
				rec.hpVal = approach(rec.hpVal, hum.Health, frameDt)
				local frac = math.clamp(rec.hpVal / math.max(hum.MaxHealth, 1), 0, 1)
				n = computeHealth(frac)
				if feat.Health then
					drawBarBg(rec, "hpBg", "hpBgOn", hpBg)
					rec.hpShown = setSquares(rec.hp, rec.hpShown, n, hpRects)
					if opt.hpGhost == "On" then
						rec.ghost = rec.ghost or {}
						local gf = stepGhost(rec.ghost, frac, frameDt)
						if gf - frac > 0.004 then
							computeGhost(frac, gf)
							drawGhost(rec)
						else
							hideGhost(rec)
						end
					else
						rec.ghost = nil
						hideGhost(rec)
					end
				else
					hideHpBar(rec)
					rec.ghost = nil
				end
				if feat.HealthText then
					local str = (opt.hpFormat == "Percent") and (math.floor(frac * 100 + 0.5) .. "%") or tostring(math.floor(rec.hpVal + 0.5))
					local t = getText(rec, "hpText", str, colorOf(slots.hpText), slots.hpText.a, opt.font)
					local tw, th = textSize(t, str)
					hpTextW = tw
					local edge = armBarOn and armInfo.x or hpInfo.x
					local ty = math.clamp(hpInfo.y - th / 2, hpBg[2], math.max(hpBg[2], hpBg[2] + hpBg[4] - th))
					showText(rec, "hpText", t, edge - 3 - tw / 2, ty)
				else
					hideText(rec, "hpText")
				end
			else
				rec.hpVal, rec.ghost = nil, nil
				hideHpBar(rec)
				hideText(rec, "hpText")
			end

			-- armor text: left of the armor bar, further left when the health text is on too
			if armHas and feat.ArmorText then
				local str = (opt.armFormat == "Percent") and (math.floor(armFrac * 100 + 0.5) .. "%") or tostring(math.floor(rec.armVal + 0.5))
				local t = getText(rec, "armText", str, colorOf(slots.armText), slots.armText.a, opt.font)
				local tw, th = textSize(t, str)
				local ty = math.clamp(armInfo.y - th / 2, armBg[2], math.max(armBg[2], armBg[2] + armBg[4] - th))
				showText(rec, "armText", t, armInfo.x - 3 - ((hpTextW > 0) and (hpTextW + 4) or 0) - tw / 2, ty)
			else
				hideText(rec, "armText")
			end

			-- name (+ distance when the weapon text is on too)
			if feat.Name and hasB then
				local str = nameText(player)
				if distanceOnName() then
					str = str .. " " .. distanceText(dist)
				end
				local t = getText(rec, "name", str, colorFor(slots.name, player), slots.name.a, opt.font)
				showText(rec, "name", t, cx, bnd.minY - PAD - 16)
			else
				hideText(rec, "name")
			end

			-- status: top right, opposite side of the health bar, fades between words
			if feat.Status and hasB then
				local word, a = stepStatus(rec.status, statusOf(hum, root), frameDt)
				local t = getText(rec, "status", word, STATUS_COLOR, a, opt.font)
				local tw = textSize(t, word)
				showText(rec, "status", t, bnd.maxX + PAD + 4 + tw / 2, bnd.minY - PAD)
			else
				hideText(rec, "status")
			end

			-- weapon, then distance, under the player
			local by = bnd.maxY + PAD + 2
			local wStr = (feat.Weapon and hasB) and weaponName(char) or nil
			if wStr then
				local t = getText(rec, "weapon", wStr, colorFor(slots.weapon, player), slots.weapon.a, opt.font)
				showText(rec, "weapon", t, cx, by)
				by = by + LINE_H
			else
				hideText(rec, "weapon")
			end
			if feat.Distance and not distanceOnName() and hasB then
				local t = getText(rec, "dist", distanceText(dist), colorFor(slots.dist, player), slots.dist.a, opt.font)
				showText(rec, "dist", t, cx, by)
			else
				hideText(rec, "dist")
			end
		end

		local wasActive = false
		local function updateEsp()
			local active = hasDrawing and master and anyOn() and win.gui.Parent ~= nil and not win.gui.Enabled
			if not active then
				if wasActive then
					hideAll()
					hideDamage()
					table.clear(popups)
					wasActive = false
				end
				return
			end
			wasActive = true

			local camera = workspace.CurrentCamera
			if not camera then
				return
			end
			local project = makeProjector(camera)
			local camPos = camera.CFrame.Position
			local vs = camera.ViewportSize
			local ox, oy = 0, 0
			if feat.Tracers then
				ox, oy = tracerOrigin(vs.X, vs.Y, UserInputService:GetMouseLocation())
			end
			if not opt.self and records[LocalPlayer] then
				hideRecord(records[LocalPlayer])
			end
			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer or opt.self then
					updatePlayer(player, camera, project, camPos, vs, ox, oy)
				end
			end
			curVis = nil
			updateDamage(project)
		end

		local renderConn = RunService.RenderStepped:Connect(function(dt)
			frameDt = dt
			refreshLocks()
			animateItems(dt)
			ui.update()
			updatePreview()
			updateEsp()
		end)
		local removingConn = Players.PlayerRemoving:Connect(removeRecord)
		animateItems(0)

		local function destroy()
			renderConn:Disconnect()
			removingConn:Disconnect()
			moveConn:Disconnect()
			endConn:Disconnect()
			for player in pairs(records) do
				removeRecord(player)
			end
			for _, t in ipairs(dmgTexts) do
				kill(t)
			end
			for _, pool in ipairs({prevBox, prevBoxOut, prevSkel, prevJoint, prevHp, prevTrc, prevFill, prevArmor, prevLook, prevVel, prevGhost}) do
				for _, f in ipairs(pool) do
					f:Destroy()
				end
			end
			for _, l in pairs(prevTexts) do
				l:Destroy()
			end
			if prevDot then
				prevDot:Destroy()
			end
			chamFolder:Destroy()
			ui.destroy()
			scroll:Destroy()
		end
		win.onClose(destroy)

		-- ====================================================
		-- API
		-- ====================================================
		local function setSlot(slot, c)
			local hh, ss, vv = rgbToHsv(c)
			slot.h, slot.s, slot.v = math.min(hh, 0.999), ss, vv
			ui.refresh()
		end

		local function pick(choiceKey, list, name)
			if indexOf(list, name) then
				ui.choices[choiceKey].Set(name)
			end
		end

		local function onOff(choiceKey, value)
			ui.choices[choiceKey].Set(value and "On" or "Off")
		end

		return {
			SetMaster = function(value) sw.master.Set(value) end,
			SetTeamCheck = function(value) sw.team.Set(value) end,
			SetVisibleCheck = function(value) sw.vis.Set(value) end,
			SetDeadCheck = function(value) sw.dead.Set(value) end,
			SetSelfEsp = function(value) sw.self.Set(value) end,
			SetTeamColors = function(value) sw.TeamColors.Set(value) end,
			SetRenderDistance = function(studs)
				setDistance(math.floor(studs / DIST_STEP + 0.5) * DIST_STEP)
			end,
			IsEnabled = function()
				return master and anyOn()
			end,

			-- feature switches
			SetEnabled = function(value) sw.Box.Set(value) end,
			SetBoxEsp = function(value) sw.Box.Set(value) end,
			SetBoxFill = function(value) sw.BoxFill.Set(value) end,
			SetChams = function(value) sw.Chams.Set(value) end,
			SetNameEsp = function(value) sw.Name.Set(value) end,
			SetHealthEsp = function(value) sw.Health.Set(value) end,
			SetArmorBar = function(value) sw.Armor.Set(value) end,
			SetArmorText = function(value) sw.ArmorText.Set(value) end,
			SetHealthText = function(value) sw.HealthText.Set(value) end,
			SetSkeletonEsp = function(value) sw.Skeleton.Set(value) end,
			SetHeadDot = function(value) sw.HeadDot.Set(value) end,
			SetLookDirection = function(value) sw.LookDir.Set(value) end,
			SetVelocityLine = function(value) sw.VelLine.Set(value) end,
			SetTracers = function(value) sw.Tracers.Set(value) end,
			SetArrows = function(value) sw.Arrows.Set(value) end,
			SetDistanceText = function(value) sw.Distance.Set(value) end,
			SetWeaponText = function(value) sw.Weapon.Set(value) end,
			SetStatusText = function(value) sw.Status.Set(value) end,
			SetDamageNumbers = function(value) sw.Damage.Set(value) end,

			-- box
			SetStyle = function(name) pick("style", OPT.styles, name) end,
			SetColor = function(c) setSlot(slots.box, c) end,
			SetAlpha = function(a)
				slots.box.a = math.clamp(a, 0, 1)
				ui.refresh()
			end,
			SetBoxOutline = function(value) onOff("boxOut", value) end,
			SetBoxFillMode = function(name) pick("fillMode", OPT.fillModes, name) end, -- Solid / Fade Down / Fade Up / Two-tone
			SetBoxFillColor = function(c, a)
				setSlot(slots.fill, c)
				if a then
					slots.fill.a = math.clamp(a, 0, 1)
					ui.refresh()
				end
			end,
			SetBoxFillColor2 = function(c, a)
				setSlot(slots.fill2, c)
				if a then
					slots.fill2.a = math.clamp(a, 0, 1)
					ui.refresh()
				end
			end,

			-- visibility colors
			SetVisibleColors = function(value) sw.VisColors.Set(value) end,
			SetVisibleColorSet = function(visible, hidden)
				setSlot(slots.visC, visible)
				if hidden then
					setSlot(slots.hidC, hidden)
				end
			end,

			-- chams
			SetChamsMode = function(name) pick("chamStyle", CHAM_MODES, name) end, -- Normal / Solid / Glow / Textured / Wireframe
			SetChamsStyle = function(name) pick("chamStyle", CHAM_MODES, name) end,
			SetChamsThroughWalls = function(value)
				ui.choices.chamWalls.Set(value and "On" or "Off")
			end,
			SetChamsColors = function(fill, outline, fillAlpha, outlineAlpha)
				setSlot(slots.chamFill, fill)
				if outline then
					setSlot(slots.chamOutline, outline)
				end
				if fillAlpha then
					slots.chamFill.a = math.clamp(fillAlpha, 0, 1)
				end
				if outlineAlpha then
					slots.chamOutline.a = math.clamp(outlineAlpha, 0, 1)
				end
				ui.refresh()
			end,

			-- name
			SetNameSource = function(name) pick("source", OPT.nameSources, name) end,
			SetNameColor = function(c) setSlot(slots.name, c) end,

			-- health / armor
			SetHealthMode = function(name) pick("hpMode", {"Solid", "Gradient"}, name) end,
			SetHealthColors = function(full, mid, low)
				setSlot(slots.hpFull, full)
				setSlot(slots.hpMid, mid)
				setSlot(slots.hpLow, low)
			end,
			SetHealthGhost = function(value) onOff("hpGhost", value) end,
			SetGhostColor = function(c) setSlot(slots.ghost, c) end,
			SetArmorColor = function(c) setSlot(slots.armor, c) end,
			SetArmorTextFormat = function(name) pick("armFormat", OPT.formats, name) end,
			SetArmorTextColor = function(c) setSlot(slots.armText, c) end,
			SetHealthTextFormat = function(name) pick("hpFormat", OPT.formats, name) end,
			SetHealthTextColor = function(c) setSlot(slots.hpText, c) end,

			-- skeleton
			SetSkeletonColor = function(c) setSlot(slots.skel, c) end,
			SetSkeletonThickness = function(name)
				if OPT.thicknesses[name] then
					ui.choices.thick.Set(name)
				end
			end,
			SetJointDots = function(value) onOff("joints", value) end,

			-- head dot / look direction / velocity line
			SetHeadDotStyle = function(name) pick("head", OPT.headStyles, name) end,
			SetHeadDotColor = function(c) setSlot(slots.head, c) end,
			SetLookColor = function(c) setSlot(slots.look, c) end,
			SetLookLength = function(studs) ui.choices.lookLen.Set(studs) end, -- 1 - 20
			SetVelocityLength = function(studs) ui.choices.velLen.Set(studs) end, -- 2 - 14
			SetVelocityArrowhead = function(value) onOff("velArrow", value) end,
			SetVelocityColor = function(c) setSlot(slots.vel, c) end,

			-- tracers / arrows
			SetTracerOrigin = function(name) pick("tracer", OPT.tracerOrigins, name) end,
			SetTracerColor = function(c) setSlot(slots.trc, c) end,
			SetArrowSize = function(name) pick("arrowSize", OPT.arrowSizes, name) end,
			SetArrowDistance = function(name) pick("arrowRadius", OPT.arrowRadii, name) end,
			SetArrowColor = function(c) setSlot(slots.arrow, c) end,

			-- distance / weapon text
			SetDistanceColor = function(c) setSlot(slots.dist, c) end,
			SetWeaponColor = function(c) setSlot(slots.weapon, c) end,

			-- damage numbers
			SetDamageSpeed = function(name) pick("dmgSpeed", OPT.dmgSpeeds, name) end, -- Slow / Normal / Fast
			SetDamageHeals = function(value) onOff("dmgHeals", value) end,
			SetDamageColors = function(damage, heal)
				setSlot(slots.dmg, damage)
				if heal then
					setSlot(slots.heal, heal)
				end
			end,

			SetFont = function(a, b) pick("font", OPT.fonts, b or a) end, -- "UI" / "System" / "Plex" / "Mono"

			-- team colors
			SetTeamColorSource = function(name) pick("teamSource", {"Custom", "Roblox"}, name) end,
			SetTeamColorsCustom = function(ally, enemy)
				setSlot(slots.ally, ally)
				setSlot(slots.enemy, enemy)
			end,

			Destroy = destroy,
		}
	end

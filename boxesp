			SetEnabled = function(value) featSwitch.Box.Set(value) end,
			SetBoxEsp = function(value) featSwitch.Box.Set(value) end,
			SetBoxFill = function(value) featSwitch.BoxFill.Set(value) end,
			SetChams = function(value) featSwitch.Chams.Set(value) end,
			SetNameEsp = function(value) featSwitch.Name.Set(value) end,
			SetHealthEsp = function(value) featSwitch.Health.Set(value) end,
			SetArmorBar = function(value) featSwitch.Armor.Set(value) end,
			SetHealthText = function(value) featSwitch.HealthText.Set(value) end,
			SetSkeletonEsp = function(value) featSwitch.Skeleton.Set(value) end,
			SetHeadDot = function(value) featSwitch.HeadDot.Set(value) end,
			SetLookDirection = function(value) featSwitch.LookDir.Set(value) end,
			SetTracers = function(value) featSwitch.Tracers.Set(value) end,
			SetArrows = function(value) featSwitch.Arrows.Set(value) end,

		end
		local hpBg = {0, 0, 0, 0}
		local armBg = {0, 0, 0, 0}
		local hpInfo = {x = 0, y = 0, bx = 0, bottom = 0, H = 1}
		local armInfo = {x = 0, y = 0}
		local ghostRect = {0, 0, 0, 0}

		-- health bar on the left of the box
		local function computeHealth(frac)
			local top = math.floor(bnd.minY - PAD)
			local bottom = math.floor(bnd.maxY + PAD)
			local H = bottom - top
			local x = math.floor(bnd.minX - PAD - 3 - HP_W)
			hpBg[1], hpBg[2], hpBg[3], hpBg[4] = x - 1, top - 1, HP_W + 2, H + 2
			hpInfo.x = x - 1
			hpInfo.y = bottom - H * math.max(frac, 0)
			hpInfo.bx, hpInfo.bottom, hpInfo.H = x, bottom, H
			return fillBar(hpRects, x, bottom, H, HP_W, frac, healthColor, opt.hpMode == "Gradient")
		end

		-- the part of the bar that was just lost (between the current health and the ghost value)
		local function computeGhost(frac, gf)
			ghostRect[1] = hpInfo.bx
			ghostRect[2] = hpInfo.bottom - hpInfo.H * gf
			ghostRect[3] = HP_W
			ghostRect[4] = hpInfo.H * (gf - frac)
		end

		-- armor bar: same side as the health bar, next to it (takes its place when the health bar is off)
		local function computeArmor(frac)
			local top = math.floor(bnd.minY - PAD)
			local bottom = math.floor(bnd.maxY + PAD)
			local H = bottom - top
			local x = math.floor(bnd.minX - PAD - 3 - HP_W)
			if feat.Health then
				x = x - (HP_W + 3)
			end
			armBg[1], armBg[2], armBg[3], armBg[4] = x - 1, top - 1, HP_W + 2, H + 2
			armInfo.x = x - 1
			armInfo.y = bottom - H * math.max(frac, 0)
			return fillBar(armRects, x, bottom, H, HP_W, frac, armorColor, false)
		end


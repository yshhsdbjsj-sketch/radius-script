		local function findViewport()
			if previewViewport and previewViewport.Parent then
				return previewViewport
			end
			previewViewport = popup and popup:FindFirstChildWhichIsA("ViewportFrame", true) or nil
			return previewViewport
		end

		local function getFrame(pool, i, name, z)
			local f = pool[i]
			if not f then
				f = Instance.new("Frame")
				f.Name = name
				f.BorderSizePixel = 0
				f.Active = false
				f.ZIndex = z or 20
				f.Visible = false
				pool[i] = f
			end
			if f.Parent ~= previewViewport then
				f.Parent = previewViewport
			end
			return f
		end

		-- velocity line + trail + chams in the preview are real 3D parts inside the viewport,
		-- so the avatar covers whatever is behind them
		local folder3D
		local velParts, trailParts = {}, {}

		local function ensure3D()
			if not (folder3D and folder3D.Parent == previewViewport) then
				folder3D = previewViewport:FindFirstChild("EspPreview3D")
				if not folder3D then
					folder3D = Instance.new("Folder")
					folder3D.Name = "EspPreview3D"
					folder3D.Parent = previewViewport
				end
			end
			return folder3D
		end

		local function get3D(pool, i)
			local folder = ensure3D()
			local part = pool[i]
			if not part or not part.Parent then
				part = Instance.new("Part")
				part.Name = "EspSeg"
				part.Anchored = true
				part.CanCollide = false
				part.CanQuery = false
				part.CanTouch = false
				part.CastShadow = false
				part.Material = Enum.Material.Neon
				part.Transparency = 1
				part.Size = Vector3.new(0.05, 0.05, 0.05)
				pool[i] = part
			end
			if part.Parent ~= folder then
				part.Parent = folder
			end
			return part
		end

		local function hide3DPool(pool, from)
			for i = from, #pool do
				pool[i].Transparency = 1
			end
		end

		local function hide3D()
			hide3DPool(velParts, 1)
			hide3DPool(trailParts, 1)
			Chams.previewClear(prevChamState)
		end

		local function place3D(pool, i, a, b, color, opacity, thick)
			local part = get3D(pool, i)
			local len = (b - a).Magnitude
			if len < 0.001 then
				part.Transparency = 1
				return
			end
			part.Size = Vector3.new(thick, thick, len)
			part.CFrame = CFrame.lookAt((a + b) / 2, b)
			part.Color = color
			part.Transparency = 1 - opacity
		end

		-- how many screen pixels one stud is worth near `at`
		local function pxPerStud(project, at)
			local _, y1, v1 = project(at)
			local _, y2, v2 = project(at + Vector3.new(0, 1, 0))
			if v1 and v2 then
				return math.max(math.abs(y2 - y1), 8)
			end
			return 40
		end


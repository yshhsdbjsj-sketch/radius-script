			if opt.tracerFrom == "Center" then
				return w / 2, h / 2
			elseif opt.tracerFrom == "Top" then
				return w / 2, 0
			elseif opt.tracerFrom == "Mouse" and mouse then
				return mouse.X, mouse.Y
			end
			return w / 2, h
		end


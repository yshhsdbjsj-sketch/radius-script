			l.AnchorPoint = Vector2.new(ax, ay)
			l.TextXAlignment = (ax == 1 and Enum.TextXAlignment.Right) or (ax == 0 and Enum.TextXAlignment.Left) or Enum.TextXAlignment.Center
			l.Font = PREVIEW_FONT[fontName] or Enum.Font.GothamMedium
			l.TextSize = size or 12
			l.Text = str
			l.TextColor3 = c
			l.TextTransparency = 1 - a

-- esp module (Visuals tab): Box / Name / Health bar / Skeleton
-- usage in the main script (unchanged):
--   local buildBoxEsp = loadstring(game:HttpGet(BOXESP_URL))()(lib)
--   buildBoxEsp({pages = pages, fadeInfo = fadeInfo, slideInfo = slideInfo, popup = popup})
--
-- Visuals page = two cards:
--   Card 1:
--     Enabled         master switch - everything else is locked (faded, unclickable) until it is on
--     Team check      only players who are NOT on your team
--     Visible check   only players you can actually see (raycast)
--     Render distance only players closer than this many studs
--   Card 2 (one row per feature, each with a switch + a "Settings" button):
--     Box Esp         style (Full / Corners / 3D), color + alpha
--     Name Esp        source (Display / Username / Both), distance on/off, color + alpha
--     Health Bar      mode (Solid / Gradient), Full / Mid / Low colors
--     Skeleton Esp    color + alpha, thickness
--
-- behaviour:
--   * turning a feature on opens its settings window under the menu
--     (turning it off closes it)
--   * while the menu is OPEN the features only show on the 3D avatar preview
--   * when the menu is HIDDEN (menu toggle key) they draw on every player that passes the checks
--   * the preview and the real ESP always use the same colors and styles

return function(lib)
	local Players = lib.Players
	local TweenService = lib.TweenService
	local RunService = lib.RunService
	local UserInputService = lib.UserInputService
	local win = lib.win
	local addCorner, addStroke = lib.addCorner, lib.addStroke
	local TEXT_MAIN = lib.TEXT_MAIN

	local LocalPlayer = Players.LocalPlayer

	local THICKNESS = 1.5
	local PAD = 2
	local SEG_MAX = 12
	local BONE_MAX = 14
	local HP_SEGS = 16 -- gradient resolution of the health bar
	local HP_W = 3     -- health bar width in pixels

	local R15_PARTS = {
		"Head", "UpperTorso", "LowerTorso",
		"LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm",
		"LeftHand", "RightHand",
		"LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg",
		"LeftFoot", "RightFoot",
	}
	local R6_PARTS = {"Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}

	local R15_BONES = {
		{"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
		{"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
		{"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
		{"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
		{"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
	}
	local R6_BONES = {
		{"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
		{"Torso", "Left Leg"}, {"Torso", "Right Leg"},
	}

	-- ========================================================
	-- helpers that don't depend on optional executor APIs
	-- ========================================================
	local function hasBit(n, bit)
		return math.floor(n / bit) % 2 == 1
	end

	local function indexOf(list, value)
		for i, x in ipairs(list) do
			if x == value then
				return i
			end
		end
		return nil
	end

	local function rgbToHsv(c)
		local r, g, b = c.R, c.G, c.B
		local mx, mn = math.max(r, g, b), math.min(r, g, b)
		local d = mx - mn
		local hh = 0
		if d > 0 then
			if mx == r then
				hh = ((g - b) / d) % 6
			elseif mx == g then
				hh = (b - r) / d + 2
			else
				hh = (r - g) / d + 4
			end
			hh = hh / 6
		end
		return hh, (mx == 0) and 0 or d / mx, mx
	end

	-- ========================================================
	-- checks: team / visible
	-- ========================================================
	-- true when the player is on your team (no teams in the game = nobody counts as teammate)
	local function sameTeam(player)
		local myTeam = LocalPlayer.Team
		return myTeam ~= nil and player.Team == myTeam
	end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.IgnoreWater = true

	-- true if a ray from the camera reaches the head or the body of `char` unblocked
	local function isVisible(char, camera)
		local origin = camera.CFrame.Position
		local myChar = LocalPlayer.Character
		rayParams.FilterDescendantsInstances = myChar and {myChar} or {}
		for _, name in ipairs({"Head", "HumanoidRootPart"}) do
			local part = char:FindFirstChild(name)
			if part then
				local hit = workspace:Raycast(origin, part.Position - origin, rayParams)
				if not hit or hit.Instance:IsDescendantOf(char) then
					return true
				end
			end
		end
		return false
	end

	-- ========================================================
	-- geometry: characters -> line segments / bounds
	-- (used by both the Drawing ESP and the GUI preview)
	-- ========================================================
	local segs = {}   -- box segments
	for i = 1, SEG_MAX do
		segs[i] = {0, 0, 0, 0}
	end
	local bones = {}  -- skeleton segments
	for i = 1, BONE_MAX do
		bones[i] = {0, 0, 0, 0}
	end

	local function setSeg(i, ax, ay, bx, by)
		local s = segs[i]
		s[1], s[2], s[3], s[4] = ax, ay, bx, by
	end

	-- project(world) -> x, y, visible
	-- no vpSize -> normal camera (WorldToViewportPoint)
	-- vpSize    -> ViewportFrame camera, projected manually with that frame size
	local function makeProjector(camera, vpSize)
		if vpSize then
			local camCF = camera.CFrame
			local tanHalf = math.tan(math.rad(camera.FieldOfView) / 2)
			local w, h = vpSize.X, vpSize.Y
			local aspect = w / h
			return function(world)
				local rel = camCF:PointToObjectSpace(world)
				if rel.Z >= -0.05 then
					return 0, 0, false
				end
				local d = -rel.Z * tanHalf
				return (rel.X / (d * aspect) * 0.5 + 0.5) * w, (0.5 - rel.Y / d * 0.5) * h, true
			end
		end
		return function(world)
			local sp, onScreen = camera:WorldToViewportPoint(world)
			return sp.X, sp.Y, onScreen
		end
	end

	-- screen-space bounds of every body part (shared by 2D box, name and health bar)
	local bnd = {minX = 0, minY = 0, maxX = 0, maxY = 0}

	local function computeBounds(char, project)
		local parts = char:FindFirstChild("UpperTorso") and R15_PARTS or R6_PARTS
		local minX, minY = math.huge, math.huge
		local maxX, maxY = -math.huge, -math.huge
		local any = false
		for _, name in ipairs(parts) do
			local part = char:FindFirstChild(name)
			if part then
				local cf, half = part.CFrame, part.Size / 2
				for ix = -1, 1, 2 do
					for iy = -1, 1, 2 do
						for iz = -1, 1, 2 do
							local x, y, visible = project(cf:PointToWorldSpace(Vector3.new(half.X * ix, half.Y * iy, half.Z * iz)))
							if visible then
								any = true
								if x < minX then minX = x end
								if y < minY then minY = y end
								if x > maxX then maxX = x end
								if y > maxY then maxY = y end
							end
						end
					end
				end
			end
		end
		if not any then
			return false
		end
		bnd.minX, bnd.minY, bnd.maxX, bnd.maxY = minX, minY, maxX, maxY
		return true
	end

	-- 12 edges of a box; corner c (0-7): bit0 = X, bit1 = Y, bit2 = Z (0 = min, 1 = max)
	local EDGES3D = {}
	for c = 0, 7 do
		for _, bit in ipairs({1, 2, 4}) do
			if not hasBit(c, bit) then
				table.insert(EDGES3D, {c + 1, c + bit + 1})
			end
		end
	end
	local cornerX, cornerY = {}, {}

	-- box that rotates with the character (measured in the root part's space)
	local function computeBox3D(char, project)
		local parts = char:FindFirstChild("UpperTorso") and R15_PARTS or R6_PARTS
		local root = char:FindFirstChild("HumanoidRootPart")
			or char:FindFirstChild("UpperTorso")
			or char:FindFirstChild("Torso")
		if not root then
			return 0
		end
		local rootCF = root.CFrame
		local loX, loY, loZ = math.huge, math.huge, math.huge
		local hiX, hiY, hiZ = -math.huge, -math.huge, -math.huge
		local any = false
		for _, name in ipairs(parts) do
			local part = char:FindFirstChild(name)
			if part then
				local cf, half = part.CFrame, part.Size / 2
				for ix = -1, 1, 2 do
					for iy = -1, 1, 2 do
						for iz = -1, 1, 2 do
							local lp = rootCF:PointToObjectSpace(cf:PointToWorldSpace(Vector3.new(half.X * ix, half.Y * iy, half.Z * iz)))
							any = true
							if lp.X < loX then loX = lp.X end
							if lp.Y < loY then loY = lp.Y end
							if lp.Z < loZ then loZ = lp.Z end
							if lp.X > hiX then hiX = lp.X end
							if lp.Y > hiY then hiY = lp.Y end
							if lp.Z > hiZ then hiZ = lp.Z end
						end
					end
				end
			end
		end
		if not any then
			return 0
		end
		for c = 0, 7 do
			local lx = hasBit(c, 1) and hiX or loX
			local ly = hasBit(c, 2) and hiY or loY
			local lz = hasBit(c, 4) and hiZ or loZ
			local x, y, visible = project(rootCF:PointToWorldSpace(Vector3.new(lx, ly, lz)))
			if not visible then
				return 0
			end
			cornerX[c + 1], cornerY[c + 1] = x, y
		end
		for i, e in ipairs(EDGES3D) do
			setSeg(i, cornerX[e[1]], cornerY[e[1]], cornerX[e[2]], cornerY[e[2]])
		end
		return #EDGES3D
	end

	-- fills `segs`, returns how many segments to draw (0 = hide)
	-- hasBounds = computeBounds() succeeded for this character (needed for 2D styles)
	local function computeBox(char, project, style, hasBounds)
		if style == "3D" then
			return computeBox3D(char, project)
		end
		if not hasBounds then
			return 0
		end
		local minX, minY, maxX, maxY = bnd.minX, bnd.minY, bnd.maxX, bnd.maxY
		local x0, y0, x1, y1 = minX - PAD, minY - PAD, maxX + PAD, maxY + PAD
		if style == "Corners" then
			local cw = math.min((maxX - minX) * 0.25, 12)
			local ch = math.min((maxY - minY) * 0.25, 12)
			setSeg(1, x0, y0, x0 + cw, y0)
			setSeg(2, x0, y0, x0, y0 + ch)
			setSeg(3, x1, y0, x1 - cw, y0)
			setSeg(4, x1, y0, x1, y0 + ch)
			setSeg(5, x0, y1, x0 + cw, y1)
			setSeg(6, x0, y1, x0, y1 - ch)
			setSeg(7, x1, y1, x1 - cw, y1)
			setSeg(8, x1, y1, x1, y1 - ch)
			return 8
		end
		setSeg(1, x0, y0, x1, y0)
		setSeg(2, x0, y1, x1, y1)
		setSeg(3, x0, y0, x0, y1)
		setSeg(4, x1, y0, x1, y1)
		return 4
	end

	-- fills `bones`, returns how many bones to draw
	local function computeSkeleton(char, project)
		local list = char:FindFirstChild("UpperTorso") and R15_BONES or R6_BONES
		local n = 0
		for _, pair in ipairs(list) do
			local a, b = char:FindFirstChild(pair[1]), char:FindFirstChild(pair[2])
			if a and b then
				local ax, ay, av = project(a.Position)
				local bx, by, bv = project(b.Position)
				if av and bv then
					n = n + 1
					local s = bones[n]
					s[1], s[2], s[3], s[4] = ax, ay, bx, by
				end
			end
		end
		return n
	end

	return function(ctx)
		local page = ctx.pages["Visuals"]
		local fadeInfo = ctx.fadeInfo
		local slideInfo = ctx.slideInfo or ctx.fadeInfo
		local popup = ctx.popup

		-- ====================================================
		-- state
		-- ====================================================
		local master = false      -- "Enabled": everything below is locked until this is on
		local teamCheck = false
		local visCheck = false
		local DIST_MIN, DIST_MAX, DIST_STEP = 50, 5000, 50
		local renderDist = 1500

		local FEATURES = {"Box", "Name", "Health", "Skeleton"}
		local LABELS = {Box = "Box Esp", Name = "Name Esp", Health = "Health Bar", Skeleton = "Skeleton Esp"}
		local feat = {Box = false, Name = false, Health = false, Skeleton = false}
		local selected = nil -- which feature's settings window is open

		local style = "Full"          -- Box: Full / Corners / 3D
		local nameSource = "Display"  -- Name: Display / Username / Both
		local nameDist = false        -- Name: append the distance
		local hpMode = "Gradient"     -- Health: Solid / Gradient
		local skelThick = 1           -- Skeleton line thickness

		-- color slots: h/s/v (0-1) + a (1 = opaque, 0 = invisible)
		local function newSlot(c, a)
			local hh, ss, vv = rgbToHsv(c)
			return {h = math.min(hh, 0.999), s = ss, v = vv, a = a or 1}
		end
		local function colorOf(slot)
			return Color3.fromHSV(slot.h, slot.s, slot.v)
		end

		local slots = {
			box = newSlot(Color3.fromRGB(180, 180, 180)),
			name = newSlot(Color3.fromRGB(255, 255, 255)),
			skel = newSlot(Color3.fromRGB(180, 180, 180)),
			hpFull = newSlot(Color3.fromRGB(60, 220, 90)),
			hpMid = newSlot(Color3.fromRGB(240, 210, 60)),
			hpLow = newSlot(Color3.fromRGB(235, 60, 60)),
		}

		local function anyOn()
			return feat.Box or feat.Name or feat.Health or feat.Skeleton
		end

		-- set to true if your executor's Drawing Transparency is reversed (0 = opaque)
		local DRAWING_ALPHA_INVERTED = false
		local function dAlpha(a)
			return DRAWING_ALPHA_INVERTED and (1 - a) or a
		end

		local hasDrawing = typeof(Drawing) == "table" or (Drawing ~= nil and Drawing.new ~= nil)
		if not hasDrawing then
			warn("[esp] Drawing library not available - only the preview will work")
		end

		-- ====================================================
		-- colors / constants
		-- ====================================================
		local CARD_BG = Color3.fromRGB(28, 28, 32)
		local CARD_STROKE = Color3.fromRGB(42, 42, 47)
		local PANEL_BG = Color3.fromRGB(22, 22, 25)
		local PANEL_STROKE = Color3.fromRGB(42, 42, 47)
		local FIELD_STROKE = Color3.fromRGB(46, 46, 51)
		local TEXT_DIM = Color3.fromRGB(110, 110, 116)
		local TEXT_SOFT = Color3.fromRGB(190, 190, 196)
		local ON_TRACK = Color3.fromRGB(225, 225, 232)
		local OFF_TRACK = Color3.fromRGB(44, 44, 50)
		local ON_KNOB = Color3.fromRGB(22, 22, 25)
		local OFF_KNOB = Color3.fromRGB(140, 140, 146)
		local LOCKED_T = 0.6 -- transparency of a locked control
		local ROW_H, SLIDER_H = 44, 56

		local function toHex(c)
			return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
		end

		-- ====================================================
		-- dragging (color pickers + distance slider)
		-- ====================================================
		-- the pointer coordinate space differs between executors/GUI-inset settings,
		-- so on press we pick the candidate that actually lies inside the pressed element
		-- and keep the difference as a calibration offset
		local GuiService = game:GetService("GuiService")
		local dragFn
		local calib = Vector2.new(0, 0)

		local function inside(pos, hit)
			local ap, as = hit.AbsolutePosition, hit.AbsoluteSize
			return pos.X >= ap.X - 1 and pos.X <= ap.X + as.X + 1 and pos.Y >= ap.Y - 1 and pos.Y <= ap.Y + as.Y + 1
		end

		local function calibrate(input, hit)
			local base = UserInputService:GetMouseLocation()
			local inset = Vector2.new(0, 0)
			pcall(function() inset = GuiService:GetGuiInset() end)
			local ip = Vector2.new(input.Position.X, input.Position.Y)
			local candidates = {base, ip, ip + inset, base - inset}
			calib = Vector2.new(0, 0)
			for _, c in ipairs(candidates) do
				if inside(c, hit) then
					calib = c - base
					return
				end
			end
		end

		local function applyDrag()
			if dragFn then
				dragFn(UserInputService:GetMouseLocation() + calib)
			end
		end

		local function isPress(input)
			return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
		end

		-- fn(mousePosition) runs on press and on every move until release
		local function bindDrag(hit, fn)
			hit.InputBegan:Connect(function(input)
				-- locked while "Enabled" is off
				if isPress(input) and master then
					dragFn = fn
					calibrate(input, hit)
					applyDrag()
				end
			end)
		end

		local moveConn = UserInputService.InputChanged:Connect(function(input)
			if dragFn and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				applyDrag()
			end
		end)
		local endConn = UserInputService.InputEnded:Connect(function(input)
			if isPress(input) then
				dragFn = nil
			end
		end)

		-- ====================================================
		-- Visuals page: card 1 (Enabled / checks / distance) + card 2 (features)
		-- ====================================================
		local CARD1_H = 191
		local CARD_GAP = 10
		local FEAT_H = #FEATURES * 45 - 1

		-- scrolling container below the page header; both cards live inside it
		local scroll = Instance.new("ScrollingFrame")
		scroll.Name = "VisualsScroll"
		scroll.BackgroundTransparency = 1
		scroll.BorderSizePixel = 0
		scroll.Position = UDim2.fromOffset(0, 66)
		scroll.Size = UDim2.new(1, 0, 1, -66)
		scroll.CanvasSize = UDim2.fromOffset(0, CARD1_H + CARD_GAP + FEAT_H + 20)
		scroll.ScrollingDirection = Enum.ScrollingDirection.Y
		scroll.ScrollBarThickness = 4
		scroll.ScrollBarImageColor3 = Color3.fromRGB(90, 90, 100)
		scroll.ScrollBarImageTransparency = 0.2
		scroll.ElasticBehavior = Enum.ElasticBehavior.Never
		scroll.VerticalScrollBarInset = Enum.ScrollBarInset.None
		scroll.Parent = page

		local card = Instance.new("Frame")
		card.Name = "VisualsCard"
		card.Position = UDim2.fromOffset(20, 0)
		card.Size = UDim2.new(1, -40, 0, CARD1_H)
		card.BackgroundColor3 = CARD_BG
		card.BorderSizePixel = 0
		card.Parent = scroll
		addCorner(card)
		addStroke(card, CARD_STROKE)

		local featCard = Instance.new("Frame")
		featCard.Name = "EspFeaturesCard"
		featCard.Position = UDim2.fromOffset(20, CARD1_H + CARD_GAP)
		featCard.Size = UDim2.new(1, -40, 0, FEAT_H)
		featCard.BackgroundColor3 = CARD_BG
		featCard.BorderSizePixel = 0
		featCard.Parent = scroll
		addCorner(featCard)
		addStroke(featCard, CARD_STROKE)

		local function addRow(y, height, parent)
			local f = Instance.new("Frame")
			f.BackgroundTransparency = 1
			f.Position = UDim2.fromOffset(0, y)
			f.Size = UDim2.new(1, 0, 0, height)
			f.Parent = parent or card
			return f
		end

		local function addSeparator(y, parent)
			local f = Instance.new("Frame")
			f.BackgroundColor3 = CARD_STROKE
			f.BorderSizePixel = 0
			f.Position = UDim2.fromOffset(12, y)
			f.Size = UDim2.new(1, -24, 0, 1)
			f.Parent = parent or card
		end

		-- y == nil -> label is vertically centered across the whole row
		-- y given  -> label sits at that offset with a fixed height (used above the slider)
		local function addRowLabel(parent, text, y)
			local l = Instance.new("TextLabel")
			l.BackgroundTransparency = 1
			l.Position = UDim2.fromOffset(16, y or 0)
			if y then
				l.Size = UDim2.new(0.5, 0, 0, 18)
			else
				l.Size = UDim2.new(0.5, 0, 1, 0)
			end
			l.Font = Enum.Font.GothamMedium
			l.Text = text
			l.TextColor3 = TEXT_MAIN
			l.TextSize = 14
			l.TextXAlignment = Enum.TextXAlignment.Left
			l.Parent = parent
			return l
		end

		-- switch on the right edge of a row; onChange(on) runs on every change
		-- gated = true -> the switch ignores clicks while "Enabled" (master) is off
		local function makeSwitch(parent, onChange, gated)
			local isOn = false

			local switch = Instance.new("TextButton")
			switch.AnchorPoint = Vector2.new(1, 0.5)
			switch.Position = UDim2.new(1, -12, 0.5, 0)
			switch.Size = UDim2.fromOffset(46, 24)
			switch.AutoButtonColor = false
			switch.Text = ""
			switch.BorderSizePixel = 0
			switch.Parent = parent
			addCorner(switch, 7)
			local switchStroke = addStroke(switch, Color3.fromRGB(60, 60, 66))

			local knob = Instance.new("Frame")
			knob.AnchorPoint = Vector2.new(0, 0.5)
			knob.Size = UDim2.fromOffset(18, 18)
			knob.BorderSizePixel = 0
			knob.Parent = switch
			addCorner(knob, 5)

			local locked = false

			local function apply(animate)
				local info = animate and fadeInfo or TweenInfo.new(0)
				TweenService:Create(switch, info, {BackgroundColor3 = isOn and ON_TRACK or OFF_TRACK}):Play()
				TweenService:Create(knob, info, {
					BackgroundColor3 = isOn and ON_KNOB or OFF_KNOB,
					Position = UDim2.new(0, isOn and 25 or 3, 0.5, 0),
				}):Play()
			end
			apply(false)

			switch.MouseEnter:Connect(function()
				if locked then
					return
				end
				TweenService:Create(switchStroke, fadeInfo, {Color = Color3.fromRGB(110, 110, 120)}):Play()
			end)
			switch.MouseLeave:Connect(function()
				TweenService:Create(switchStroke, fadeInfo, {Color = Color3.fromRGB(60, 60, 66)}):Play()
			end)

			local obj = {}
			function obj.Set(value)
				isOn = value and true or false
				apply(true)
				onChange(isOn)
			end
			-- faded look while locked
			function obj.SetLocked(value)
				locked = value
				local t = value and LOCKED_T or 0
				TweenService:Create(switch, fadeInfo, {BackgroundTransparency = t}):Play()
				TweenService:Create(knob, fadeInfo, {BackgroundTransparency = t}):Play()
				TweenService:Create(switchStroke, fadeInfo, {Transparency = t}):Play()
			end
			switch.MouseButton1Click:Connect(function()
				if gated and not master then
					return -- locked while "Enabled" is off
				end
				obj.Set(not isOn)
			end)
			return obj
		end

		-- card 1 rows
		local masterRow = addRow(0, ROW_H)
		addRowLabel(masterRow, "Enabled")

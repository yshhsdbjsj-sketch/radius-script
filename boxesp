-- esp module (Visuals tab)
-- usage in the main script (unchanged):
--   local buildBoxEsp = loadstring(game:HttpGet(BOXESP_URL))()(lib)
--   buildBoxEsp({pages = pages, fadeInfo = fadeInfo, slideInfo = slideInfo, popup = popup})
--
-- Every option starts OFF. Each module's settings open in their own side panel (the arrow on the row).
-- New in this version: box shapes (Rounded / Dashed / Pulse / Health fill), health bar on any side with
-- overheal + shield bars, chams damage pulse + outline thickness, hit markers, footstep rings,
-- rewritten chams (budgeted Highlights, working preview), side panel + real dropdowns.

return function(lib)
	local Players = lib.Players
	local TweenService = lib.TweenService
	local RunService = lib.RunService
	local UserInputService = lib.UserInputService
	local win = lib.win
	local addCorner, addStroke = lib.addCorner, lib.addStroke
	local TEXT_MAIN = lib.TEXT_MAIN

	local LocalPlayer = Players.LocalPlayer

	local THICKNESS = 1.5
	local PAD = 2
	local SEG_MAX = 96
	local BONE_MAX = 14
	local JOINT_MAX = 15
	local TRAIL_MAX = 40
	local HP_SEGS = 16
	local FILL_SEGS = 14

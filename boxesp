				local ap, as = svHit.AbsolutePosition, svHit.AbsoluteSize
				P.slot.s = math.clamp((m.X - ap.X) / as.X, 0, 1)
				P.slot.v = 1 - math.clamp((m.Y - ap.Y) / as.Y, 0, 1)
				P.Changed()
			end)
			bindDrag(hueHit, function(m)

		local function setZ(obj, z)
			pcall(function() obj.ZIndex = z end)
		end

		local function newLine()
			local l = Drawing.new("Line")
			l.Visible = false
			setZ(l, 2)
			return l
		end

		local function newSquare()
			local sq = Drawing.new("Square")
			sq.Filled = true
			sq.Thickness = 1
			sq.Visible = false
			setZ(sq, 2)
			return sq
		end

		local function newCircle()
			local c = Drawing.new("Circle")
			pcall(function() c.NumSides = 24 end)
			c.Thickness = 1.5
			c.Filled = false
			c.Visible = false
			setZ(c, 2)
			return c
		end

		local function newTriangle()
			local t = Drawing.new("Triangle")
			t.Filled = true
			t.Thickness = 1
			t.Visible = false
			setZ(t, 2)
			return t
		end

		local function newCham()
			local h = Instance.new("Highlight")
			h.Name = "EspCham"
			h.Enabled = false
			h.Parent = chamFolder
			return h
		end

		local function newRecord()
			return {
				box = {}, boxShown = 0,
				skel = {}, skelShown = 0,
				trc = {}, trcShown = 0,
				look = {}, lookShown = 0,
				hp = {}, hpShown = 0, hpBg = nil, hpBgShown = false,
				armor = nil, armorBg = nil, armorOn = false,
				dot = nil, dotOn = false,
				arrow = nil, arrowOn = false,
				cham = nil,
				fill = nil, fillOn = false,
				text = {}, textOn = {}, textFont = {},
			}
		end

		local function removeRecord(player)
			local rec = records[player]
			if not rec then
				return
			end
			local function kill(obj)
				pcall(function() obj:Remove() end)
			end
			for _, l in ipairs(rec.box) do kill(l) end
			for _, l in ipairs(rec.skel) do kill(l) end
			for _, l in ipairs(rec.trc) do kill(l) end
			for _, l in ipairs(rec.look) do kill(l) end
			for _, sq in ipairs(rec.hp) do kill(sq) end
			if rec.hpBg then kill(rec.hpBg) end
			if rec.armor then kill(rec.armor) end
			if rec.armorBg then kill(rec.armorBg) end
			if rec.dot then kill(rec.dot) end
			if rec.arrow then kill(rec.arrow) end
			if rec.fill then kill(rec.fill) end
			for _, t in pairs(rec.text) do kill(t) end
			if rec.cham then
				pcall(function() rec.cham:Destroy() end)
			end
			records[player] = nil
		end

		local function hideText(rec, key)
			if rec.textOn[key] then
				rec.text[key].Visible = false
				rec.textOn[key] = false
			end
		end

		local function hideRecord(rec, keepArrow)
			for i = 1, rec.boxShown do rec.box[i].Visible = false end
			rec.boxShown = 0
			for i = 1, rec.skelShown do rec.skel[i].Visible = false end
			rec.skelShown = 0
			for i = 1, rec.trcShown do rec.trc[i].Visible = false end
			rec.trcShown = 0
			for i = 1, rec.lookShown do rec.look[i].Visible = false end
			rec.lookShown = 0
			for i = 1, rec.hpShown do rec.hp[i].Visible = false end
			rec.hpShown = 0
			if rec.hpBg then rec.hpBg.Visible = false end
			rec.hpBgShown = false
			if rec.armorOn then
				rec.armor.Visible = false
				rec.armorBg.Visible = false
				rec.armorOn = false
			end
			if rec.dotOn then
				rec.dot.Visible = false
				rec.dotOn = false
			end
			if rec.arrowOn and not keepArrow then
				rec.arrow.Visible = false
				rec.arrowOn = false
			end
			if rec.cham then
				rec.cham.Enabled = false
			end
			if rec.fill then rec.fill.Visible = false end
			rec.fillOn = false
			for key in pairs(rec.text) do
				hideText(rec, key)
			end
		end

		local function hideAll()
			for _, rec in pairs(records) do
				hideRecord(rec)
			end
		end

		local function setLines(list, prevShown, count, src, c, a, thick)
			while #list < count do
				table.insert(list, newLine())
			end
			local alpha = dAlpha(a * curFade)
			for i = 1, count do
				local sg, l = src[i], list[i]
				l.Color = c
				l.Transparency = alpha
				l.Thickness = thick
				l.From = Vector2.new(sg[1], sg[2])
				l.To = Vector2.new(sg[3], sg[4])
				l.Visible = true
			end
			for i = count + 1, prevShown do
				list[i].Visible = false
			end
			return count
		end

		local function setSquares(list, prevShown, count)
			while #list < count do
				table.insert(list, newSquare())
			end
			for i = 1, count do
				local r, sq = hpRects[i], list[i]
				sq.Position = Vector2.new(r[1], r[2])
				sq.Size = Vector2.new(r[3], r[4])
				sq.Color = r[5]
				sq.Transparency = dAlpha(curFade)
				sq.Visible = true
			end
			for i = count + 1, prevShown do
				list[i].Visible = false
			end
			return count
		end

		local function getText(rec, key, str, c, a, fontName)
			local t = rec.text[key]
			if not t then
				t = Drawing.new("Text")
				t.Size = 13
				t.Center = true
				t.Outline = true
				t.Visible = false
				setZ(t, 3)
				rec.text[key] = t
			end
			if rec.textFont[key] ~= fontName then
				rec.textFont[key] = fontName
				pcall(function() t.Font = DRAW_FONT[fontName] end)
			end
			t.Text = str
			t.Color = c
			t.Transparency = dAlpha(a * curFade)
			return t
		end

		local function showText(rec, key, t, x, y)
			t.Position = Vector2.new(x, y)
			t.Visible = true
			rec.textOn[key] = true
		end

		local function textSize(t, str)
			local ok, tb = pcall(function() return t.TextBounds end)
			if ok and tb and tb.X > 0 then
				return tb.X, tb.Y
			end
			return #str * 6.5, 13
		end

		local function chamColors(player)
			local fill = colorFor(slots.chamFill, player)
			local outline
			if feat.TeamColors then
				outline = fill:Lerp(Color3.new(1, 1, 1), 0.35)
			else
				outline = colorOf(slots.chamOutline)
			end
			return fill, outline
		end

		local function updatePlayer(player, camera, project, camPos, vs, ox, oy)
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local rec = records[player]

			local pass = char ~= nil and hum ~= nil and root ~= nil and hum.Health > 0
			local dist = 0
			if pass then
				dist = (root.Position - camPos).Magnitude
				if teamCheck and sameTeam(player) then
					pass = false
				elseif dist > renderDist then
					pass = false
				end
			end
			if not pass then
				if rec then
					hideRecord(rec)
				end
				return
			end

			if not rec then
				rec = newRecord()
				records[player] = rec
			end
			curFade = fadeFor(dist)

			-- off-screen arrow (ignores the visible check)
			if feat.Arrows then
				local ax, ay, bx, by, cx, cy = computeArrow(camera, root.Position, vs, ARROW_SIZE[arrowSize], ARROW_RADIUS[arrowRadius])
				if ax then
					local t = rec.arrow
					if not t then
						t = newTriangle()
						rec.arrow = t
					end
					t.PointA = Vector2.new(ax, ay)
					t.PointB = Vector2.new(bx, by)
					t.PointC = Vector2.new(cx, cy)
					t.Color = colorFor(slots.arrow, player)
					t.Transparency = dAlpha(slots.arrow.a * curFade)
					t.Visible = true
					rec.arrowOn = true
				elseif rec.arrowOn then
					rec.arrow.Visible = false
					rec.arrowOn = false
				end
			elseif rec.arrowOn then
				rec.arrow.Visible = false
				rec.arrowOn = false
			end

			if visCheck and not isVisible(char, camera) then
				hideRecord(rec, true)
				return
			end

			-- chams
			if feat.Chams then
				local h = rec.cham
				if not h or not h.Parent then
					h = newCham()
					rec.cham = h
				end
				if h.Adornee ~= char then
					h.Adornee = char
				end
				local fillC, outlineC = chamColors(player)
				local showFill = chamStyle ~= "Outline"
				local showOutline = chamStyle ~= "Fill"
				h.FillColor = fillC
				h.FillTransparency = showFill and (1 - slots.chamFill.a * curFade) or 1
				h.OutlineColor = outlineC
				h.OutlineTransparency = showOutline and (1 - slots.chamOutline.a * curFade) or 1
				h.DepthMode = (chamWalls == "On") and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
				h.Enabled = true
			elseif rec.cham then
				rec.cham.Enabled = false
			end

			local hasB = needsBounds() and computeBounds(char, project)
			local cx = (bnd.minX + bnd.maxX) / 2

			-- box fill
			if feat.BoxFill and hasB then
				local f = rec.fill
				if not f then
					f = newSquare()
					setZ(f, 1)
					rec.fill = f
				end
				f.Color = colorFor(slots.fill, player)
				f.Transparency = dAlpha(slots.fill.a * curFade)
				f.Position = Vector2.new(bnd.minX - PAD, bnd.minY - PAD)
				f.Size = Vector2.new(bnd.maxX - bnd.minX + PAD * 2, bnd.maxY - bnd.minY + PAD * 2)
				f.Visible = true
				rec.fillOn = true
			elseif rec.fillOn then
				rec.fill.Visible = false
				rec.fillOn = false
			end

			-- box
			local n = feat.Box and computeBox(char, project, style, hasB) or 0
			rec.boxShown = setLines(rec.box, rec.boxShown, n, segs, colorFor(slots.box, player), slots.box.a, THICKNESS)

			-- skeleton
			n = feat.Skeleton and computeSkeleton(char, project) or 0
			rec.skelShown = setLines(rec.skel, rec.skelShown, n, bones, colorFor(slots.skel, player), slots.skel.a, skelThick)

			-- look direction
			n = feat.LookDir and computeLook(char, project) or 0
			rec.lookShown = setLines(rec.look, rec.lookShown, n, lookSeg, colorFor(slots.look, player), slots.look.a, 1.5)

			-- head dot
			if feat.HeadDot then
				local hx, hy, hr = computeHead(char, project)
				if hx then
					local d = rec.dot
					if not d then
						d = newCircle()
						rec.dot = d
					end
					d.Position = Vector2.new(hx, hy)
					d.Radius = hr
					d.Filled = headStyle == "Filled"
					d.Color = colorFor(slots.head, player)
					d.Transparency = dAlpha(slots.head.a * curFade)
					d.Visible = true
					rec.dotOn = true
				elseif rec.dotOn then
					rec.dot.Visible = false
					rec.dotOn = false
				end
			elseif rec.dotOn then
				rec.dot.Visible = false
				rec.dotOn = false
			end

			-- tracer
			n = feat.Tracers and computeTracer(char, project, ox, oy) or 0
			rec.trcShown = setLines(rec.trc, rec.trcShown, n, tracerSeg, colorFor(slots.trc, player), slots.trc.a, 1)

			-- health bar + health text
			if (feat.Health or feat.HealthText) and hasB then
				local frac = healthFrac(hum)
				n = computeHealth(frac)
				if feat.Health then
					if not rec.hpBg then
						rec.hpBg = newSquare()
						rec.hpBg.Color = Color3.fromRGB(10, 10, 12)
					end
					rec.hpBg.Transparency = dAlpha(0.7 * curFade)
					rec.hpBg.Position = Vector2.new(hpBg[1], hpBg[2])
					rec.hpBg.Size = Vector2.new(hpBg[3], hpBg[4])
					rec.hpBg.Visible = true
					rec.hpBgShown = true
					rec.hpShown = setSquares(rec.hp, rec.hpShown, n)
				else
					for i = 1, rec.hpShown do rec.hp[i].Visible = false end
					rec.hpShown = 0
					if rec.hpBg and rec.hpBgShown then
						rec.hpBg.Visible = false
						rec.hpBgShown = false
					end
				end
				if feat.HealthText then
					local str = healthText(hum, frac)
					local t = getText(rec, "hpText", str, colorOf(slots.hpText), slots.hpText.a, fonts.HealthText)
					local tw, th = textSize(t, str)
					local ty = math.clamp(hpInfo.y - th / 2, hpBg[2], math.max(hpBg[2], hpBg[2] + hpBg[4] - th))
					showText(rec, "hpText", t, hpInfo.x - 3 - tw / 2, ty)
				else
					hideText(rec, "hpText")
				end
			else
				for i = 1, rec.hpShown do rec.hp[i].Visible = false end
				rec.hpShown = 0
				if rec.hpBg and rec.hpBgShown then
					rec.hpBg.Visible = false
					rec.hpBgShown = false
				end
				hideText(rec, "hpText")
			end

			-- armor bar
			local aFrac = (feat.Armor and hasB) and armorFrac(char) or nil
			if aFrac and aFrac > 0 then
				computeArmor(aFrac)
				if not rec.armorBg then
					rec.armorBg = newSquare()
					rec.armorBg.Color = Color3.fromRGB(10, 10, 12)
					rec.armor = newSquare()
				end
				rec.armorBg.Transparency = dAlpha(0.7 * curFade)
				rec.armorBg.Position = Vector2.new(armBg[1], armBg[2])
				rec.armorBg.Size = Vector2.new(armBg[3], armBg[4])
				rec.armorBg.Visible = true
				rec.armor.Color = colorOf(slots.armor)
				rec.armor.Transparency = dAlpha(slots.armor.a * curFade)
				rec.armor.Position = Vector2.new(armRect[1], armRect[2])
				rec.armor.Size = Vector2.new(armRect[3], armRect[4])
				rec.armor.Visible = true
				rec.armorOn = true
			elseif rec.armorOn then
				rec.armor.Visible = false
				rec.armorBg.Visible = false
				rec.armorOn = false
			end

			-- name
			if feat.Name and hasB then
				local str = nameText(player)
				if distanceOnName() then
					str = str .. " " .. distanceText(dist)
				end
				local t = getText(rec, "name", str, colorFor(slots.name, player), slots.name.a, fonts.Name)
				showText(rec, "name", t, cx, bnd.minY - PAD - 16)
			else
				hideText(rec, "name")
			end

			-- weapon + distance under the player
			local by = bnd.maxY + PAD + 2
			local wStr = (feat.Weapon and hasB) and weaponName(char) or nil
			if wStr then
				local t = getText(rec, "weapon", wStr, colorFor(slots.weapon, player), slots.weapon.a, fonts.Weapon)
				showText(rec, "weapon", t, cx, by)
				by = by + LINE_H
			else
				hideText(rec, "weapon")
			end
			if feat.Distance and not distanceOnName() and hasB then
				local t = getText(rec, "dist", distanceText(dist), colorFor(slots.dist, player), slots.dist.a, fonts.Distance)
				showText(rec, "dist", t, cx, by)
			else
				hideText(rec, "dist")
			end
		end

		local wasActive = false
		local function updateEsp()
			local active = hasDrawing and master and anyOn() and win.gui.Parent ~= nil and not win.gui.Enabled
			if not active then
				if wasActive then
					hideAll()
					wasActive = false
				end
				return
			end
			wasActive = true

			local camera = workspace.CurrentCamera
			if not camera then
				return
			end
			local project = makeProjector(camera)
			local camPos = camera.CFrame.Position
			local vs = camera.ViewportSize
			local ox, oy = 0, 0
			if feat.Tracers then
				ox, oy = tracerOrigin(vs.X, vs.Y, UserInputService:GetMouseLocation())
			end
			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer then
					updatePlayer(player, camera, project, camPos, vs, ox, oy)
				end
			end
		end

		local renderConn = RunService.RenderStepped:Connect(function()
			refreshLocks()
			updateSettings()
			updatePreview()
			updateEsp()
		end)
		local removingConn = Players.PlayerRemoving:Connect(removeRecord)

		local function destroy()
			renderConn:Disconnect()
			removingConn:Disconnect()
			moveConn:Disconnect()
			endConn:Disconnect()
			for player in pairs(records) do
				removeRecord(player)
			end
			for _, pool in ipairs({prevBox, prevSkel, prevHp, prevTrc, prevFill, prevArmor, prevLook}) do
				for _, f in ipairs(pool) do
					f:Destroy()
				end
			end
			for _, l in pairs(prevTexts) do
				l:Destroy()
			end
			if prevDot then
				prevDot:Destroy()
			end
			chamFolder:Destroy()
			settings:Destroy()
			scroll:Destroy()
		end
		win.onClose(destroy)


		-- Visibility colors beat the feature's own color (useVis = this element takes part);
		-- Team colors off -> own color; "Custom" -> ally / enemy; "Roblox" -> team color
		local function colorFor(slot, player, useVis)
			if useVis and feat.VisColors and curVis ~= nil then
				return curVis and colorOf(slots.visC) or colorOf(slots.hidC)
			end
			if feat.TeamColors then
				if opt.teamSource == "Roblox" then
					local p = player or LocalPlayer
					if p.Team then
						return p.TeamColor.Color
					end
				elseif player then
					return (player == LocalPlayer or sameTeam(player)) and colorOf(slots.ally) or colorOf(slots.enemy)
				else
					return colorOf(slots.enemy)
				end
			end
			return colorOf(slot)
		end


			-- alpha (transparency) bar
			local alphaFill, alphaCursor, alphaHit
			if withAlpha then
				local alphaFrame = Instance.new("Frame")
				alphaFrame.Name = "Alpha"
				alphaFrame.Position = UDim2.fromOffset(194, 44)
				alphaFrame.Size = UDim2.fromOffset(14, pickH)

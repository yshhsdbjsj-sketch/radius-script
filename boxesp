		-- t: 0 = low, 0.5 = mid, 1 = full
		local function healthColor(t)
			local lo, mid, hi = colorOf(slots.hpLow), colorOf(slots.hpMid), colorOf(slots.hpFull)
			if t < 0.5 then
				return lo:Lerp(mid, t * 2)
			end
			return mid:Lerp(hi, (t - 0.5) * 2)
		end


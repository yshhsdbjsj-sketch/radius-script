		local function setZ(obj, z)
			pcall(function() obj.ZIndex = z end)
		end

		local function newLine(z)
			local l = Drawing.new("Line")
			l.Visible = false
			setZ(l, z or 2)
			return l
		end

		local function newSquare(z)
			local sq = Drawing.new("Square")
			sq.Filled = true
			sq.Thickness = 1
			sq.Visible = false
			setZ(sq, z or 2)
			return sq
		end

		local function newCircle(z)
			local c = Drawing.new("Circle")
			pcall(function() c.NumSides = 24 end)
			c.Thickness = 1.5
			c.Filled = false
			c.Visible = false
			setZ(c, z or 2)
			return c
		end

		local function newTriangle()
			local t = Drawing.new("Triangle")
			t.Filled = true
			t.Thickness = 1
			t.Visible = false
			setZ(t, 2)
			return t
		end

		local function newRecord()
			return {
				box = {}, boxShown = 0,
				boxOut = {}, boxOutShown = 0,
				skel = {}, skelShown = 0,
				joint = {}, jointShown = 0,
				trc = {}, trcShown = 0,
				look = {}, lookShown = 0,
				vel = {}, velShown = 0,
				hp = {}, hpShown = 0, hpBg = nil, hpBgOn = false,
				ghostSq = nil, ghostOn = false, ghost = nil,
				arm = {}, armShown = 0, armBg = nil, armBgOn = false,
				dot = nil, dotOn = false,
				arrow = nil, arrowOn = false,
				cham = nil,
				fillList = {}, fillShown = 0,
				text = {}, textOn = {}, textFont = {},
				status = {},
				hpVal = nil, armVal = nil,
				lastHp = nil, lastChar = nil,
				visAt = 0, visVal = true,
			}
		end

		local function kill(obj)
			pcall(function() obj:Remove() end)
		end

		local function removeRecord(player)
			local rec = records[player]
			if not rec then
				return
			end
			for _, list in ipairs({rec.box, rec.boxOut, rec.skel, rec.joint, rec.trc, rec.look, rec.vel, rec.hp, rec.arm, rec.fillList}) do
				for _, obj in ipairs(list) do
					kill(obj)
				end
			end
			if rec.hpBg then kill(rec.hpBg) end
			if rec.armBg then kill(rec.armBg) end
			if rec.ghostSq then kill(rec.ghostSq) end
			if rec.dot then kill(rec.dot) end
			if rec.arrow then kill(rec.arrow) end
			for _, t in pairs(rec.text) do kill(t) end
			if rec.cham then
				pcall(Chams.destroy, rec.cham)
			end
			records[player] = nil
		end

		local function hideText(rec, key)
			if rec.textOn[key] then
				rec.text[key].Visible = false
				rec.textOn[key] = false
			end
		end

		local function hideShown(list, shown)
			for i = 1, shown do
				list[i].Visible = false
			end
		end

		local function hideGhost(rec)
			if rec.ghostOn then
				rec.ghostSq.Visible = false
				rec.ghostOn = false
			end
		end

		local function hideHpBar(rec)
			hideShown(rec.hp, rec.hpShown)
			rec.hpShown = 0
			if rec.hpBgOn then
				rec.hpBg.Visible = false
				rec.hpBgOn = false
			end
			hideGhost(rec)
		end

		local function hideArmBar(rec)
			hideShown(rec.arm, rec.armShown)
			rec.armShown = 0
			if rec.armBgOn then
				rec.armBg.Visible = false
				rec.armBgOn = false
			end
		end

		-- keepArrow: the off-screen arrow ignores the visible check
		local function hideRecord(rec, keepArrow)
			hideShown(rec.box, rec.boxShown)
			rec.boxShown = 0
			hideShown(rec.boxOut, rec.boxOutShown)
			rec.boxOutShown = 0
			hideShown(rec.skel, rec.skelShown)
			rec.skelShown = 0
			hideShown(rec.joint, rec.jointShown)
			rec.jointShown = 0
			hideShown(rec.trc, rec.trcShown)
			rec.trcShown = 0
			hideShown(rec.look, rec.lookShown)
			rec.lookShown = 0
			hideShown(rec.vel, rec.velShown)
			rec.velShown = 0
			hideShown(rec.fillList, rec.fillShown)
			rec.fillShown = 0
			hideHpBar(rec)
			hideArmBar(rec)
			rec.hpVal, rec.armVal, rec.ghost = nil, nil, nil
			if rec.dotOn then
				rec.dot.Visible = false
				rec.dotOn = false
			end
			if rec.arrowOn and not keepArrow then
				rec.arrow.Visible = false
				rec.arrowOn = false
			end
			if rec.cham then
				Chams.hide(rec.cham)
			end
			for key in pairs(rec.text) do
				hideText(rec, key)
			end
		end

		local function hideAll()
			for _, rec in pairs(records) do
				hideRecord(rec)
			end
		end

		local function setLines(list, prevShown, count, src, c, a, thick, z)
			while #list < count do
				table.insert(list, newLine(z))
			end
			local alpha = dAlpha(a * curFade)
			for i = 1, count do
				local sg, l = src[i], list[i]
				l.Color = c
				l.Transparency = alpha
				l.Thickness = thick
				l.From = Vector2.new(sg[1], sg[2])
				l.To = Vector2.new(sg[3], sg[4])
				l.Visible = true
			end
			for i = count + 1, prevShown do
				list[i].Visible = false
			end
			return count
		end

		-- round dots on the skeleton joints
		local function setCircles(list, prevShown, count, c, a, r)
			while #list < count do
				local ci = newCircle(4)
				ci.Filled = true
				ci.Thickness = 1
				pcall(function() ci.NumSides = 14 end)
				table.insert(list, ci)
			end
			local alpha = dAlpha(a * curFade)
			for i = 1, count do
				local ci = list[i]
				ci.Position = Vector2.new(jointX[i], jointY[i])
				ci.Radius = r
				ci.Color = c
				ci.Transparency = alpha
				ci.Visible = true
			end
			for i = count + 1, prevShown do
				list[i].Visible = false
			end
			return count
		end

		-- colored pieces of a bar (health / armor)
		local function setSquares(list, prevShown, count, rects)
			while #list < count do
				table.insert(list, newSquare(4))
			end
			for i = 1, count do
				local r, sq = rects[i], list[i]
				sq.Position = Vector2.new(r[1], r[2])
				sq.Size = Vector2.new(r[3], r[4])
				sq.Color = r[5]
				sq.Transparency = dAlpha(curFade)
				sq.Visible = true
			end
			for i = count + 1, prevShown do
				list[i].Visible = false
			end
			return count
		end

		-- box fill strips (every rect has its own opacity)
		local function setFill(list, prevShown, count, rects)
			while #list < count do
				table.insert(list, newSquare(1))
			end
			for i = 1, count do
				local r, sq = rects[i], list[i]
				sq.Position = Vector2.new(r[1], r[2])
				sq.Size = Vector2.new(r[3], r[4])
				sq.Color = r[5]
				sq.Transparency = dAlpha(r[6] * curFade)
				sq.Visible = true
			end
			for i = count + 1, prevShown do
				list[i].Visible = false
			end
			return count
		end

		local function drawBarBg(rec, key, onKey, rect)
			if not rec[key] then
				rec[key] = newSquare(2)
				rec[key].Color = Color3.fromRGB(10, 10, 12)
			end
			local bg = rec[key]
			bg.Transparency = dAlpha(0.7 * curFade)
			bg.Position = Vector2.new(rect[1], rect[2])
			bg.Size = Vector2.new(rect[3], rect[4])
			bg.Visible = true
			rec[onKey] = true
		end

		local function drawGhost(rec)
			if not rec.ghostSq then
				rec.ghostSq = newSquare(3)
			end
			local g = rec.ghostSq
			g.Color = colorOf(slots.ghost)
			g.Transparency = dAlpha(0.95 * curFade)
			g.Position = Vector2.new(ghostRect[1], ghostRect[2])
			g.Size = Vector2.new(ghostRect[3], ghostRect[4])
			g.Visible = true
			rec.ghostOn = true
		end

		local function getText(rec, key, str, c, a, fontName)
			local t = rec.text[key]
			if not t then
				t = Drawing.new("Text")
				t.Size = 13
				t.Center = true
				t.Outline = true
				t.Visible = false
				setZ(t, 5)
				rec.text[key] = t
			end
			if rec.textFont[key] ~= fontName then
				rec.textFont[key] = fontName
				pcall(function() t.Font = DRAW_FONT[fontName] end)
			end
			t.Text = str
			t.Color = c
			t.Transparency = dAlpha(a * curFade)
			return t
		end

		local function showText(rec, key, t, x, y)
			t.Position = Vector2.new(x, y)
			t.Visible = true
			rec.textOn[key] = true
		end

		local function textSize(t, str)
			local ok, tb = pcall(function() return t.TextBounds end)
			if ok and tb and tb.X > 0 then
				return tb.X, tb.Y
			end
			return #str * 6.5, 13
		end

		local function chamColors(player)
			local fill = colorFor(slots.chamFill, player, true)
			local outline
			if colorOverridden() then
				outline = fill:Lerp(Color3.new(1, 1, 1), 0.35)
			else
				outline = colorOf(slots.chamOutline)

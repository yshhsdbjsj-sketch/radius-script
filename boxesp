		local function nameText(player)
			if nameSource == "Username" then
				return player.Name
			elseif nameSource == "Both" then
				return (player.DisplayName ~= player.Name) and (player.DisplayName .. " (@" .. player.Name .. ")") or player.Name
			end
			return player.DisplayName
		end

		local function distanceText(dist)
			return "[" .. math.floor(dist + 0.5) .. "]"
		end

		local function distanceOnName()
			return feat.Distance and feat.Weapon and feat.Name
		end

		local function healthText(hum, frac)
			if hpFormat == "Percent" then
				return math.floor(frac * 100 + 0.5) .. "%"
			end
			return tostring(math.floor(hum.Health + 0.5))
		end

		local function healthFrac(hum)
			local mh = hum.MaxHealth
			if mh <= 0 then
				return 0
			end
			return math.clamp(hum.Health / mh, 0, 1)
		end

		local function healthColor(t)
			local lo, mid, hi = colorOf(slots.hpLow), colorOf(slots.hpMid), colorOf(slots.hpFull)
			if t < 0.5 then
				return lo:Lerp(mid, t * 2)
			end
			return mid:Lerp(hi, (t - 0.5) * 2)
		end

		local hpRects = {}
		for i = 1, HP_SEGS do
			hpRects[i] = {0, 0, 0, 0, Color3.new(1, 1, 1)}
		end
		local hpBg = {0, 0, 0, 0}
		local hpInfo = {x = 0, y = 0}

		local function computeHealth(frac)
			local top = math.floor(bnd.minY - PAD)
			local bottom = math.floor(bnd.maxY + PAD)
			local H = bottom - top
			local w = HP_W
			local x = math.floor(bnd.minX - PAD - 3 - w)
			hpBg[1], hpBg[2], hpBg[3], hpBg[4] = x - 1, top - 1, w + 2, H + 2
			hpInfo.x = x - 1
			hpInfo.y = bottom - H * math.max(frac, 0)
			if frac <= 0 then
				return 0
			end
			if hpMode == "Solid" then
				local r = hpRects[1]
				r[1], r[2], r[3], r[4], r[5] = x, bottom - H * frac, w, H * frac, healthColor(frac)
				return 1
			end
			local n = 0
			for i = 0, HP_SEGS - 1 do
				local f0, f1 = i / HP_SEGS, (i + 1) / HP_SEGS
				if frac > f0 then
					local topF = math.min(f1, frac)
					n = n + 1
					local r = hpRects[n]
					r[1], r[2], r[3], r[4], r[5] = x, bottom - topF * H, w, (topF - f0) * H, healthColor((f0 + f1) / 2)
				end
			end
			return n
		end

		local armBg = {0, 0, 0, 0}
		local armRect = {0, 0, 0, 0}
		local function computeArmor(frac)
			local top = math.floor(bnd.minY - PAD)
			local bottom = math.floor(bnd.maxY + PAD)
			local H = bottom - top
			local x = math.floor(bnd.maxX + PAD + 3)
			armBg[1], armBg[2], armBg[3], armBg[4] = x - 1, top - 1, HP_W + 2, H + 2
			armRect[1], armRect[2], armRect[3], armRect[4] = x, bottom - H * frac, HP_W, H * frac
		end

		local function tracerOrigin(w, h, mouse)
			if tracerFrom == "Center" then
				return w / 2, h / 2
			elseif tracerFrom == "Top" then
				return w / 2, 0
			elseif tracerFrom == "Mouse" and mouse then
				return mouse.X, mouse.Y
			end
			return w / 2, h
		end

		-- ====================================================
		-- preview on the 3D avatar render
		-- ====================================================
		local previewViewport
		local prevBox, prevSkel, prevHp, prevTrc, prevFill, prevArmor, prevLook = {}, {}, {}, {}, {}, {}, {}
		local prevTexts = {}
		local prevDot, prevDotStroke

		local function findViewport()
			if previewViewport and previewViewport.Parent then
				return previewViewport
			end
			previewViewport = popup and popup:FindFirstChildWhichIsA("ViewportFrame", true) or nil
			return previewViewport
		end

		local function getFrame(pool, i, name)
			local f = pool[i]
			if not f then
				f = Instance.new("Frame")
				f.Name = name
				f.BorderSizePixel = 0
				f.Active = false
				f.ZIndex = 20
				f.Visible = false
				pool[i] = f
			end
			if f.Parent ~= previewViewport then
				f.Parent = previewViewport
			end
			return f
		end

		local function hidePool(pool)
			for _, f in ipairs(pool) do
				f.Visible = false
			end
		end

		local function hidePreviewText(key)
			local l = prevTexts[key]
			if l then
				l.Visible = false
			end
		end

		local function hideDotPreview()
			if prevDot then
				prevDot.Visible = false
			end
		end

		local function hidePreview()
			hidePool(prevBox)
			hidePool(prevSkel)
			hidePool(prevHp)
			hidePool(prevTrc)
			hidePool(prevFill)
			hidePool(prevArmor)
			hidePool(prevLook)
			hideDotPreview()
			for key in pairs(prevTexts) do
				hidePreviewText(key)
			end
		end

		local function showPreviewText(key, str, x, y, ax, ay, c, a, fontName)
			local l = prevTexts[key]
			if not l then
				l = Instance.new("TextLabel")
				l.Name = "Esp_" .. key
				l.BackgroundTransparency = 1
				l.Size = UDim2.fromOffset(220, LINE_H)
				l.TextSize = 12
				l.TextStrokeTransparency = 0.5
				l.ZIndex = 20
				l.Visible = false
				prevTexts[key] = l
			end
			if l.Parent ~= previewViewport then
				l.Parent = previewViewport
			end
			l.AnchorPoint = Vector2.new(ax, ay)
			l.TextXAlignment = (ax == 1 and Enum.TextXAlignment.Right) or (ax == 0 and Enum.TextXAlignment.Left) or Enum.TextXAlignment.Center
			l.Font = PREVIEW_FONT[fontName] or Enum.Font.GothamMedium
			l.Text = str
			l.TextColor3 = c
			l.TextTransparency = 1 - a
			l.Position = UDim2.fromOffset(x, y)
			l.Visible = true
		end

		local function showDotPreview(x, y, r, c, a, filled)
			if not prevDot then
				prevDot = Instance.new("Frame")
				prevDot.Name = "EspHeadDot"
				prevDot.AnchorPoint = Vector2.new(0.5, 0.5)
				prevDot.BorderSizePixel = 0
				prevDot.Active = false
				prevDot.ZIndex = 20
				prevDot.Visible = false
				local corner = Instance.new("UICorner")
				corner.CornerRadius = UDim.new(1, 0)
				corner.Parent = prevDot
				prevDotStroke = Instance.new("UIStroke")
				prevDotStroke.Thickness = 1.5
				prevDotStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				prevDotStroke.Parent = prevDot
			end
			if prevDot.Parent ~= previewViewport then
				prevDot.Parent = previewViewport
			end
			prevDot.Position = UDim2.fromOffset(x, y)
			prevDot.Size = UDim2.fromOffset(r * 2, r * 2)
			prevDot.BackgroundColor3 = c
			prevDot.BackgroundTransparency = filled and (1 - a) or 1
			prevDotStroke.Color = c
			prevDotStroke.Transparency = 1 - a
			prevDot.Visible = true
		end

		local function drawLinePool(pool, count, list, c, a, thick)
			for i = 1, count do
				local l = getFrame(pool, i, "EspLine")
				local sg = list[i]
				local dx, dy = sg[3] - sg[1], sg[4] - sg[2]
				local len = math.sqrt(dx * dx + dy * dy)
				l.AnchorPoint = Vector2.new(0.5, 0.5)
				l.BackgroundColor3 = c
				l.BackgroundTransparency = 1 - a
				l.Position = UDim2.fromOffset((sg[1] + sg[3]) / 2, (sg[2] + sg[4]) / 2)
				l.Size = UDim2.fromOffset(len + thick, thick)
				l.Rotation = math.deg(math.atan2(dy, dx))
				l.Visible = true
			end
			for i = count + 1, #pool do
				pool[i].Visible = false
			end
		end

		local function drawHealthPreview(count, showBar)
			if not showBar then
				hidePool(prevHp)
				return
			end
			local bg = getFrame(prevHp, 1, "EspHpBg")
			bg.AnchorPoint = Vector2.new(0, 0)
			bg.Rotation = 0
			bg.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
			bg.BackgroundTransparency = 0.3
			bg.Position = UDim2.fromOffset(hpBg[1], hpBg[2])
			bg.Size = UDim2.fromOffset(hpBg[3], hpBg[4])
			bg.Visible = true
			for i = 1, count do
				local r = hpRects[i]
				local f = getFrame(prevHp, i + 1, "EspHpFill")
				f.AnchorPoint = Vector2.new(0, 0)
				f.Rotation = 0
				f.BackgroundColor3 = r[5]
				f.BackgroundTransparency = 0
				f.Position = UDim2.fromOffset(r[1], r[2])
				f.Size = UDim2.fromOffset(r[3], r[4])
				f.Visible = true
			end
			for i = count + 2, #prevHp do
				prevHp[i].Visible = false
			end
		end

		local function drawArmorPreview(show)
			if not show then
				hidePool(prevArmor)
				return
			end
			local bg = getFrame(prevArmor, 1, "EspArmorBg")
			bg.AnchorPoint = Vector2.new(0, 0)
			bg.Rotation = 0
			bg.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
			bg.BackgroundTransparency = 0.3
			bg.Position = UDim2.fromOffset(armBg[1], armBg[2])
			bg.Size = UDim2.fromOffset(armBg[3], armBg[4])
			bg.Visible = true
			local f = getFrame(prevArmor, 2, "EspArmorFill")
			f.AnchorPoint = Vector2.new(0, 0)
			f.Rotation = 0
			f.BackgroundColor3 = colorOf(slots.armor)
			f.BackgroundTransparency = 1 - slots.armor.a
			f.Position = UDim2.fromOffset(armRect[1], armRect[2])
			f.Size = UDim2.fromOffset(armRect[3], armRect[4])
			f.Visible = true
		end

		local function updatePreview()
			local viewport = findViewport()
			if not (master and anyOn() and popup and popup.Visible and viewport) then
				hidePreview()
				return
			end
			local camera = viewport.CurrentCamera
			local model = viewport:FindFirstChildOfClass("Model")
			if not (camera and model) then
				hidePreview()
				return
			end
			local uiScale = popup:FindFirstChildOfClass("UIScale")
			local vpSize = viewport.AbsoluteSize / (uiScale and uiScale.Scale or 1)
			if vpSize.X < 1 or vpSize.Y < 1 then
				hidePreview()
				return
			end

			local project = makeProjector(camera, vpSize)
			local hasB = needsBounds() and computeBounds(model, project)
			local cx = (bnd.minX + bnd.maxX) / 2

			if feat.BoxFill and hasB then
				local f = getFrame(prevFill, 1, "EspFill")
				f.ZIndex = 19
				f.AnchorPoint = Vector2.new(0, 0)
				f.Rotation = 0
				f.BackgroundColor3 = colorFor(slots.fill, nil)
				f.BackgroundTransparency = 1 - slots.fill.a
				f.Position = UDim2.fromOffset(bnd.minX - PAD, bnd.minY - PAD)
				f.Size = UDim2.fromOffset(bnd.maxX - bnd.minX + PAD * 2, bnd.maxY - bnd.minY + PAD * 2)
				f.Visible = true
			else
				hidePool(prevFill)
			end

			local n = feat.Box and computeBox(model, project, style, hasB) or 0
			drawLinePool(prevBox, n, segs, colorFor(slots.box, nil), slots.box.a, THICKNESS)

			n = feat.Skeleton and computeSkeleton(model, project) or 0
			drawLinePool(prevSkel, n, bones, colorFor(slots.skel, nil), slots.skel.a, skelThick)

			n = feat.LookDir and computeLook(model, project) or 0
			drawLinePool(prevLook, n, lookSeg, colorFor(slots.look, nil), slots.look.a, 1.5)

			if feat.HeadDot then
				local hx, hy, hr = computeHead(model, project)
				if hx then
					showDotPreview(hx, hy, hr, colorFor(slots.head, nil), slots.head.a, headStyle == "Filled")
				else
					hideDotPreview()
				end
			else
				hideDotPreview()
			end

			n = 0
			if feat.Tracers then
				local ox, oy = tracerOrigin(vpSize.X, vpSize.Y, nil)
				n = computeTracer(model, project, ox, oy)
			end
			drawLinePool(prevTrc, n, tracerSeg, colorFor(slots.trc, nil), slots.trc.a, 1)

			if (feat.Health or feat.HealthText) and hasB then

					local info = animate and fadeInfo or TweenInfo.new(0)
					for name, btn in pairs(buttons) do
						local sel = name == current
						TweenService:Create(btn, info, {
							BackgroundColor3 = sel and Color3.fromRGB(48, 48, 55) or Color3.fromRGB(28, 28, 32),
							TextColor3 = sel and TEXT_MAIN or TEXT_SOFT,
						}):Play()
						TweenService:Create(strokes[name], info, {
							Color = sel and Color3.fromRGB(120, 120, 130) or FIELD_STROKE,
						}):Play()
					end
				end

				function api.Set(name)
					if not buttons[name] then
						return
					end
					current = name
					refresh(true)
					onPick(name)
				end

				for i, name in ipairs(names) do
					local btn = Instance.new("TextButton")

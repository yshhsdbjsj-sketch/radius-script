-- password.lua
-- usage: local passwordScreen = loadstring(game:HttpGet(URL))()(lib)
--        passwordScreen(function() ... end)   -- callback runs after the window expands
return function(lib)
	local TweenService = lib.TweenService
	local tweenInfo = lib.tweenInfo
	local addCorner = lib.addCorner
	local addStroke = lib.addStroke
	local TEXT_MAIN = lib.TEXT_MAIN
	local win = lib.win
	local content = lib.content

	return function(onContinue)
		local PASSWORD = "zack"

		local EXPANDED_W, EXPANDED_H = 760, 420 -- size of the main window

		local CARD_BG = Color3.fromRGB(22, 22, 25)
		local CARD_STROKE = Color3.fromRGB(42, 42, 47)
		local FIELD_BG = Color3.fromRGB(28, 28, 32)
		local FIELD_STROKE = Color3.fromRGB(46, 46, 51)
		local FIELD_STROKE_FOCUS = Color3.fromRGB(95, 95, 104)
		local BTN_BG = Color3.fromRGB(36, 36, 41)
		local BTN_BG_HOVER = Color3.fromRGB(48, 48, 55)
		local TEXT_DIM = Color3.fromRGB(130, 130, 136)
		local TEXT_BTN = Color3.fromRGB(215, 215, 220)
		local GREEN = Color3.fromRGB(90, 200, 120)
		local RED = Color3.fromRGB(235, 90, 90)

		-- background card
		local card = Instance.new("Frame")
		card.Name = "Password"
		card.Position = UDim2.fromOffset(8, 8)
		card.Size = UDim2.new(1, -16, 1, -16)
		card.BackgroundColor3 = CARD_BG
		card.BorderSizePixel = 0
		card.Parent = content
		addCorner(card)
		addStroke(card, CARD_STROKE)

		local function makeText(text, y, size, color)
			local label = Instance.new("TextLabel")
			label.BackgroundTransparency = 1
			label.Position = UDim2.new(0, 24, 0, y)
			label.Size = UDim2.new(1, -48, 0, size + 8)
			label.Font = Enum.Font.GothamMedium
			label.Text = text
			label.TextColor3 = color
			label.TextSize = size
			label.TextWrapped = true
			label.Parent = card
			return label
		end

		makeText("Password", 26, 18, TEXT_MAIN)
		makeText("Enter the password to continue", 56, 13, TEXT_DIM)

		local sep = Instance.new("Frame")
		sep.Position = UDim2.new(0, 24, 0, 94)
		sep.Size = UDim2.new(1, -48, 0, 1)
		sep.BackgroundColor3 = Color3.fromRGB(38, 38, 42)
		sep.BorderSizePixel = 0
		sep.Parent = card

		-- password box (shows bullets, keeps the real text in a variable)
		local box = Instance.new("TextBox")
		box.Name = "PasswordBox"
		box.Position = UDim2.new(0, 24, 0, 112)
		box.Size = UDim2.new(1, -48, 0, 38)
		box.BackgroundColor3 = FIELD_BG
		box.BorderSizePixel = 0
		box.ClearTextOnFocus = false
		box.Font = Enum.Font.GothamMedium
		box.PlaceholderText = "Enter password..."
		box.PlaceholderColor3 = Color3.fromRGB(95, 95, 101)
		box.Text = ""
		box.TextColor3 = TEXT_MAIN
		box.TextSize = 14
		box.Parent = card
		addCorner(box)
		local boxStroke = addStroke(box, FIELD_STROKE)

		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0, 12)
		pad.PaddingRight = UDim.new(0, 12)
		pad.Parent = box

		box.Focused:Connect(function()
			TweenService:Create(boxStroke, tweenInfo, {Color = FIELD_STROKE_FOCUS}):Play()
		end)

		local BULLET = "\u{2022}"
		local real = ""
		local masking = false
		box:GetPropertyChangedSignal("Text"):Connect(function()
			if masking then
				return
			end
			masking = true
			local text = box.Text
			local lead, pos = 0, 1
			while text:sub(pos, pos + #BULLET - 1) == BULLET do
				lead += 1
				pos += #BULLET
			end
			local keep = lead > 0 and (utf8.offset(real, lead + 1) or (#real + 1)) or 1
			real = real:sub(1, keep - 1) .. text:sub(pos)
			box.Text = string.rep(BULLET, utf8.len(real) or #real)
			box.CursorPosition = #box.Text + 1
			masking = false
		end)

		-- continue button
		local button = Instance.new("TextButton")
		button.Name = "Continue"
		button.Position = UDim2.new(0, 24, 0, 162)
		button.Size = UDim2.new(1, -48, 0, 38)
		button.BackgroundColor3 = BTN_BG
		button.BorderSizePixel = 0
		button.AutoButtonColor = false
		button.Font = Enum.Font.GothamMedium
		button.Text = "Continue"
		button.TextColor3 = TEXT_BTN
		button.TextSize = 14
		button.Parent = card
		addCorner(button)
		local buttonStroke = addStroke(button, FIELD_STROKE)

		button.MouseEnter:Connect(function()
			TweenService:Create(button, tweenInfo, {BackgroundColor3 = BTN_BG_HOVER, TextColor3 = TEXT_MAIN}):Play()
			TweenService:Create(buttonStroke, tweenInfo, {Color = FIELD_STROKE_FOCUS}):Play()
		end)
		button.MouseLeave:Connect(function()
			TweenService:Create(button, tweenInfo, {BackgroundColor3 = BTN_BG, TextColor3 = TEXT_BTN}):Play()
			TweenService:Create(buttonStroke, tweenInfo, {Color = FIELD_STROKE}):Play()
		end)

		local status = makeText("", 212, 13, TEXT_DIM)
		local function setStatus(text, color)
			status.Text = text
			status.TextColor3 = color
		end

		-- fades a card (and everything in it) out
		local function fadeOut(root, duration)
			local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			local items = root:GetDescendants()
			table.insert(items, root)
			for _, obj in ipairs(items) do
				if obj:IsA("GuiObject") then
					if obj.BackgroundTransparency < 1 then
						TweenService:Create(obj, info, {BackgroundTransparency = 1}):Play()
					end
					if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
						TweenService:Create(obj, info, {TextTransparency = 1}):Play()
					end
				elseif obj:IsA("UIStroke") then
					TweenService:Create(obj, info, {Transparency = 1}):Play()
				end
			end
			task.wait(duration)
		end

		-- password screen fades away, then the window expands into the main window
		local function openMainWindow()
			task.wait(0.7) -- let "Access granted" show for a moment
			if not card.Parent then
				return
			end
			fadeOut(card, 0.4)
			card:Destroy()

			local screen = win.gui.AbsoluteSize
			local tween = win.resize(math.min(EXPANDED_W, screen.X - 20), math.min(EXPANDED_H, screen.Y - 20), 0.7)
			tween.Completed:Wait()
			onContinue()
		end

		local unlocked = false
		local function tryContinue()
			if unlocked then
				return
			end
			TweenService:Create(boxStroke, tweenInfo, {Color = FIELD_STROKE}):Play()

			if real == "" then
				setStatus("Enter the password first", RED)
			elseif real == PASSWORD then
				unlocked = true
				setStatus("Access granted", GREEN)
				button.Text = "Continued"
				task.spawn(openMainWindow)
			else
				setStatus("Wrong password", RED)
				real = ""
				masking = true
				box.Text = ""
				masking = false
			end
		end

		button.MouseButton1Click:Connect(tryContinue)
		box.FocusLost:Connect(function(enterPressed)
			TweenService:Create(boxStroke, tweenInfo, {Color = FIELD_STROKE}):Play()
			if enterPressed then
				tryContinue()
			end
		end)
	end
end
